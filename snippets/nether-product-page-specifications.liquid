{% comment %}
  Nether Premium Product Page — Specifications module.
  Supports table, list, and accordion presentation styles.

  Accepts:
  - block: {Object} Block object (required)
  - product: {Object} Product object (required)
  - section: {Object} Section object (required)
{% endcomment %}

{%- liquid
  assign spec_style = block.settings.style | default: section.settings.nether_specifications_style | default: 'list'
  assign show_vendor = block.settings.show_vendor
  assign show_type = block.settings.show_type
  assign show_sku = block.settings.show_sku
  assign show_tags = block.settings.show_tags
  assign has_specs = false

  if show_vendor and product.vendor != blank
    assign has_specs = true
  endif
  if show_type and product.type != blank
    assign has_specs = true
  endif
  if show_sku and product.selected_or_first_available_variant.sku != blank
    assign has_specs = true
  endif
  if show_tags and product.tags.size > 0
    assign has_specs = true
  endif
  if block.settings.custom_spec_1_label != blank and block.settings.custom_spec_1_value != blank
    assign has_specs = true
  endif
  if block.settings.custom_spec_2_label != blank and block.settings.custom_spec_2_value != blank
    assign has_specs = true
  endif
  if block.settings.custom_spec_3_label != blank and block.settings.custom_spec_3_value != blank
    assign has_specs = true
  endif
-%}

{%- if has_specs -%}
  <div
    class="nether-product-page__module nether-product-page__module--specifications nether-product-page__specifications--{{ spec_style }}"
    data-nether-product-page-module="specifications"
    data-nether-product-page-animate
    {{ block.shopify_attributes }}
  >
    {%- if spec_style == 'accordion' -%}
      <div class="nether-product-page__accordion product__accordion accordion quick-add-hidden">
        <details id="Details-spec-{{ block.id }}-{{ section.id }}">
          <summary>
            <div class="summary__title">
              {% render 'icon-accordion', icon: block.settings.icon %}
              <h2 class="h4 accordion__title inline-richtext">
                {{ block.settings.heading | default: 'sections.nether_product_page.specifications.label' | t }}
              </h2>
            </div>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="accordion__content rte" id="ProductSpecAccordion-{{ block.id }}-{{ section.id }}">
            {% render 'nether-product-page-specifications-content', block: block, product: product, spec_style: 'list' %}
          </div>
        </details>
      </div>
    {%- else -%}
      {%- if block.settings.heading != blank -%}
        <h2 class="nether-product-page__module-heading type-heading-sm">{{ block.settings.heading }}</h2>
      {%- endif -%}
      {% render 'nether-product-page-specifications-content', block: block, product: product, spec_style: spec_style %}
    {%- endif -%}
  </div>
{%- endif -%}
