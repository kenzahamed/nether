{% comment %}
  Renders the Nether Premium Mobile Drawer footer area.

  Accepts:
  - section: {Object} Header section object (required)

  Usage:
  {% render 'nether-mobile-drawer-footer', section: section %}
{% endcomment %}

{%- liquid
  assign show_social = section.settings.nether_drawer_enable_social
  assign show_contact = section.settings.nether_drawer_enable_contact
  assign show_secondary = section.settings.nether_drawer_enable_secondary_menu
  assign secondary_menu = section.settings.nether_drawer_secondary_menu
  assign use_search_drawer = section.settings.nether_enable_search_drawer

  assign has_social = false
  if show_social
    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign has_social = true
    endif
  endif

  assign has_contact = false
  if show_contact
    if section.settings.nether_drawer_contact_phone != blank or section.settings.nether_drawer_contact_email != blank or section.settings.nether_drawer_contact_text != blank
      assign has_contact = true
    endif
  endif
-%}

<footer class="nether-mobile-drawer__footer menu-drawer__utility-links">
  <div class="nether-mobile-drawer__footer-actions">
    {%- if use_search_drawer -%}
      <button
        type="button"
        class="nether-mobile-drawer__footer-link link focus-inset"
        data-nether-search-open
        data-nether-drawer-search
      >
        <span class="svg-wrapper" aria-hidden="true">
          {{- 'icon-search.svg' | inline_asset_content -}}
        </span>
        <span>{{ 'sections.header.mobile_drawer.search' | t }}</span>
      </button>
    {%- endif -%}

    {%- if shop.customer_accounts_enabled -%}
      <a
        href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
        class="menu-drawer__account nether-mobile-drawer__footer-link link focus-inset"
        rel="nofollow"
      >
        {%- if section.settings.enable_customer_avatar -%}
          <account-icon>
            {%- if customer and customer.has_avatar? -%}
              {{ customer | avatar }}
            {%- else -%}
              <span class="svg-wrapper" aria-hidden="true">
                {{- 'icon-account.svg' | inline_asset_content -}}
              </span>
            {%- endif -%}
          </account-icon>
        {%- else -%}
          <span class="svg-wrapper" aria-hidden="true">
            {{- 'icon-account.svg' | inline_asset_content -}}
          </span>
        {%- endif -%}
        <span>
          {%- liquid
            if customer
              echo 'customer.account_fallback' | t
            else
              echo 'customer.log_in' | t
            endif
          -%}
        </span>
      </a>
    {%- endif -%}

    <a href="{{ routes.cart_url }}" class="nether-mobile-drawer__footer-link link focus-inset" id="nether-drawer-cart-link">
      {% if cart == empty %}
        <span class="svg-wrapper" aria-hidden="true">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
      {% else %}
        <span class="svg-wrapper" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
      {% endif %}
      <span>{{ 'templates.cart.cart' | t }}</span>
      {%- if cart != empty -%}
        <span class="nether-mobile-drawer__cart-count" aria-hidden="true">{{ cart.item_count }}</span>
      {%- endif -%}
    </a>
  </div>

  {%- if show_secondary and secondary_menu != blank and linklists[secondary_menu].links.size > 0 -%}
    <nav class="nether-mobile-drawer__secondary" aria-label="{{ 'sections.header.mobile_drawer.secondary_menu' | t }}">
      <ul class="nether-mobile-drawer__secondary-menu list-menu list-unstyled" role="list">
        {%- for link in linklists[secondary_menu].links -%}
          <li>
            <a
              href="{{ link.url }}"
              class="nether-mobile-drawer__secondary-link link link--text focus-inset{% if link.current %} nether-mobile-drawer__secondary-link--active{% endif %}"
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{ link.title | escape }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  {%- if has_contact -%}
    <div class="nether-mobile-drawer__contact">
      {%- if section.settings.nether_drawer_contact_phone != blank -%}
        <a class="nether-mobile-drawer__contact-item link" href="tel:{{ section.settings.nether_drawer_contact_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">
          {{ section.settings.nether_drawer_contact_phone | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.nether_drawer_contact_email != blank -%}
        <a class="nether-mobile-drawer__contact-item link" href="mailto:{{ section.settings.nether_drawer_contact_email }}">
          {{ section.settings.nether_drawer_contact_email | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.nether_drawer_contact_text != blank -%}
        <p class="nether-mobile-drawer__contact-item nether-mobile-drawer__contact-text">
          {{ section.settings.nether_drawer_contact_text | escape }}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if localization.available_countries or localization.available_languages -%}
    <div class="menu-drawer__localization header-localization nether-mobile-drawer__localization">
      {%- if localization.available_countries and localization.available_countries.size > 1 -%}
        <localization-form>
          {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="HeaderCountryMobileLabel">
                {{ 'localization.country_label' | t }}
              </h2>
              {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {% endif %}

      {%- if localization.available_languages and localization.available_languages.size > 1 -%}
        <localization-form>
          {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
            <div>
              <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">
                {{ 'localization.language_label' | t }}
              </h2>
              {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if has_social -%}
    {% render 'social-icons', class: 'nether-mobile-drawer__social' %}
  {%- endif -%}

  <div class="nether-mobile-drawer__blocks" data-nether-drawer-blocks hidden></div>
</footer>
