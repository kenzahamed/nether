{% comment %}
  Nether Premium Recommendations — grid layout module.
  Reuses Dawn product-grid + card-product via nether-recommendations-cards.

  Accepts:
  - section: {Object} Section object (required)
  - products: {Array} Product list (required)
  - products_limit: {Number} Max products to show
  - layout_mode: {String} grid | editorial (default: grid)
{% endcomment %}

{%- liquid
  assign limit = products_limit | default: section.settings.nether_products_to_show | default: 4
  assign columns_desktop = section.settings.nether_columns_desktop | default: 4
  assign columns_mobile = section.settings.nether_columns_mobile | default: '2'
  assign mode = layout_mode | default: 'grid'
  assign skip_card_product_styles = false
  assign card_index = 0
-%}

<ul
  id="NetherRecommendationsGrid-{{ section.id }}"
  class="nether-recommendations__grid nether-recommendations__grid--{{ mode }} grid product-grid grid--{{ columns_desktop }}-col-desktop grid--{{ columns_mobile }}-col-tablet-down contains-card contains-card--product"
  role="list"
  aria-label="{{ 'sections.nether_recommendations.grid.label' | t }}"
  data-nether-recommendations-module="grid"
  data-nether-recommendations-grid
>
  {%- for recommendation in products limit: limit -%}
    {%- assign card_index = card_index | plus: 1 -%}
    {%- liquid
      assign lazy_load = true
      if card_index <= columns_desktop
        assign lazy_load = false
      endif
      assign is_featured = false
      if mode == 'editorial' and card_index == 1
        assign is_featured = true
      endif
    -%}
    <li
      id="NetherRecommendationsItem-{{ section.id }}-{{ card_index }}"
      class="nether-recommendations__item grid__item{% if is_featured %} nether-recommendations__item--featured{% endif %}"
      data-nether-recommendations-item
      data-nether-recommendations-animate
    >
      {% render 'nether-recommendations-cards',
        card_product: recommendation,
        section: section,
        skip_styles: skip_card_product_styles,
        lazy_load: lazy_load,
        index: card_index
      %}
    </li>
    {%- assign skip_card_product_styles = true -%}
  {%- endfor -%}
</ul>
