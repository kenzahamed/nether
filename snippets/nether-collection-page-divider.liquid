{% comment %}
  Optional section divider for Nether Premium Collection Page Commerce Framework.

  Accepts:
  - section: {Object} Collection page section (required)
  - position: {String} top or bottom (required)
{% endcomment %}

{%- liquid
  assign divider_position = position | default: 'bottom'
  assign divider_style = section.settings.nether_divider_style | default: 'line'
-%}

<div
  class="nether-collection-page__divider nether-collection-page__divider--{{ divider_position }} nether-collection-page__divider--{{ divider_style }}"
  aria-hidden="true"
  role="presentation"
></div>
