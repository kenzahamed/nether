{% comment %}
  Renders Nether Premium Testimonials section header content.

  Accepts:
  - section: {Object} Testimonials section (required)
  - heading_tag: {String} Primary heading element (default: h2)

  Usage:
  {% render 'nether-testimonials-content', section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign alignment = section.settings.nether_content_alignment | default: 'left'
  assign has_header_blocks = false

  for block in section.blocks
    case block.type
      when 'eyebrow', 'heading', 'subheading', 'text', 'buttons'
        assign has_header_blocks = true
    endcase
  endfor
-%}

{%- if has_header_blocks -%}
  <div class="nether-testimonials__header page-width" data-nether-testimonials-header>
    <div
      class="nether-testimonials__header-inner nether-testimonials__header-inner--align-{{ alignment }}"
      data-nether-testimonials-panel
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow', 'heading', 'subheading', 'text', 'buttons', '@app' -%}
            {%- render 'nether-testimonials-block',
              block: block,
              section: section,
              heading_tag: heading_element
            -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
