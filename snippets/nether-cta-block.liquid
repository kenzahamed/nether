{% comment %}
  Central dispatcher for Nether Premium CTA content blocks.

  Accepts:
  - block: {Object} Theme Editor block (required)
  - section: {Object} CTA section (required)
  - heading_tag: {String} Primary heading element (default: h2)

  Usage:
  {% render 'nether-cta-block', block: block, section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign subheading_element = 'h3'
  if heading_element == 'h3'
    assign subheading_element = 'h4'
  endif
  assign motion_attr = 'data-nether-cta-animate'
-%}

{%- case block.type -%}
  {%- when '@app' -%}
    <div
      class="nether-cta__app-block"
      {{ motion_attr }}
      data-nether-cta-role="app"
      {{ block.shopify_attributes }}
    >
      {% render block %}
    </div>

  {%- when 'eyebrow' -%}
    {%- if block.settings.text != blank -%}
      <p
        class="nether-cta__eyebrow type-overline"
        {{ motion_attr }}
        data-nether-cta-role="eyebrow"
        data-nether-hero-role="eyebrow"
        {{ block.shopify_attributes }}
      >
        {{- block.settings.text | escape -}}
      </p>
    {%- endif -%}

  {%- when 'heading' -%}
    {%- if block.settings.heading != blank -%}
      <{{ heading_element }}
        class="nether-cta__heading inline-richtext {{ block.settings.heading_size }}"
        {{ motion_attr }}
        data-nether-cta-role="heading"
        data-nether-hero-role="heading"
        {{ block.shopify_attributes }}
      >
        {{- block.settings.heading -}}
      </{{ heading_element }}>
    {%- endif -%}

  {%- when 'subheading' -%}
    {%- if block.settings.subheading != blank -%}
      <{{ subheading_element }}
        class="nether-cta__subheading inline-richtext {{ block.settings.subheading_size }}"
        {{ motion_attr }}
        data-nether-cta-role="subheading"
        data-nether-hero-role="subheading"
        {{ block.shopify_attributes }}
      >
        {{- block.settings.subheading -}}
      </{{ subheading_element }}>
    {%- endif -%}

  {%- when 'text' -%}
    {%- if block.settings.text != blank -%}
      <div
        class="nether-cta__text rte {{ block.settings.text_style }}"
        {{ motion_attr }}
        data-nether-cta-role="text"
        data-nether-hero-role="text"
        {{ block.shopify_attributes }}
      >
        {{ block.settings.text }}
      </div>
    {%- endif -%}

  {%- when 'image' -%}
    {%- render 'nether-content-image', block: block, motion_attr: motion_attr -%}

  {%- when 'video' -%}
    {%- render 'nether-content-video', block: block, motion_attr: motion_attr -%}

  {%- when 'primary_button' -%}
    {%- if block.settings.button_label != blank -%}
      {%- liquid
        assign button_attributes = ''
        if block.settings.analytics_event != blank
          assign button_attributes = 'data-nether-cta-event="' | append: block.settings.analytics_event | escape | append: '"'
        endif
        if block.settings.popup_target != blank
          assign button_attributes = button_attributes | append: ' data-nether-cta-popup="' | append: block.settings.popup_target | escape | append: '"'
        endif
      -%}
      <div
        class="nether-cta__button-block nether-cta__button-block--primary"
        {{ motion_attr }}
        data-nether-cta-button-animate
        data-nether-cta-role="buttons"
        data-nether-hero-role="buttons"
        {{ block.shopify_attributes }}
      >
        {%- render 'button',
          label: block.settings.button_label,
          link: block.settings.button_link,
          style: block.settings.button_style,
          size: block.settings.button_size,
          disabled: block.settings.button_link == blank,
          class: 'nether-cta__button',
          attributes: button_attributes
        -%}
      </div>
    {%- endif -%}

  {%- when 'secondary_button' -%}
    {%- if block.settings.button_label != blank -%}
      <div
        class="nether-cta__button-block nether-cta__button-block--secondary"
        {{ motion_attr }}
        data-nether-cta-button-animate
        data-nether-cta-role="buttons"
        data-nether-hero-role="buttons"
        {{ block.shopify_attributes }}
      >
        {%- render 'button',
          label: block.settings.button_label,
          link: block.settings.button_link,
          style: block.settings.button_style,
          size: block.settings.button_size,
          disabled: block.settings.button_link == blank,
          class: 'nether-cta__button'
        -%}
      </div>
    {%- endif -%}

  {%- when 'buttons' -%}
    {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
      <div
        class="nether-cta__buttons"
        {{ motion_attr }}
        data-nether-cta-button-animate
        data-nether-cta-role="buttons"
        data-nether-hero-role="buttons"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.button_label_1 != blank -%}
          {%- render 'button',
            label: block.settings.button_label_1,
            link: block.settings.button_link_1,
            style: block.settings.button_style_1,
            size: block.settings.button_size,
            disabled: block.settings.button_link_1 == blank,
            class: 'nether-cta__button nether-cta__button--primary'
          -%}
        {%- endif -%}
        {%- if block.settings.button_label_2 != blank -%}
          {%- render 'button',
            label: block.settings.button_label_2,
            link: block.settings.button_link_2,
            style: block.settings.button_style_2,
            size: block.settings.button_size,
            disabled: block.settings.button_link_2 == blank,
            class: 'nether-cta__button nether-cta__button--secondary'
          -%}
        {%- endif -%}
      </div>
    {%- endif -%}

  {%- when 'trust_badge' -%}
    {%- render 'nether-hero-trust-badges', block: block, motion_attr: motion_attr -%}

  {%- when 'statistic' -%}
    <div
      {{ motion_attr }}
      data-nether-cta-role="stats"
      data-nether-hero-role="stats"
      {{ block.shopify_attributes }}
    >
      {%- render 'nether-hero-stat', block: block -%}
    </div>

  {%- when 'feature_list' -%}
    <div
      {{ motion_attr }}
      data-nether-cta-role="features"
      data-nether-hero-role="features"
      {{ block.shopify_attributes }}
    >
      {%- render 'nether-hero-feature-list', block: block -%}
    </div>

  {%- when 'countdown' -%}
    {%- render 'nether-cta-countdown', block: block, motion_attr: motion_attr -%}

  {%- when 'promotion_card' -%}
    {%- render 'nether-cta-promotion-card', block: block, motion_attr: motion_attr -%}

  {%- when 'product_promotion' -%}
    <div
      class="nether-cta__product-promotion"
      {{ motion_attr }}
      data-nether-cta-card
      data-nether-cta-role="card"
      data-nether-hero-role="card"
      {{ block.shopify_attributes }}
    >
      {%- render 'nether-product-highlight', block: block, section: section -%}
    </div>

  {%- when 'collection_promotion' -%}
    <div
      class="nether-cta__collection-promotion"
      {{ motion_attr }}
      data-nether-cta-card
      data-nether-cta-role="card"
      data-nether-hero-role="card"
      {{ block.shopify_attributes }}
    >
      {%- render 'nether-collection-highlight', block: block, section: section -%}
    </div>

  {%- when 'divider' -%}
    <div
      class="nether-cta__block-divider nether-cta__block-divider--{{ block.settings.divider_style | default: 'line' }}"
      {{ motion_attr }}
      data-nether-cta-divider
      data-nether-cta-role="divider"
      aria-hidden="true"
      role="presentation"
      {{ block.shopify_attributes }}
    ></div>

  {%- when 'custom_html' -%}
    {%- render 'nether-content-custom-html', block: block, motion_attr: motion_attr -%}
{%- endcase -%}
