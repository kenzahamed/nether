{% comment %}
  Nether Premium Cart — cart page header module.

  Accepts:
  - section: {Object} Section object (required)
{% endcomment %}

<header class="nether-cart__module nether-cart__module--header nether-cart__header" data-nether-cart-module="header" data-nether-cart-animate>
  <div class="nether-cart__header-main">
    <h1 class="nether-cart__title title title--primary type-heading-md">
      {{ section.settings.nether_heading | default: 'sections.cart.title' | t }}
    </h1>
    {%- if section.settings.nether_show_continue_shopping -%}
      <a href="{{ routes.all_products_collection_url }}" class="nether-cart__continue underlined-link type-body-sm">
        {{ 'general.continue_shopping' | t }}
      </a>
    {%- endif -%}
  </div>
  {%- if section.settings.nether_subheading != blank -%}
    <p class="nether-cart__subheading type-body">{{ section.settings.nether_subheading }}</p>
  {%- endif -%}
</header>

