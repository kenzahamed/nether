{% comment %}
  Nether Premium Product Page — Related products inline module.
  Extends Dawn related-products / product-recommendations pattern.
  Composes with Nether Recommendations Commerce Framework via <nether-recommendations>.

  Accepts:
  - block: {Object} Block object (required)
  - section: {Object} Section object (required)
  - product: {Object} Product object (required)
{% endcomment %}

{% render 'nether-recommendations-assets' %}

<product-recommendations
  class="nether-product-page__module nether-product-page__module--related nether-product-page__module--full-width related-products nether-recommendations--embedded quick-add-hidden"
  data-nether-product-page-module="related"
  data-nether-product-page-animate
  data-url="{{ routes.product_recommendations_url }}?limit={{ block.settings.products_to_show }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  {{ block.shopify_attributes }}
>
  <nether-recommendations
    id="NetherRecommendations-Related-{{ section.id }}"
    class="nether-recommendations nether-recommendations--embedded nether-recommendations--source-related"
    data-nether-motion="recommendations"
    data-section-id="{{ section.id }}"
    data-recommendation-source="related"
    data-layout="grid"
    data-animation-style="{{ section.settings.nether_animation_style | default: 'stagger' }}"
    data-animation-duration="{{ section.settings.nether_animation_duration | default: 0.5 }}"
    role="region"
    aria-label="{% render 'nether-locale-text', value: block.settings.heading, key: 'sections.nether_recommendations.strategies.related' %}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="nether-product-page__related-inner nether-recommendations__inner">
        <h2 class="nether-product-page__module-heading nether-recommendations__heading related-products__heading inline-richtext {{ block.settings.heading_size }}">
          {{ block.settings.heading }}
        </h2>
        <ul
          class="grid product-grid grid--{{ block.settings.columns_desktop }}-col-desktop grid--{{ block.settings.columns_mobile }}-col-tablet-down nether-recommendations__grid"
          role="list"
          aria-label="{{ 'sections.nether_recommendations.grid.label' | t }}"
          data-nether-recommendations-grid
        >
          {% assign skip_card_product_styles = false %}
          {% for recommendation in recommendations.products %}
            <li class="grid__item nether-recommendations__item" data-nether-recommendations-item>
              {% render 'card-product',
                card_product: recommendation,
                media_aspect_ratio: block.settings.image_ratio,
                image_shape: block.settings.image_shape,
                show_secondary_image: block.settings.show_secondary_image,
                show_vendor: block.settings.show_vendor,
                show_rating: block.settings.show_rating,
                skip_styles: skip_card_product_styles,
                product_view_context: 'recommendation'
              %}
            </li>
            {%- assign skip_card_product_styles = true -%}
          {% endfor %}
        </ul>
      </div>
    {%- endif -%}
  </nether-recommendations>
</product-recommendations>
