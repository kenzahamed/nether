{% comment %}
  Renders Nether Premium Content shell for hero-composed layouts.

  Accepts:
  - section: {Object} Content section (required)
  - heading_tag: {String} Primary heading element (default: h2)
  - enable_floating: {Boolean} Floating card panel (optional)

  Usage:
  {% render 'nether-content-shell', section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign alignment = section.settings.nether_content_alignment | default: 'left'
  assign panel_classes = 'nether-hero__panel nether-content__panel color-' | append: section.settings.color_scheme | append: ' gradient'

  if section.settings.nether_content_enable_glass
    case section.settings.nether_content_glass_style
      when 'light'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-light'
      when 'heavy'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-heavy'
      when 'frosted'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-frosted'
      else
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-medium'
    endcase
  endif

  if enable_floating or section.settings.nether_content_enable_floating_card
    assign panel_classes = panel_classes | append: ' nether-content__panel--floating'
  endif

  assign shell_block_types = 'eyebrow,heading,subheading,text,image,video,quote,statistic,feature_list,icon_list,buttons,divider,custom_html,content_card,@app' | split: ','
-%}

<div class="nether-hero__content-shell page-width">
  <div
    class="nether-hero__content nether-content__content"
    data-nether-content-shell
    data-nether-hero-content
  >
    <div class="{{ panel_classes }}" data-nether-hero-panel>
      <div class="nether-hero__blocks nether-content__blocks nether-hero__blocks--align-{{ alignment }}">
        {%- for block in section.blocks -%}
          {%- if shell_block_types contains block.type -%}
            {%- render 'nether-content-block',
              block: block,
              section: section,
              heading_tag: heading_element
            -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
