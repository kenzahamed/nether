{% comment %}
  Central dispatcher for Nether Premium Product header blocks.

  Accepts:
  - block: {Object} Theme Editor block (required)
  - section: {Object} Product section (required)
  - heading_tag: {String} Primary heading element (default: h2)

  Usage:
  {% render 'nether-product-block', block: block, section: section, heading_tag: 'h2' %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign subheading_element = 'h3'
  if heading_element == 'h3'
    assign subheading_element = 'h4'
  endif
-%}

{%- case block.type -%}
  {%- when '@app', 'eyebrow', 'heading', 'subheading', 'text', 'buttons' -%}
    {%- render 'nether-shared-header-block',
      block: block,
      class_prefix: 'nether-product',
      heading_element: heading_element,
      subheading_element: subheading_element,
      motion_attr: 'data-nether-product-animate',
      role_attr: 'data-nether-product-role',
      text_role: 'intro'
    -%}

  {%- when 'product_highlight' -%}
    {%- render 'nether-product-highlight', block: block, section: section -%}
{%- endcase -%}
