{% comment %}
  Central dispatcher for Nether Premium Newsletter content blocks.

  Accepts:
  - block: {Object} Theme Editor block (required)
  - section: {Object} Newsletter section (required)
  - heading_tag: {String} Primary heading element (default: h2)

  Usage:
  {% render 'nether-newsletter-block', block: block, section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign subheading_element = 'h3'
  if heading_element == 'h3'
    assign subheading_element = 'h4'
  endif
  assign motion_attr = 'data-nether-newsletter-animate'
-%}

{%- case block.type -%}
  {%- when '@app' -%}
    <div
      class="nether-newsletter__app-block"
      {{ motion_attr }}
      data-nether-newsletter-role="app"
      {{ block.shopify_attributes }}
    >
      {% render block %}
    </div>

  {%- when 'eyebrow' -%}
    {%- if block.settings.text != blank -%}
      <p
        class="nether-newsletter__eyebrow type-overline"
        {{ motion_attr }}
        data-nether-newsletter-role="eyebrow"
        data-nether-hero-role="eyebrow"
        {{ block.shopify_attributes }}
      >
        {{- block.settings.text | escape -}}
      </p>
    {%- endif -%}

  {%- when 'heading' -%}
    {%- if block.settings.heading != blank -%}
      <{{ heading_element }}
        class="nether-newsletter__heading inline-richtext {{ block.settings.heading_size }}"
        {{ motion_attr }}
        data-nether-newsletter-role="heading"
        data-nether-hero-role="heading"
        {{ block.shopify_attributes }}
      >
        {{- block.settings.heading -}}
      </{{ heading_element }}>
    {%- endif -%}

  {%- when 'subheading' -%}
    {%- if block.settings.subheading != blank -%}
      <{{ subheading_element }}
        class="nether-newsletter__subheading inline-richtext {{ block.settings.subheading_size }}"
        {{ motion_attr }}
        data-nether-newsletter-role="subheading"
        data-nether-hero-role="subheading"
        {{ block.shopify_attributes }}
      >
        {{- block.settings.subheading -}}
      </{{ subheading_element }}>
    {%- endif -%}

  {%- when 'text' -%}
    {%- if block.settings.text != blank -%}
      <div
        class="nether-newsletter__text rte {{ block.settings.text_style }}"
        {{ motion_attr }}
        data-nether-newsletter-role="text"
        data-nether-hero-role="text"
        {{ block.shopify_attributes }}
      >
        {{ block.settings.text }}
      </div>
    {%- endif -%}

  {%- when 'image' -%}
    {%- render 'nether-content-image', block: block, motion_attr: motion_attr -%}

  {%- when 'video' -%}
    {%- render 'nether-content-video', block: block, motion_attr: motion_attr -%}

  {%- when 'newsletter_form' -%}
    {%- render 'nether-newsletter-form', section: section, block: block, motion_attr: motion_attr -%}

  {%- when 'email_field', 'name_field', 'consent_checkbox' -%}
    {%- comment -%} Rendered inside newsletter_form — skip in block loop {%- endcomment -%}

  {%- when 'primary_button' -%}
    {%- if block.settings.render_outside_form and block.settings.button_label != blank -%}
      <div
        class="nether-newsletter__button-block"
        {{ motion_attr }}
        data-nether-newsletter-role="buttons"
        data-nether-hero-role="buttons"
        {{ block.shopify_attributes }}
      >
        {%- render 'button',
          label: block.settings.button_label,
          link: block.settings.button_link,
          style: block.settings.button_style,
          size: block.settings.button_size,
          disabled: block.settings.button_link == blank
        -%}
      </div>
    {%- endif -%}

  {%- when 'secondary_button' -%}
    {%- if block.settings.render_outside_form and block.settings.button_label != blank -%}
      <div
        class="nether-newsletter__button-block"
        {{ motion_attr }}
        data-nether-newsletter-role="buttons"
        data-nether-hero-role="buttons"
        {{ block.shopify_attributes }}
      >
        {%- render 'button',
          label: block.settings.button_label,
          link: block.settings.button_link,
          style: block.settings.button_style,
          size: block.settings.button_size,
          disabled: block.settings.button_link == blank
        -%}
      </div>
    {%- endif -%}

  {%- when 'button' -%}
    {%- if block.settings.button_label != blank -%}
      <div
        class="nether-newsletter__button-block"
        {{ motion_attr }}
        data-nether-newsletter-role="buttons"
        data-nether-hero-role="buttons"
        {{ block.shopify_attributes }}
      >
        {%- render 'button',
          label: block.settings.button_label,
          link: block.settings.button_link,
          style: block.settings.button_style,
          size: block.settings.button_size,
          disabled: block.settings.button_link == blank
        -%}
      </div>
    {%- endif -%}

  {%- when 'buttons' -%}
    {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
      <div
        class="nether-newsletter__buttons"
        {{ motion_attr }}
        data-nether-newsletter-role="buttons"
        data-nether-hero-role="buttons"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.button_label_1 != blank -%}
          {%- render 'button',
            label: block.settings.button_label_1,
            link: block.settings.button_link_1,
            style: block.settings.button_style_1,
            size: block.settings.button_size,
            disabled: block.settings.button_link_1 == blank
          -%}
        {%- endif -%}
        {%- if block.settings.button_label_2 != blank -%}
          {%- render 'button',
            label: block.settings.button_label_2,
            link: block.settings.button_link_2,
            style: block.settings.button_style_2,
            size: block.settings.button_size,
            disabled: block.settings.button_link_2 == blank
          -%}
        {%- endif -%}
      </div>
    {%- endif -%}

  {%- when 'trust_badge' -%}
    {%- render 'nether-hero-trust-badges', block: block, motion_attr: motion_attr -%}

  {%- when 'statistic' -%}
    <div
      {{ motion_attr }}
      data-nether-newsletter-role="stats"
      data-nether-hero-role="stats"
      {{ block.shopify_attributes }}
    >
      {%- render 'nether-hero-stat', block: block -%}
    </div>

  {%- when 'countdown' -%}
    {%- render 'nether-newsletter-countdown', block: block, motion_attr: motion_attr -%}

  {%- when 'divider' -%}
    <div
      class="nether-newsletter__block-divider nether-newsletter__block-divider--{{ block.settings.divider_style | default: 'line' }}"
      {{ motion_attr }}
      data-nether-newsletter-divider
      data-nether-newsletter-role="divider"
      aria-hidden="true"
      role="presentation"
      {{ block.shopify_attributes }}
    ></div>

  {%- when 'custom_html' -%}
    {%- render 'nether-content-custom-html', block: block, motion_attr: motion_attr -%}
{%- endcase -%}
