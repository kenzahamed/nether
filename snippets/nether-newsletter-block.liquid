{% comment %}
  Central dispatcher for Nether Premium Newsletter content blocks.

  Accepts:
  - block: {Object} Theme Editor block (required)
  - section: {Object} Newsletter section (required)
  - heading_tag: {String} Primary heading element (default: h2)

  Usage:
  {% render 'nether-newsletter-block', block: block, section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign subheading_element = 'h3'
  if heading_element == 'h3'
    assign subheading_element = 'h4'
  endif
  assign motion_attr = 'data-nether-newsletter-animate'
-%}

{%- case block.type -%}
  {%- when '@app', 'eyebrow', 'heading', 'subheading', 'text', 'buttons' -%}
    {%- render 'nether-shared-header-block',
      block: block,
      class_prefix: 'nether-newsletter',
      heading_element: heading_element,
      subheading_element: subheading_element,
      motion_attr: motion_attr,
      role_attr: 'data-nether-newsletter-role',
      secondary_role_attr: 'data-nether-hero-role'
    -%}

  {%- when 'image' -%}
    {%- render 'nether-content-image', block: block, motion_attr: motion_attr -%}

  {%- when 'video' -%}
    {%- render 'nether-content-video', block: block, motion_attr: motion_attr -%}

  {%- when 'newsletter_form' -%}
    {%- render 'nether-newsletter-form', section: section, block: block, motion_attr: motion_attr -%}

  {%- when 'email_field', 'name_field', 'consent_checkbox' -%}
    {%- comment -%} Rendered inside newsletter_form — skip in block loop {%- endcomment -%}

  {%- when 'primary_button' -%}
    {%- if block.settings.render_outside_form and block.settings.button_label != blank -%}
      <div
        class="nether-newsletter__button-block"
        {{ motion_attr }}
        data-nether-newsletter-role="buttons"
        data-nether-hero-role="buttons"
        {{ block.shopify_attributes }}
      >
        {%- render 'button',
          label: block.settings.button_label,
          link: block.settings.button_link,
          style: block.settings.button_style,
          size: block.settings.button_size,
          disabled: block.settings.button_link == blank
        -%}
      </div>
    {%- endif -%}

  {%- when 'secondary_button' -%}
    {%- if block.settings.render_outside_form and block.settings.button_label != blank -%}
      <div
        class="nether-newsletter__button-block"
        {{ motion_attr }}
        data-nether-newsletter-role="buttons"
        data-nether-hero-role="buttons"
        {{ block.shopify_attributes }}
      >
        {%- render 'button',
          label: block.settings.button_label,
          link: block.settings.button_link,
          style: block.settings.button_style,
          size: block.settings.button_size,
          disabled: block.settings.button_link == blank
        -%}
      </div>
    {%- endif -%}

  {%- when 'button' -%}
    {%- if block.settings.button_label != blank -%}
      <div
        class="nether-newsletter__button-block"
        {{ motion_attr }}
        data-nether-newsletter-role="buttons"
        data-nether-hero-role="buttons"
        {{ block.shopify_attributes }}
      >
        {%- render 'button',
          label: block.settings.button_label,
          link: block.settings.button_link,
          style: block.settings.button_style,
          size: block.settings.button_size,
          disabled: block.settings.button_link == blank
        -%}
      </div>
    {%- endif -%}

  {%- when 'trust_badge' -%}
    {%- render 'nether-hero-trust-badges', block: block, motion_attr: motion_attr -%}

  {%- when 'statistic' -%}
    <div
      {{ motion_attr }}
      data-nether-newsletter-role="stats"
      data-nether-hero-role="stats"
      {{ block.shopify_attributes }}
    >
      {%- render 'nether-hero-stat', block: block -%}
    </div>

  {%- when 'countdown' -%}
    {%- render 'nether-newsletter-countdown', block: block, motion_attr: motion_attr -%}

  {%- when 'divider' -%}
    <div
      class="nether-newsletter__block-divider nether-newsletter__block-divider--{{ block.settings.divider_style | default: 'line' }}"
      {{ motion_attr }}
      data-nether-newsletter-divider
      data-nether-newsletter-role="divider"
      aria-hidden="true"
      role="presentation"
      {{ block.shopify_attributes }}
    ></div>

  {%- when 'custom_html' -%}
    {%- render 'nether-content-custom-html', block: block, motion_attr: motion_attr -%}
{%- endcase -%}
