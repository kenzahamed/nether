{% comment %}
  Nether Premium Commerce Enhancements — Promotional Notice.

  Accepts:
  - heading: {String}
  - text: {String}
  - notice_style: {String} soft | outline | solid | minimal (default: soft)
  - icon: {String} (default: discount)
  - class: {String}
  - attributes: {String}
  - rte: {Boolean}
{% endcomment %}

{%- liquid
  assign promo_style = notice_style | default: 'soft'
  assign has_content = false
  if heading != blank or text != blank
    assign has_content = true
  endif
-%}

{%- if has_content -%}
  <aside
    class="nether-commerce__notice nether-commerce__notice--promotional nether-commerce__notice--{{ promo_style }}{% if class != blank %} {{ class }}{% endif %}"
    data-nether-commerce-module="promotional-notice"
    data-nether-commerce-animate
    role="note"
    {% if attributes != blank %}{{ attributes }}{% endif %}
  >
    {% render 'nether-commerce-icon', icon: icon | default: 'discount', size: 'sm', decorative: true %}
    <div class="nether-commerce__notice-copy">
      {%- if heading != blank -%}
        <p class="nether-commerce__notice-heading type-body-sm">{{ heading }}</p>
      {%- endif -%}
      {%- if text != blank -%}
        {%- if rte -%}
          <div class="nether-commerce__notice-text rte type-body-sm">{{ text }}</div>
        {%- else -%}
          <p class="nether-commerce__notice-text type-body-sm">{{ text }}</p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}
