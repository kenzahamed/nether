{% comment %}
  Renders Nether Premium Hero trust badges block.

  Accepts:
  - block: {Object} Theme Editor block (required)

  Usage:
  {% render 'nether-hero-trust-badges', block: block %}
{% endcomment %}

{%- liquid
  assign motion_attr = motion_attr | default: 'data-nether-hero-animate'
-%}

<div class="nether-hero__trust" {{ motion_attr }} data-nether-hero-role="trust" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <p class="nether-hero__trust-heading type-label" id="HeroTrustHeading-{{ block.id }}">
      {{- block.settings.heading | escape -}}
    </p>
  {%- endif -%}

  <ul
    class="nether-hero__trust-list list-unstyled"
    role="list"
    {% if block.settings.heading != blank %}aria-labelledby="HeroTrustHeading-{{ block.id }}"{% endif %}
  >
    {%- for i in (1..4) -%}
      {%- liquid
        case i
          when 1
            assign trust_image = block.settings.badge_1_image
            assign trust_label = block.settings.badge_1_label
            assign trust_type = block.settings.badge_1_type
          when 2
            assign trust_image = block.settings.badge_2_image
            assign trust_label = block.settings.badge_2_label
            assign trust_type = block.settings.badge_2_type
          when 3
            assign trust_image = block.settings.badge_3_image
            assign trust_label = block.settings.badge_3_label
            assign trust_type = block.settings.badge_3_type
          when 4
            assign trust_image = block.settings.badge_4_image
            assign trust_label = block.settings.badge_4_label
            assign trust_type = block.settings.badge_4_type
        endcase
      -%}

      {%- if trust_image != blank or trust_label != blank -%}
        <li class="nether-hero__trust-item">
          {%- if trust_image != blank -%}
            <div class="nether-hero__trust-image">
              {{
                trust_image
                | image_url: width: 200
                | image_tag:
                  loading: 'lazy',
                  widths: '100, 150, 200',
                  alt: trust_label | default: trust_image.alt | escape
              }}
            </div>
          {%- elsif trust_label != blank -%}
            {%- render 'badge',
              label: trust_label,
              type: trust_type | default: 'custom',
              style: block.settings.badge_style | default: 'soft',
              size: 'small',
              uppercase: false
            -%}
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>
