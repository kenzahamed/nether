{% comment %}
  Nether Premium Bundles — merchant content module.

  Accepts:
  - block: {Object} Block object (required)
{% endcomment %}

<div
  class="nether-bundles__module nether-bundles__merchant-content"
  data-nether-bundles-module="merchant"
  data-nether-bundles-animate
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <h2 class="nether-bundles__merchant-heading type-heading-sm">{{ block.settings.heading }}</h2>
  {%- endif -%}

  {%- if block.settings.page != blank and block.settings.page.content != blank -%}
    <div class="nether-bundles__merchant-text rte type-body">{{ block.settings.page.content }}</div>
  {%- elsif block.settings.content != blank -%}
    <div class="nether-bundles__merchant-text rte type-body">{{ block.settings.content }}</div>
  {%- elsif block.settings.text != blank -%}
    <div class="nether-bundles__merchant-text rte type-body">{{ block.settings.text }}</div>
  {%- endif -%}
</div>
