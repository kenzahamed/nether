{% comment %}
  Renders Nether Premium Hero feature list block.

  Accepts:
  - block: {Object} Theme Editor block (required)

  Usage:
  {% render 'nether-hero-feature-list', block: block %}
{% endcomment %}

{%- liquid
  assign has_features = false
  for i in (1..4)
    case i
      when 1
        if block.settings.feature_1_text != blank
          assign has_features = true
        endif
      when 2
        if block.settings.feature_2_text != blank
          assign has_features = true
        endif
      when 3
        if block.settings.feature_3_text != blank
          assign has_features = true
        endif
      when 4
        if block.settings.feature_4_text != blank
          assign has_features = true
        endif
    endcase
  endfor
-%}

{%- if has_features -%}
  <ul class="nether-hero__features" data-nether-hero-animate data-nether-hero-role="features" role="list" {{ block.shopify_attributes }}>
    {%- for i in (1..4) -%}
      {%- liquid
        case i
          when 1
            assign feature_text = block.settings.feature_1_text
            assign feature_icon = block.settings.feature_1_icon
          when 2
            assign feature_text = block.settings.feature_2_text
            assign feature_icon = block.settings.feature_2_icon
          when 3
            assign feature_text = block.settings.feature_3_text
            assign feature_icon = block.settings.feature_3_icon
          when 4
            assign feature_text = block.settings.feature_4_text
            assign feature_icon = block.settings.feature_4_icon
        endcase
      -%}

      {%- if feature_text != blank -%}
        <li class="nether-hero__feature">
          {%- if feature_icon != blank and feature_icon != 'none' -%}
            <span class="nether-hero__feature-icon">
              {%- render 'icon', icon: feature_icon, size: 'sm', color: 'link' -%}
            </span>
          {%- endif -%}
          <span class="nether-hero__feature-text type-body-sm">{{ feature_text | escape }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
