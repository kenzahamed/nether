{% comment %}
  Renders the Nether Premium Footer bottom bar.

  Accepts:
  - section: {Object} Footer section (required)
  - has_social_icons: {Boolean} Whether social links are configured

  Usage:
  {% render 'nether-footer-bottom-bar', section: section, has_social_icons: has_social_icons %}
{% endcomment %}

<div
  class="footer__content-bottom nether-footer__bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  {% if settings.animations_reveal_on_scroll %}
    data-cascade
  {% endif %}
>
  <div class="footer__content-bottom-wrapper page-width nether-footer__bottom-row">
    <div class="footer__column footer__localization isolate nether-footer__localization">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form>
          {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
            <div>
              <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
              {%- render 'country-localization', localPosition: 'FooterCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}

      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
        <localization-form>
          {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
            <div>
              <h2 class="caption-large text-body" id="FooterLanguageLabel">
                {{ 'localization.language_label' | t }}
              </h2>
              {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
    </div>

    <div class="footer__column footer__column--info nether-footer__bottom-info">
      {%- if section.settings.payment_enable -%}
        {%- render 'nether-footer-payment' -%}
      {%- endif -%}
    </div>
  </div>

  <div class="footer__content-bottom-wrapper page-width nether-footer__copyright-row{% if section.settings.enable_country_selector == false and section.settings.enable_language_selector == false %} footer__content-bottom-wrapper--center{% endif %}{% if section.settings.nether_bottom_bar_alignment == 'left' %} nether-footer__copyright-row--left{% elsif section.settings.nether_bottom_bar_alignment == 'split' %} nether-footer__copyright-row--split{% endif %}">
    <div class="footer__copyright caption nether-footer__copyright">
      <small class="copyright__content">
        &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}
      </small>
      {%- if section.settings.nether_show_powered_by -%}
        <small class="copyright__content">{{ powered_by_link }}</small>
      {%- endif -%}
      {%- if section.settings.show_policy -%}
        <ul class="policies list-unstyled nether-footer__policies" role="list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li>
                <small class="copyright__content">
                  <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                </small>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.show_social and has_social_icons and section.settings.nether_social_in_bottom_bar -%}
      {%- render 'nether-footer-social', show_heading: false, class: 'nether-footer__bottom-social' -%}
    {%- endif -%}
  </div>
</div>
