{% comment %}
  Nether Premium Wishlist — reusable toggle button.

  Accepts:
  - product: {Object} Product (required)
  - variant: {Object} Variant override (optional)
  - style: {String} icon | button | text (default: icon)
  - size: {String} sm | md | lg (default: md)
  - button_style: {String} Button system style when style is button (default: ghost)
  - class: {String} Extra classes (optional)
  - context: {String} card | product | collection | header | cart (optional)
  - label_add: {String} Accessible add label override (optional)
  - label_remove: {String} Accessible remove label override (optional)

  Usage:
  {% render 'nether-wishlist-button', product: product, style: 'icon', context: 'product' %}
{% endcomment %}

{%- if product != blank -%}
{%- liquid
  assign wishlist_variant = variant | default: product.selected_or_first_available_variant
  assign wishlist_style = style | default: 'icon'
  assign wishlist_size = size | default: 'md'
  assign wishlist_button_style = button_style | default: 'ghost'
  assign wishlist_context = context | default: 'product'

  if label_add != blank
    assign add_label = label_add
  else
    assign add_label = 'sections.nether_wishlist.actions.add' | t
  endif
  if label_remove != blank
    assign remove_label = label_remove
  else
    assign remove_label = 'sections.nether_wishlist.actions.remove' | t
  endif

  assign icon_size = 'md'
  if wishlist_size == 'sm'
    assign icon_size = 'sm'
  elsif wishlist_size == 'lg'
    assign icon_size = 'lg'
  endif

  assign image_url = blank
  if product.featured_media
    assign image_url = product.featured_media | image_url: width: 200
  endif

  assign price_money = wishlist_variant.price | money
  assign compare_money = blank
  if wishlist_variant.compare_at_price > wishlist_variant.price
    assign compare_money = wishlist_variant.compare_at_price | money
  endif

  assign button_classes = 'nether-wishlist-button nether-wishlist-button--' | append: wishlist_style
  assign button_classes = button_classes | append: ' nether-wishlist-button--' | append: wishlist_size
  if class != blank
    assign button_classes = button_classes | append: ' ' | append: class
  endif
-%}

<nether-wishlist-button
  class="{{ button_classes }}"
  data-nether-wishlist-toggle
  data-product-id="{{ product.id }}"
  data-variant-id="{{ wishlist_variant.id }}"
  data-product-handle="{{ product.handle | escape }}"
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ product.url }}"
  data-product-vendor="{{ product.vendor | escape }}"
  data-product-image="{{ image_url | escape }}"
  data-product-price="{{ wishlist_variant.price }}"
  data-product-price-formatted="{{ price_money | escape }}"
  data-product-compare-price="{{ wishlist_variant.compare_at_price | default: 0 }}"
  data-product-compare-formatted="{{ compare_money | escape }}"
  data-product-available="{{ wishlist_variant.available }}"
  data-wishlist-context="{{ wishlist_context }}"
  data-label-add="{{ add_label | escape }}"
  data-label-remove="{{ remove_label | escape }}"
>
  {%- if wishlist_style == 'button' -%}
    <button
      type="button"
      class="button button--{{ wishlist_button_style }} button--{{ wishlist_size | replace: 'sm', 'small' | replace: 'md', 'medium' | replace: 'lg', 'large' }} nether-wishlist-button__control"
      aria-pressed="false"
      aria-label="{{ add_label | escape }}"
      data-nether-wishlist-control
    >
      <span class="nether-wishlist-button__icon" aria-hidden="true">
        {% render 'icon', icon: 'heart', size: icon_size, decorative: true %}
      </span>
      <span class="nether-wishlist-button__label" data-nether-wishlist-label>{{ add_label }}</span>
    </button>
  {%- elsif wishlist_style == 'text' -%}
    <button
      type="button"
      class="nether-wishlist-button__control nether-wishlist-button__control--text link focus-inset"
      aria-pressed="false"
      aria-label="{{ add_label | escape }}"
      data-nether-wishlist-control
    >
      <span class="nether-wishlist-button__icon" aria-hidden="true">
        {% render 'icon', icon: 'heart', size: icon_size, decorative: true %}
      </span>
      <span class="nether-wishlist-button__label type-body-sm" data-nether-wishlist-label>{{ add_label }}</span>
    </button>
  {%- else -%}
    <button
      type="button"
      class="nether-wishlist-button__control nether-wishlist-button__control--icon link focus-inset"
      aria-pressed="false"
      aria-label="{{ add_label | escape }}"
      data-nether-wishlist-control
    >
      <span class="nether-wishlist-button__icon" aria-hidden="true">
        {% render 'icon', icon: 'heart', size: icon_size, decorative: true %}
      </span>
      <span class="visually-hidden" data-nether-wishlist-label>{{ add_label }}</span>
    </button>
  {%- endif -%}
</nether-wishlist-button>
{%- endif -%}
