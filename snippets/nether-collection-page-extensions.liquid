{% comment %}
  Future-ready commerce extension points for Nether Premium Collection Page.
  Structural placeholders only — no runtime handlers.

  Accepts:
  - block: {Object} Block object (required)
  - section: {Object} Section object (required)
{% endcomment %}

{%- liquid
  assign extension_type = block.type
  assign extension_label = block.settings.label | default: block.settings.heading

  case extension_type
    when 'wishlist_placeholder'
      assign extension_icon = 'heart'
      assign extension_data = 'data-nether-wishlist-placeholder'
      assign default_label = 'sections.nether_collection_page.extensions.wishlist' | t
    when 'compare_placeholder'
      assign extension_icon = 'clipboard'
      assign extension_data = 'data-nether-compare-placeholder'
      assign default_label = 'sections.nether_collection_page.extensions.compare' | t
    when 'quick_view_placeholder'
      assign extension_icon = 'search'
      assign extension_data = 'data-nether-quick-view-placeholder'
      assign default_label = 'sections.nether_collection_page.extensions.quick_view' | t
    when 'inf_scroll_placeholder'
      assign extension_icon = 'arrow'
      assign extension_data = 'data-nether-infinite-scroll-placeholder'
      assign default_label = 'sections.nether_collection_page.extensions.infinite_scroll' | t
    when 'merch_rules_placeholder'
      assign extension_icon = 'box'
      assign extension_data = 'data-nether-merchandising-rules-placeholder'
      assign default_label = 'sections.nether_collection_page.extensions.merchandising_rules' | t
    when 'recommend_placeholder'
      assign extension_icon = 'star'
      assign extension_data = 'data-nether-recommendations-placeholder'
      assign default_label = 'sections.nether_collection_page.extensions.recommendations' | t
    else
      assign extension_icon = 'info'
      assign extension_data = 'data-nether-extension-placeholder'
      assign default_label = 'sections.nether_collection_page.extensions.generic' | t
  endcase

  if extension_label == blank
    assign extension_label = default_label
  endif
-%}

<div
  class="nether-collection-page__module nether-collection-page__module--extension nether-collection-page__extension nether-collection-page__extension--{{ extension_type | replace: '_placeholder', '' }}"
  data-nether-collection-page-module="extension"
  data-nether-collection-page-animate
  {{ extension_data }}
  {{ block.shopify_attributes }}
>
  <div class="nether-collection-page__extension-inner" role="group" aria-label="{{ extension_label | escape }}">
    {% render 'icon', icon: extension_icon, size: 'sm', decorative: false, label: extension_label %}
    <span class="nether-collection-page__extension-label type-body-sm">{{ extension_label }}</span>
    {%- if block.settings.text != blank -%}
      <p class="nether-collection-page__extension-text type-body-sm">{{ block.settings.text }}</p>
    {%- endif -%}
  </div>
</div>
