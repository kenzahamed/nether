{% comment %}
  Renders media for a Nether Premium Product card.

  Accepts:
  - block: {Object} Product block (optional)
  - section: {Object} Product section (required)
  - product: {Object} Shopify product (required)
  - columns: {Number} Grid columns for image sizes (optional)
  - lazy_load: {Boolean} Lazy load images (default: true)
  - fetch_priority: {String} Image fetch priority (optional)
  - show_secondary_image: {Boolean} Show hover secondary image (default: false)

  Usage:
  {% render 'nether-product-media', block: block, section: section, product: product, columns: columns %}
{% endcomment %}

{%- liquid
  assign card_product = product
  assign media_type = 'image'
  assign custom_image = blank
  assign custom_image_mobile = blank
  assign shopify_video = blank
  assign video_url = blank
  assign poster_image = blank
  assign video_description = card_product.title
  assign video_loop = true

  if block != blank
    assign media_type = block.settings.media_type | default: 'image'
    assign custom_image = block.settings.custom_image
    assign custom_image_mobile = block.settings.custom_image_mobile | default: custom_image
    assign shopify_video = block.settings.video
    assign video_url = block.settings.video_url
    assign poster_image = block.settings.poster_image
    assign video_description = block.settings.video_description | default: card_product.title
    assign video_loop = block.settings.video_loop
  endif

  assign image_ratio = section.settings.nether_image_ratio | default: 'portrait'
  assign columns_count = columns | default: 3
  assign is_lazy = lazy_load | default: true
  assign fetch_priority_value = fetch_priority | default: 'auto'
  assign show_secondary = show_secondary_image | default: section.settings.nether_show_secondary_image

  assign desktop_image = custom_image
  if desktop_image == blank and card_product != blank and card_product.featured_media != blank
    if card_product.featured_media.media_type == 'image'
      assign desktop_image = card_product.featured_media.preview_image
    endif
  endif

  assign secondary_image = blank
  if show_secondary and card_product != blank and card_product.media.size > 1
    for media in card_product.media
      if media.media_type == 'image' and media != card_product.featured_media
        assign secondary_image = media.preview_image
        break
      endif
    endfor
  endif

  assign mobile_image = custom_image_mobile | default: desktop_image

  if poster_image == blank
    assign poster_image = desktop_image
  endif

  assign ratio = 1
  if desktop_image != blank and image_ratio == 'portrait'
    assign ratio = 0.8
  elsif desktop_image != blank and image_ratio == 'adapt'
    assign ratio = desktop_image.aspect_ratio
  elsif image_ratio == 'square'
    assign ratio = 1
  endif
  if ratio == 0 or ratio == null
    assign ratio = 1
  endif

  assign widths = '165, 330, 535, 750, 1000, 1500, 2000, 3000'
  assign sizes = '(min-width: ' | append: settings.page_width | append: 'px) ' | append: settings.page_width | minus: 100 | divided_by: columns_count | append: 'px, (min-width: 750px) calc((100vw - 10rem) / ' | append: columns_count | append: '), calc(100vw - 3rem)'
-%}

<div
  class="nether-product-card__media ratio"
  style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
  data-nether-product-media
  {% if section.settings.nether_enable_parallax %}data-nether-product-parallax{% endif %}
>
  <div class="nether-product-card__media-inner media media--transparent media--hover-effect">
    {%- case media_type -%}
      {%- when 'video' -%}
        {%- if shopify_video != blank -%}
          <deferred-media class="nether-product-card__deferred-media">
            {{
              shopify_video
              | video_tag:
                image_size: '1100x',
                autoplay: false,
                loop: video_loop,
                muted: true,
                controls: true,
                playsinline: true,
                poster: poster_image,
                class: 'nether-product-card__video'
            }}
          </deferred-media>
        {%- elsif video_url != blank -%}
          {%- if video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ video_url.id }}"
              class="nether-product-card__video nether-product-card__video--iframe"
              allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
              title="{{ video_description | escape }}"
              loading="lazy"
            ></iframe>
          {%- elsif video_url.type == 'vimeo' -%}
            <iframe
              src="https://player.vimeo.com/video/{{ video_url.id }}"
              class="nether-product-card__video nether-product-card__video--iframe"
              allow="autoplay; encrypted-media"
              title="{{ video_description | escape }}"
              loading="lazy"
            ></iframe>
          {%- endif -%}
        {%- elsif desktop_image != blank -%}
          {{
            desktop_image
            | image_url: width: 1500
            | image_tag:
              widths: widths,
              sizes: sizes,
              alt: desktop_image.alt | default: card_product.title,
              class: 'motion-reduce',
              loading: is_lazy,
              fetchpriority: fetch_priority_value
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

      {%- else -%}
        {%- if desktop_image != blank -%}
          <picture>
            {%- if mobile_image != blank and mobile_image != desktop_image -%}
              <source
                media="(max-width: 749px)"
                srcset="
                  {%- if mobile_image.width >= 330 -%}{{ mobile_image | image_url: width: 330 }} 330w,{%- endif -%}
                  {%- if mobile_image.width >= 535 -%}{{ mobile_image | image_url: width: 535 }} 535w,{%- endif -%}
                  {%- if mobile_image.width >= 750 -%}{{ mobile_image | image_url: width: 750 }} 750w,{%- endif -%}
                  {{ mobile_image | image_url }} {{ mobile_image.width }}w
                "
                sizes="{{ sizes }}"
              >
            {%- endif -%}
            {{
              desktop_image
              | image_url: width: 1500
              | image_tag:
                widths: widths,
                sizes: sizes,
                alt: desktop_image.alt | default: card_product.title,
                class: 'motion-reduce',
                loading: is_lazy,
                fetchpriority: fetch_priority_value
            }}
          </picture>
          {%- if secondary_image != blank -%}
            {{
              secondary_image
              | image_url: width: 1500
              | image_tag:
                widths: widths,
                sizes: sizes,
                alt: secondary_image.alt | default: card_product.title,
                class: 'motion-reduce nether-product-card__secondary-image',
                loading: 'lazy'
            }}
          {%- endif -%}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
    {%- endcase -%}
  </div>
</div>
