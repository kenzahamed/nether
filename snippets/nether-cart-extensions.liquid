{% comment %}
  Future-ready commerce extension points for Nether Premium Cart.
  Structural placeholders only — no runtime handlers.

  Accepts:
  - block: {Object} Block object (required)
{% endcomment %}

{%- liquid
  assign extension_type = block.type
  assign extension_label = block.settings.label | default: block.settings.heading

  case extension_type
    when 'bundles_placeholder'
      assign extension_icon = 'box'
      assign extension_data = 'data-nether-bundles-placeholder'
      assign default_label = 'sections.nether_cart.extensions.bundles' | t
    when 'upsells_placeholder'
      assign extension_icon = 'cart'
      assign extension_data = 'data-nether-upsells-placeholder'
      assign default_label = 'sections.nether_cart.extensions.upsells' | t
    when 'cross_sells_placeholder'
      assign extension_icon = 'clipboard'
      assign extension_data = 'data-nether-cross-sells-placeholder'
      assign default_label = 'sections.nether_cart.extensions.cross_sells' | t
    when 'loyalty_placeholder'
      assign extension_icon = 'heart'
      assign extension_data = 'data-nether-loyalty-placeholder'
      assign default_label = 'sections.nether_cart.extensions.loyalty' | t
    when 'gift_cards_placeholder'
      assign extension_icon = 'price_tag'
      assign extension_data = 'data-nether-gift-cards-placeholder'
      assign default_label = 'sections.nether_cart.extensions.gift_cards' | t
    when 'subscriptions_placeholder'
      assign extension_icon = 'return'
      assign extension_data = 'data-nether-subscriptions-placeholder'
      assign default_label = 'sections.nether_cart.extensions.subscriptions' | t
    when 'coupon_placeholder'
      assign extension_icon = 'discount'
      assign extension_data = 'data-nether-coupon-placeholder'
      assign default_label = 'sections.nether_cart.extensions.coupon' | t
    when 'analytics_placeholder'
      assign extension_icon = 'info'
      assign extension_data = 'data-nether-analytics-placeholder'
      assign default_label = 'sections.nether_cart.extensions.analytics' | t
    else
      assign extension_icon = 'info'
      assign extension_data = 'data-nether-cart-extension-placeholder'
      assign default_label = 'sections.nether_cart.extensions.generic' | t
  endcase

  if extension_label == blank
    assign extension_label = default_label
  endif
-%}

<div
  class="nether-cart__module nether-cart__module--extension nether-cart__extension nether-cart__extension--{{ extension_type | replace: '_placeholder', '' }}"
  data-nether-cart-module="extension"
  data-nether-cart-animate
  {{ extension_data }}
  {{ block.shopify_attributes }}
>
  <div class="nether-cart__extension-inner" role="group" aria-label="{{ extension_label | escape }}">
    {% render 'icon', icon: extension_icon, size: 'sm', decorative: false, label: extension_label %}
    <span class="nether-cart__extension-label type-body-sm">{{ extension_label }}</span>
    {%- if block.settings.text != blank -%}
      <p class="nether-cart__extension-text type-body-sm">{{ block.settings.text }}</p>
    {%- endif -%}
  </div>
</div>

