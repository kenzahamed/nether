{% comment %}
  Renders Nether Premium CTA content shell.
  Reuses Nether Hero structural classes and block dispatcher.

  Accepts:
  - section: {Object} CTA section (required)
  - heading_tag: {String} Primary heading element (default: h2)

  Usage:
  {% render 'nether-cta-content', section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign alignment = section.settings.nether_content_alignment | default: 'center'
  assign panel_classes = 'nether-hero__panel color-' | append: section.settings.color_scheme | append: ' gradient'

  assign enable_glass = section.settings.nether_enable_glass
  if section.settings.nether_layout == 'luxury_cta'
    assign enable_glass = true
  endif

  if enable_glass
    case section.settings.nether_glass_style
      when 'light'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-light'
      when 'heavy'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-heavy'
      when 'frosted'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-frosted'
      else
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-medium'
    endcase
  endif

  if section.settings.nether_layout == 'luxury_cta' or section.settings.nether_enable_floating_card
    assign panel_classes = panel_classes | append: ' nether-hero__panel--card'
  endif

  if section.settings.nether_enable_floating_card
    assign panel_classes = panel_classes | append: ' nether-cta__panel--floating'
  endif

  if section.settings.nether_layout == 'editorial_cta' or section.settings.nether_layout == 'luxury_cta'
    assign panel_classes = panel_classes | append: ' nether-cta__panel--editorial'
  endif
-%}

<div class="nether-hero__content-shell page-width">
  <div class="nether-hero__content nether-cta__content" data-nether-hero-content data-nether-cta-content>
    <div class="{{ panel_classes }}" data-nether-hero-panel data-nether-cta-panel>
      <div class="nether-hero__blocks nether-cta__blocks nether-hero__blocks--align-{{ alignment }}">
        {%- for block in section.blocks -%}
          {%- render 'nether-cta-block',
            block: block,
            section: section,
            heading_tag: heading_element
          -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
