{% comment %}
  Unified Nether Premium Media renderer for block-level media items.
  Uses shared Media Engine helpers (ratio, loading, picture, video).

  Accepts:
  - block: {Object} Media block with standard media settings (required)
  - section: {Object} Parent section (required)
  - columns: {Number} Grid columns for responsive sizes (optional)
  - lazy_load: {Boolean} Lazy load images (default: true)
  - fetch_priority: {String} Image fetch priority (optional)
  - enable_parallax: {Boolean} Parallax data attribute (optional, defaults to section setting)

  Usage:
  {% render 'nether-media-render', block: block, section: section, columns: columns %}
{% endcomment %}

{%- liquid
  assign media_type = block.settings.media_type | default: 'image'
  assign desktop_image = block.settings.image_desktop
  assign mobile_image = block.settings.image_mobile | default: desktop_image
  assign shopify_video = block.settings.video
  assign video_url = block.settings.video_url
  assign poster_image = block.settings.poster_image | default: desktop_image
  assign video_description = block.settings.video_description | default: block.settings.title
  assign video_loop = block.settings.video_loop
  assign block_image_ratio = block.settings.image_ratio | default: 'default'
  if block_image_ratio == 'default'
    assign image_ratio = section.settings.nether_image_ratio | default: section.settings.image_ratio | default: 'portrait'
  else
    assign image_ratio = block_image_ratio
  endif
  assign columns_count = columns | default: section.settings.nether_columns_desktop | default: 3
  assign is_lazy = lazy_load | default: true
  assign fetch_priority_value = fetch_priority | default: 'auto'
  assign use_parallax = enable_parallax | default: section.settings.nether_enable_parallax

  assign widths = '165, 330, 535, 750, 1000, 1500, 2000, 3000'
  assign sizes = '(min-width: ' | append: settings.page_width | append: 'px) ' | append: settings.page_width | minus: 100 | divided_by: columns_count | append: 'px, (min-width: 750px) calc((100vw - 10rem) / ' | append: columns_count | append: '), calc(100vw - 3rem)'

  assign desktop_alt = desktop_image.alt | default: block.settings.title

  assign media_object_position = blank
  if desktop_image.presentation.focal_point != blank
    assign media_object_position = desktop_image.presentation.focal_point
  endif
-%}

{%- capture ratio_percent -%}
  {%- render 'nether-media-ratio', image_ratio: image_ratio, image: desktop_image -%}
{%- endcapture -%}
{%- assign ratio_percent = ratio_percent | strip -%}

{%- capture loading_attr -%}
  {%- render 'nether-media-loading', lazy_load: is_lazy, fetch_priority: fetch_priority_value -%}
{%- endcapture -%}
{%- assign loading_attr = loading_attr | strip -%}

<div
  class="nether-media-card__media ratio nether-media-ratio"
  style="--ratio-percent: {{ ratio_percent }}%;{% if media_object_position != blank %} --nether-media-object-position: {{ media_object_position }};{% endif %}"
  data-nether-media-render
  data-nether-media-media-type="{{ media_type }}"
  {% if use_parallax %}data-nether-media-parallax{% endif %}
>
  <div
    class="nether-media-card__media-inner media media--transparent media--hover-effect global-media-settings nether-media-fill"
    data-nether-media-media-inner
  >
    {%- case media_type -%}
      {%- when 'background_video' -%}
        {%- render 'nether-media-video',
          mode: 'background',
          shopify_video: shopify_video,
          video_url: video_url,
          poster_image: poster_image,
          video_description: video_description,
          video_loop: video_loop,
          widths: widths,
          sizes: sizes,
          loading: loading_attr,
          fetchpriority: fetch_priority_value,
          video_class: 'nether-media-card__video nether-media-card__video--background',
          bg_attr: 'data-nether-media-bg-video',
          video_image_size: '1500x',
          poster_width: 2000,
          placeholder: 'image'
        -%}

      {%- when 'video' -%}
        {%- render 'nether-media-video',
          mode: 'deferred',
          shopify_video: shopify_video,
          video_url: video_url,
          poster_image: poster_image,
          fallback_image: desktop_image,
          video_description: video_description,
          video_loop: video_loop,
          widths: widths,
          sizes: sizes,
          loading: loading_attr,
          fetchpriority: fetch_priority_value,
          video_class: 'nether-media-card__video',
          deferred_class: 'nether-media-card__deferred-media',
          poster_class: 'nether-media-card__video-poster',
          play_attr: 'data-nether-media-play',
          video_image_size: '1500x',
          poster_width: 2000,
          placeholder: 'image'
        -%}

      {%- else -%}
        {%- if desktop_image != blank -%}
          {%- render 'nether-media-picture',
            desktop_image: desktop_image,
            mobile_image: mobile_image,
            widths: widths,
            sizes: sizes,
            loading: loading_attr,
            fetchpriority: fetch_priority_value,
            alt: desktop_alt,
            mobile_preset: 'card',
            image_width: 2000,
            object_position: media_object_position
          -%}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
    {%- endcase -%}
  </div>

  {%- comment -%} Future-ready slot for AR / 3D model integrations {%- endcomment -%}
  <div
    class="nether-media-card__model-slot"
    data-nether-media-future
    {% if block.settings.ar_url != blank %}data-nether-media-ar-url="{{ block.settings.ar_url | escape }}"{% endif %}
    hidden
  ></div>
</div>
