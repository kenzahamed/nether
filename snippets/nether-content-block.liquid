{% comment %}
  Central dispatcher for Nether Premium Content blocks.

  Accepts:
  - block: {Object} Theme Editor block (required)
  - section: {Object} Content section (required)
  - heading_tag: {String} Primary heading element (default: h2)

  Usage:
  {% render 'nether-content-block', block: block, section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign subheading_element = 'h3'
  if heading_element == 'h3'
    assign subheading_element = 'h4'
  endif
-%}

{%- case block.type -%}
  {%- when '@app', 'eyebrow', 'heading', 'subheading', 'text', 'buttons' -%}
    {%- render 'nether-shared-header-block',
      block: block,
      class_prefix: 'nether-content',
      heading_element: heading_element,
      subheading_element: subheading_element,
      motion_attr: 'data-nether-content-animate data-nether-hero-animate',
      role_attr: 'data-nether-hero-role'
    -%}

  {%- when 'image' -%}
    {%- render 'nether-content-image', block: block -%}

  {%- when 'video' -%}
    {%- render 'nether-content-video', block: block -%}

  {%- when 'quote' -%}
    {%- render 'nether-content-quote', block: block -%}

  {%- when 'statistic' -%}
    {%- render 'nether-hero-stat', block: block -%}

  {%- when 'feature_list' -%}
    {%- render 'nether-hero-feature-list', block: block -%}

  {%- when 'icon_list' -%}
    {%- render 'nether-content-icon-list', block: block -%}

  {%- when 'divider' -%}
    <div
      class="nether-content__block-divider nether-content__block-divider--{{ block.settings.divider_style | default: 'line' }}"
      data-nether-content-animate
      data-nether-hero-animate
      data-nether-hero-role="divider"
      aria-hidden="true"
      role="presentation"
      {{ block.shopify_attributes }}
    ></div>

  {%- when 'custom_html' -%}
    {%- render 'nether-content-custom-html', block: block -%}

  {%- when 'content_card' -%}
    <div
      class="nether-content__card-slot"
      data-nether-content-animate
      data-nether-hero-animate
      data-nether-hero-role="card"
      {{ block.shopify_attributes }}
    >
      {%- render 'card',
        type: 'content',
        style: block.settings.card_style,
        heading: block.settings.heading,
        caption: block.settings.caption,
        description: block.settings.description,
        image: block.settings.image,
        cta_label: block.settings.cta_label,
        cta_link: block.settings.cta_link,
        cta_style: block.settings.cta_style,
        icon: block.settings.icon,
        hover: block.settings.hover_effects,
        radius: block.settings.card_radius,
        shadow: block.settings.card_shadow
      -%}
    </div>
{%- endcase -%}
