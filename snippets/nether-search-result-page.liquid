{% comment %}
  Renders a Nether Premium predictive search page card.

  Accepts:
  - page: {Object} Page resource
  - index: {Number} Loop index for unique ids
  - variant: {String} desktop | mobile — unique id suffix (default: desktop)

  Usage:
  {% render 'nether-search-result-page', page: page, index: forloop.index %}
{% endcomment %}

{%- liquid
  assign id_variant = variant | default: 'desktop'
-%}

<li
  id="predictive-search-option-page-{{ id_variant }}-{{ index }}"
  class="nether-search-result nether-search-result--page predictive-search__list-item"
  role="option"
  aria-selected="false"
>
  <a href="{{ page.url }}" class="nether-search-result__link predictive-search__item link link--text" tabindex="-1">
    <div class="nether-search-result__content predictive-search__item-content predictive-search__item-content--centered">
      <p class="nether-search-result__title predictive-search__item-heading h5">{{ page.title | escape }}</p>
      <span class="nether-search-result__meta caption-with-letter-spacing">{{ 'sections.header.search_drawer.page' | t }}</span>
    </div>
  </a>
</li>
