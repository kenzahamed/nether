{% comment %}
  Nether Premium Quick View — reusable open trigger.

  Accepts:
  - product: {Object} Product (required)
  - style: {String} icon | button | text | overlay (default: icon)
  - size: {String} sm | md | lg (default: md)
  - button_style: {String} Button system style when style is button (default: secondary)
  - class: {String} Extra classes (optional)
  - context: {String} card | collection | product | search | wishlist | compare | cart (optional)
  - label: {String} Accessible label override (optional)

  Usage:
  {% render 'nether-quick-view-trigger', product: card_product, style: 'icon', context: 'card' %}
{% endcomment %}

{%- if product != blank -%}
{%- liquid
  assign qv_style = style | default: 'icon'
  assign qv_size = size | default: 'md'
  assign qv_button_style = button_style | default: 'secondary'
  assign qv_context = context | default: 'card'
  assign qv_label = label | default: 'sections.nether_quick_view.actions.open' | t

  assign icon_size = 'md'
  if qv_size == 'sm'
    assign icon_size = 'sm'
  elsif qv_size == 'lg'
    assign icon_size = 'lg'
  endif

  assign trigger_classes = 'nether-quick-view-trigger nether-quick-view-trigger--' | append: qv_style
  assign trigger_classes = trigger_classes | append: ' nether-quick-view-trigger--' | append: qv_size
  if class != blank
    assign trigger_classes = trigger_classes | append: ' ' | append: class
  endif
-%}

<nether-quick-view-trigger
  class="{{ trigger_classes }}"
  data-nether-quick-view-trigger
  data-product-url="{{ product.url }}"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-quick-view-context="{{ qv_context }}"
>
  {%- if qv_style == 'button' -%}
    <button
      type="button"
      class="button button--{{ qv_button_style }} button--{{ qv_size | replace: 'sm', 'small' | replace: 'md', 'medium' | replace: 'lg', 'large' }} nether-quick-view-trigger__control"
      aria-haspopup="dialog"
      aria-label="{{ qv_label | escape }}"
      data-nether-quick-view-open
      data-product-url="{{ product.url }}"
    >
      <span class="nether-quick-view-trigger__label">{{ qv_label }}</span>
      {%- render 'loading-spinner' -%}
    </button>
  {%- elsif qv_style == 'text' -%}
    <button
      type="button"
      class="nether-quick-view-trigger__control nether-quick-view-trigger__control--text link underlined-link"
      aria-haspopup="dialog"
      aria-label="{{ qv_label | escape }}"
      data-nether-quick-view-open
      data-product-url="{{ product.url }}"
    >
      <span class="nether-quick-view-trigger__label">{{ qv_label }}</span>
      {%- render 'loading-spinner' -%}
    </button>
  {%- elsif qv_style == 'overlay' -%}
    <button
      type="button"
      class="button button--secondary button--small nether-quick-view-trigger__control nether-quick-view-trigger__control--overlay"
      aria-haspopup="dialog"
      aria-label="{{ qv_label | escape }}"
      data-nether-quick-view-open
      data-product-url="{{ product.url }}"
    >
      {% render 'icon', icon: 'eye', size: icon_size, decorative: true %}
      <span class="nether-quick-view-trigger__label">{{ qv_label }}</span>
      {%- render 'loading-spinner' -%}
    </button>
  {%- else -%}
    <button
      type="button"
      class="nether-quick-view-trigger__control nether-quick-view-trigger__control--icon"
      aria-haspopup="dialog"
      aria-label="{{ qv_label | escape }}"
      data-nether-quick-view-open
      data-product-url="{{ product.url }}"
    >
      {% render 'icon', icon: 'eye', size: icon_size, decorative: true %}
      {%- render 'loading-spinner' -%}
    </button>
  {%- endif -%}
</nether-quick-view-trigger>
{%- endif -%}
