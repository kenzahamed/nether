{% comment %}
  Optional section divider for Nether Premium FAQ Framework.

  Accepts:
  - section: {Object} FAQ section (required)
  - position: {String} top or bottom (required)

  Usage:
  {% render 'nether-faq-divider', section: section, position: 'bottom' %}
{% endcomment %}

{%- liquid
  assign divider_position = position | default: 'bottom'
  assign divider_style = section.settings.nether_divider_style | default: 'line'
-%}

{%- render 'nether-divider',
  class_prefix: 'nether-faq',
  position: divider_position,
  style: divider_style,
  attributes: 'data-nether-faq-divider data-nether-faq-role="divider"'
-%}
