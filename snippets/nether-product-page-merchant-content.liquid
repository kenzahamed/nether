{% comment %}
  Nether Premium Product Page — Merchant content area module.

  Accepts:
  - block: {Object} Block object (required)
  - section: {Object} Section object (required)
{% endcomment %}

{%- if block.settings.heading != blank or block.settings.content != blank or block.settings.page.content != blank -%}
  <div
    class="nether-product-page__module nether-product-page__module--merchant{% if block.settings.full_width %} nether-product-page__module--full-width{% endif %}"
    data-nether-product-page-module="merchant"
    data-nether-product-page-animate
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.heading != blank -%}
      <h2 class="nether-product-page__module-heading type-heading-sm">{{ block.settings.heading }}</h2>
    {%- endif -%}
    <div class="nether-product-page__merchant-content rte">
      {{ block.settings.content }}
      {{ block.settings.page.content }}
    </div>
  </div>
{%- endif -%}
