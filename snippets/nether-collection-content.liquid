{% comment %}
  Renders Nether Premium Collection section header content.

  Accepts:
  - section: {Object} Collection section (required)
  - heading_tag: {String} Primary heading element (default: h2)

  Usage:
  {% render 'nether-collection-content', section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign alignment = section.settings.nether_content_alignment | default: 'left'
  assign has_header_blocks = false
  assign has_highlight_blocks = false

  for block in section.blocks
    case block.type
      when 'eyebrow', 'heading', 'subheading', 'text', 'buttons'
        assign has_header_blocks = true
      when 'category_highlight'
        assign has_highlight_blocks = true
    endcase
  endfor
-%}

{%- if has_header_blocks -%}
  <div
    class="{% render 'nether-layout-header-class', full_width: section.settings.nether_full_width, class: 'nether-collection__header' %}"
    data-nether-collection-header
  >
    <div
      class="nether-collection__header-inner nether-collection__header-inner--align-{{ alignment }}"
      data-nether-collection-panel
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow', 'heading', 'subheading', 'text', 'buttons', '@app' -%}
            {%- render 'nether-collection-block',
              block: block,
              section: section,
              heading_tag: heading_element
            -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- if has_highlight_blocks -%}
  <div class="nether-collection__highlights page-width" data-nether-collection-highlights>
    {%- for block in section.blocks -%}
      {%- if block.type == 'category_highlight' -%}
        {%- render 'nether-collection-block',
          block: block,
          section: section,
          heading_tag: heading_element
        -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
