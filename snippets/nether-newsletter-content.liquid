{% comment %}
  Renders Nether Premium Newsletter content shell.
  Reuses Nether Hero structural classes and block dispatcher.

  Accepts:
  - section: {Object} Newsletter section (required)
  - heading_tag: {String} Primary heading element (default: h2)

  Usage:
  {% render 'nether-newsletter-content', section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign alignment = section.settings.nether_content_alignment | default: 'center'
  assign panel_classes = 'nether-hero__panel color-' | append: section.settings.color_scheme | append: ' gradient'

  assign enable_glass = section.settings.nether_enable_glass
  if section.settings.nether_layout == 'vip_membership'
    assign enable_glass = true
  endif

  if enable_glass
    case section.settings.nether_glass_style
      when 'light'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-light'
      when 'heavy'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-heavy'
      when 'frosted'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-frosted'
      else
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-medium'
    endcase
  endif

  if section.settings.nether_layout == 'vip_membership' or section.settings.nether_enable_floating_card
    assign panel_classes = panel_classes | append: ' nether-hero__panel--card'
  endif

  if section.settings.nether_enable_floating_card
    assign panel_classes = panel_classes | append: ' nether-newsletter__panel--floating'
  endif

  if section.settings.nether_layout == 'magazine_layout'
    assign panel_classes = panel_classes | append: ' nether-newsletter__panel--magazine'
  endif
-%}

<div class="nether-hero__content-shell page-width">
  <div class="nether-hero__content nether-newsletter__content" data-nether-hero-content data-nether-newsletter-content>
    <div class="{{ panel_classes }}" data-nether-hero-panel data-nether-newsletter-panel>
      <div class="nether-hero__blocks nether-newsletter__blocks nether-hero__blocks--align-{{ alignment }}">
        {%- for block in section.blocks -%}
          {%- unless block.type == 'email_field' or block.type == 'name_field' or block.type == 'consent_checkbox' -%}
            {%- render 'nether-newsletter-block',
              block: block,
              section: section,
              heading_tag: heading_element
            -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
