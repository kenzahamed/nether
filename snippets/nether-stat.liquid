{% comment %}
  Nether shared multi-stat core (up to 3 value/label pairs).

  Accepts (normalized only — wrappers own setting IDs / locale keys):
  - block: {Object} Theme Editor block (required)
  - class_prefix: {String} BEM block prefix (required), e.g. nether-hero
  - value_type_class: {String} typography class for values (default: type-display-sm)
  - aria_label: {String} optional accessible name for the group
  - attributes: {String} optional extra HTML attributes (motion, data-*, shopify_attributes)

  Usage:
  {% render 'nether-stat',
    block: block,
    class_prefix: 'nether-hero',
    value_type_class: 'type-display-lg',
    attributes: stat_attributes
  %}
{% endcomment %}

{%- liquid
  assign value_type_class = value_type_class | default: 'type-display-sm'
  assign has_stats = false

  for i in (1..3)
    case i
      when 1
        if block.settings.stat_1_value != blank or block.settings.stat_1_label != blank
          assign has_stats = true
        endif
      when 2
        if block.settings.stat_2_value != blank or block.settings.stat_2_label != blank
          assign has_stats = true
        endif
      when 3
        if block.settings.stat_3_value != blank or block.settings.stat_3_label != blank
          assign has_stats = true
        endif
    endcase
  endfor
-%}

{%- if has_stats -%}
  <div
    class="{{ class_prefix }}__stats"
    role="group"
    {% if aria_label != blank %}aria-label="{{ aria_label | escape }}"{% endif %}
    {% if attributes != blank %}{{ attributes }}{% endif %}
  >
    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign stat_value = block.settings.stat_1_value
            assign stat_label = block.settings.stat_1_label
          when 2
            assign stat_value = block.settings.stat_2_value
            assign stat_label = block.settings.stat_2_label
          when 3
            assign stat_value = block.settings.stat_3_value
            assign stat_label = block.settings.stat_3_label
        endcase
      -%}

      {%- if stat_value != blank or stat_label != blank -%}
        <div class="{{ class_prefix }}__stat">
          {%- if stat_value != blank -%}
            <p class="{{ class_prefix }}__stat-value {{ value_type_class }}">{{ stat_value | escape }}</p>
          {%- endif -%}
          {%- if stat_label != blank -%}
            <p class="{{ class_prefix }}__stat-label type-caption">{{ stat_label | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
