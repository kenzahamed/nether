{% comment %}
  Renders statistics for a Nether Premium Collection card or block.

  Accepts:
  - block: {Object} Theme Editor block (required)
  - class_prefix: {String} CSS class prefix (default: nether-collection-card)

  Usage:
  {% render 'nether-collection-stat', block: block %}
{% endcomment %}

{%- liquid
  assign class_prefix = class_prefix | default: 'nether-collection-card'
  assign aria_label = 'sections.nether_collection.stats.label' | t
-%}

{%- capture stat_attributes -%}
  data-nether-collection-stat
{%- endcapture -%}

{%- render 'nether-stat',
  block: block,
  class_prefix: class_prefix,
  value_type_class: 'type-display-sm',
  aria_label: aria_label,
  attributes: stat_attributes
-%}
