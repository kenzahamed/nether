{% comment %}
  Renders Nether Premium Hero media layer.
  Uses shared Media Engine helpers (loading, picture, video).

  Accepts:
  - section: {Object} Hero or Banner section (required)
  - fetch_priority: {String} Image fetch priority (optional)
  - adapter: {String} 'hero' (default) or 'banner' — selects settings namespace
  - lazy_load: {Boolean} Lazy load when fetchpriority is not high (default: true)

  Usage:
  {% render 'nether-hero-media', section: section, fetch_priority: fetch_priority %}
  {% render 'nether-hero-media', section: section, adapter: 'banner' %}
{% endcomment %}

{%- liquid
  assign adapter_mode = adapter | default: 'hero'

  if adapter_mode == 'newsletter'
    assign media_type = section.settings.nether_newsletter_media_type | default: 'image'
    assign desktop_image = section.settings.nether_newsletter_image_desktop
    assign mobile_image = section.settings.nether_newsletter_image_mobile | default: desktop_image
    assign poster_image = section.settings.nether_newsletter_poster_image | default: desktop_image
    assign shopify_video = section.settings.nether_newsletter_video
    assign video_url = section.settings.nether_newsletter_video_url
    assign enable_blur = section.settings.nether_newsletter_enable_blur
    assign enable_parallax = section.settings.nether_enable_parallax
    assign video_description = section.settings.nether_newsletter_video_description
    assign video_loop = section.settings.nether_newsletter_video_loop
  elsif adapter_mode == 'faq'
    assign media_type = section.settings.nether_faq_media_type | default: 'image'
    assign desktop_image = section.settings.nether_faq_image_desktop
    assign mobile_image = section.settings.nether_faq_image_mobile | default: desktop_image
    assign poster_image = section.settings.nether_faq_poster_image | default: desktop_image
    assign shopify_video = section.settings.nether_faq_video
    assign video_url = section.settings.nether_faq_video_url
    assign enable_blur = section.settings.nether_faq_enable_blur
    assign enable_parallax = section.settings.nether_enable_parallax
    assign video_description = section.settings.nether_faq_video_description
    assign video_loop = section.settings.nether_faq_video_loop
  elsif adapter_mode == 'testimonials'
    assign media_type = section.settings.nether_testimonials_media_type | default: 'image'
    assign desktop_image = section.settings.nether_testimonials_image_desktop
    assign mobile_image = section.settings.nether_testimonials_image_mobile | default: desktop_image
    assign poster_image = section.settings.nether_testimonials_poster_image | default: desktop_image
    assign shopify_video = section.settings.nether_testimonials_video
    assign video_url = section.settings.nether_testimonials_video_url
    assign enable_blur = section.settings.nether_testimonials_enable_blur
    assign enable_parallax = section.settings.nether_enable_parallax
    assign video_description = section.settings.nether_testimonials_video_description
    assign video_loop = section.settings.nether_testimonials_video_loop
  elsif adapter_mode == 'content'
    assign media_type = section.settings.nether_content_media_type | default: 'image'
    assign desktop_image = section.settings.nether_content_image_desktop
    assign mobile_image = section.settings.nether_content_image_mobile | default: desktop_image
    assign poster_image = section.settings.nether_content_poster_image | default: desktop_image
    assign shopify_video = section.settings.nether_content_video
    assign video_url = section.settings.nether_content_video_url
    assign enable_blur = section.settings.nether_content_enable_blur
    assign enable_parallax = section.settings.nether_content_enable_parallax
    assign video_description = section.settings.nether_content_video_description
    assign video_loop = section.settings.nether_content_video_loop
  elsif adapter_mode == 'cta'
    assign media_type = section.settings.nether_cta_media_type | default: 'image'
    assign desktop_image = section.settings.nether_cta_image_desktop
    assign mobile_image = section.settings.nether_cta_image_mobile | default: desktop_image
    assign poster_image = section.settings.nether_cta_poster_image | default: desktop_image
    assign shopify_video = section.settings.nether_cta_video
    assign video_url = section.settings.nether_cta_video_url
    assign enable_blur = section.settings.nether_cta_enable_blur
    assign enable_parallax = section.settings.nether_enable_parallax
    assign video_description = section.settings.nether_cta_video_description
    assign video_loop = section.settings.nether_cta_video_loop

    if desktop_image == blank and section.settings.nether_cta_product != blank
      assign cta_product_media = all_products[section.settings.nether_cta_product]
      if cta_product_media.featured_media != blank
        assign desktop_image = cta_product_media.featured_media.preview_image
        assign mobile_image = desktop_image
      endif
    endif

    if desktop_image == blank and section.settings.nether_cta_collection != blank
      assign cta_collection_media = collections[section.settings.nether_cta_collection]
      if cta_collection_media.featured_image != blank
        assign desktop_image = cta_collection_media.featured_image
        assign mobile_image = desktop_image
      elsif cta_collection_media.image != blank
        assign desktop_image = cta_collection_media.image
        assign mobile_image = desktop_image
      endif
    endif
  elsif adapter_mode == 'banner'
    assign media_type = section.settings.nether_banner_media_type | default: 'image'
    assign desktop_image = section.settings.nether_banner_image_desktop
    assign mobile_image = section.settings.nether_banner_image_mobile | default: desktop_image
    assign poster_image = section.settings.nether_banner_poster_image | default: desktop_image
    assign shopify_video = section.settings.nether_banner_video
    assign video_url = section.settings.nether_banner_video_url
    assign enable_blur = section.settings.nether_banner_enable_blur
    assign enable_parallax = section.settings.nether_banner_enable_parallax
    assign video_description = section.settings.nether_banner_video_description
    assign video_loop = section.settings.nether_banner_video_loop

    if desktop_image == blank and section.settings.nether_banner_collection != blank
      assign banner_collection = collections[section.settings.nether_banner_collection]
      if banner_collection.image != blank
        assign desktop_image = banner_collection.image
        assign mobile_image = banner_collection.image
      endif
    endif
  else
    assign media_type = section.settings.nether_media_type | default: 'image'
    assign desktop_image = section.settings.nether_image_desktop
    assign mobile_image = section.settings.nether_image_mobile | default: desktop_image
    assign poster_image = section.settings.nether_poster_image | default: desktop_image
    assign shopify_video = section.settings.nether_video
    assign video_url = section.settings.nether_video_url
    assign enable_blur = section.settings.nether_enable_blur
    assign enable_parallax = section.settings.nether_enable_parallax
    assign video_description = section.settings.nether_video_description
    assign video_loop = section.settings.nether_video_loop
  endif

  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
  assign sizes = '100vw'
  assign fetch_priority_value = fetch_priority | default: 'auto'
  assign is_lazy = lazy_load | default: true

  assign media_classes = 'nether-hero__media'
  if enable_blur
    assign media_classes = media_classes | append: ' nether-hero__media--blur'
  endif
  if desktop_image == blank and shopify_video == blank and video_url == blank
    assign media_classes = media_classes | append: ' nether-hero__media--placeholder'
  endif

  assign media_object_position = blank
  if desktop_image.presentation.focal_point != blank
    assign media_object_position = desktop_image.presentation.focal_point
  endif
-%}

{%- capture loading_attr -%}
  {%- render 'nether-media-loading', lazy_load: is_lazy, fetch_priority: fetch_priority_value -%}
{%- endcapture -%}
{%- assign loading_attr = loading_attr | strip -%}

<div
  class="{{ media_classes }}"
  data-nether-hero-media
  data-nether-hero-media-type="{{ media_type }}"
  {% if enable_parallax %}data-nether-parallax{% endif %}
  {% if media_object_position != blank %}style="--nether-media-object-position: {{ media_object_position }};"{% endif %}
>
  <div class="nether-hero__media-inner">
    {%- case media_type -%}
      {%- when 'background_video' -%}
        {%- render 'nether-media-video',
          mode: 'background',
          shopify_video: shopify_video,
          video_url: video_url,
          poster_image: poster_image,
          video_description: video_description,
          video_loop: video_loop,
          widths: widths,
          sizes: sizes,
          loading: loading_attr,
          fetchpriority: fetch_priority_value,
          video_class: 'nether-hero__video',
          bg_attr: 'data-nether-hero-bg-video',
          video_image_size: '1920x',
          poster_width: 3840,
          placeholder: 'hero-apparel-1'
        -%}

      {%- when 'video' -%}
        {%- render 'nether-media-video',
          mode: 'deferred',
          shopify_video: shopify_video,
          video_url: video_url,
          poster_image: poster_image,
          video_description: video_description,
          video_loop: video_loop,
          widths: widths,
          sizes: sizes,
          loading: loading_attr,
          fetchpriority: fetch_priority_value,
          video_class: 'nether-hero__video',
          deferred_class: 'nether-hero__deferred-video media',
          poster_class: 'nether-hero__video-poster',
          video_image_size: '1920x',
          poster_width: 3840,
          placeholder: 'hero-apparel-2'
        -%}

      {%- else -%}
        {%- if desktop_image != blank -%}
          {%- render 'nether-media-picture',
            desktop_image: desktop_image,
            mobile_image: mobile_image,
            widths: widths,
            sizes: sizes,
            loading: loading_attr,
            fetchpriority: fetch_priority_value,
            alt: desktop_image.alt,
            mobile_preset: 'hero',
            image_width: 3840,
            object_position: media_object_position
          -%}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
    {%- endcase -%}
  </div>

  {%- comment -%} Future-ready slot for 3D / interactive media integrations {%- endcomment -%}
  <div class="nether-hero__media-slot--future" data-nether-hero-media-future hidden></div>
</div>
