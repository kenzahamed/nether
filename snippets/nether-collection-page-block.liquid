{% comment %}
  Central dispatcher for Nether Premium Collection Page blocks.
  Reuses shared Nether content blocks and collection highlight patterns.

  Accepts:
  - block: {Object} Theme Editor block (required)
  - section: {Object} Section object (required)
  - heading_tag: {String} Primary heading element (default: h2)
  - zone: {String} hero, footer, or toolbar (optional)

  Usage:
  {% render 'nether-collection-page-block', block: block, section: section, heading_tag: 'h1', zone: 'hero' %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign subheading_element = 'h3'
  if heading_element == 'h3' or heading_element == 'h1'
    assign subheading_element = 'h3'
  endif
  if heading_element == 'h1'
    assign subheading_element = 'h2'
  endif
-%}

{%- comment -%} Zone: {{ zone | default: 'footer' }} {%- endcomment -%}

{%- case block.type -%}
  {%- when '@app' -%}
    <div class="nether-collection-page__app-block" data-nether-collection-page-animate {{ block.shopify_attributes }}>
      {% render block %}
    </div>

  {%- when 'eyebrow' -%}
    {%- if block.settings.text != blank -%}
      <p class="nether-collection-page__eyebrow type-overline" data-nether-collection-page-animate {{ block.shopify_attributes }}>
        {{- block.settings.text | escape -}}
      </p>
    {%- endif -%}

  {%- when 'heading' -%}
    {%- if block.settings.heading != blank -%}
      <{{ heading_element }}
        class="nether-collection-page__heading inline-richtext {{ block.settings.heading_size }}"
        data-nether-collection-page-animate
        {{ block.shopify_attributes }}
      >
        {{- block.settings.heading -}}
      </{{ heading_element }}>
    {%- endif -%}

  {%- when 'subheading' -%}
    {%- if block.settings.subheading != blank -%}
      <{{ subheading_element }}
        class="nether-collection-page__subheading inline-richtext {{ block.settings.subheading_size }}"
        data-nether-collection-page-animate
        {{ block.shopify_attributes }}
      >
        {{- block.settings.subheading -}}
      </{{ subheading_element }}>
    {%- endif -%}

  {%- when 'text' -%}
    {%- if block.settings.text != blank -%}
      <div class="nether-collection-page__text rte {{ block.settings.text_style }}" data-nether-collection-page-animate {{ block.shopify_attributes }}>
        {{ block.settings.text }}
      </div>
    {%- endif -%}

  {%- when 'buttons' -%}
    {%- if block.settings.button_label_1 != blank or block.settings.button_label_2 != blank -%}
      <div class="nether-collection-page__buttons" data-nether-collection-page-animate {{ block.shopify_attributes }}>
        {%- if block.settings.button_label_1 != blank -%}
          {%- render 'button',
            label: block.settings.button_label_1,
            link: block.settings.button_link_1,
            style: block.settings.button_style_1,
            size: block.settings.button_size,
            disabled: block.settings.button_link_1 == blank
          -%}
        {%- endif -%}
        {%- if block.settings.button_label_2 != blank -%}
          {%- render 'button',
            label: block.settings.button_label_2,
            link: block.settings.button_link_2,
            style: block.settings.button_style_2,
            size: block.settings.button_size,
            disabled: block.settings.button_link_2 == blank
          -%}
        {%- endif -%}
      </div>
    {%- endif -%}

  {%- when 'stat' -%}
    {% render 'nether-hero-stat', block: block, motion_attr: 'data-nether-collection-page-animate' %}

  {%- when 'statistic' -%}
    {% render 'nether-hero-stat', block: block, motion_attr: 'data-nether-collection-page-animate' %}

  {%- when 'category_highlight' -%}
    <div class="nether-collection-page__highlight" data-nether-collection-page-animate>
      {% render 'nether-collection-highlight', block: block, section: section %}
    </div>

  {%- when 'merchant_content' -%}
    {% render 'nether-collection-page-merchant-content', block: block, section: section %}

  {%- when 'editorial_content' -%}
    {% render 'nether-collection-page-merchant-content', block: block, section: section %}

  {%- when 'collection_description' -%}
    {% render 'nether-collection-page-description', block: block, section: section, collection: collection %}

  {%- when 'collection_info' -%}
    {% render 'nether-collection-page-info', block: block, section: section, collection: collection, paginate: paginate %}

  {%- when 'subcollections' -%}
    {% render 'nether-collection-page-subcollections', block: block, section: section %}

  {%- when 'promotional_card' -%}
    {% render 'nether-product-promotional-card', block: block, section: section %}

  {%- when 'wishlist_placeholder' -%}
    <div
      class="nether-collection-page__module nether-collection-page__module--wishlist nether-collection-page__wishlist"
      data-nether-collection-page-module="wishlist"
      data-nether-collection-page-animate
      {{ block.shopify_attributes }}
    >
      <div class="nether-collection-page__wishlist-inner" role="group" aria-label="{{ 'sections.nether_wishlist.title' | t }}">
        <p class="nether-collection-page__wishlist-note type-body-sm">
          {%- if block.settings.text != blank -%}
            {{ block.settings.text }}
          {%- else -%}
            {{ 'sections.nether_wishlist.collection_note' | t }}
          {%- endif -%}
        </p>
      </div>
      {% render 'nether-wishlist-extensions', type: 'recently' %}
    </div>

  {%- when 'compare_placeholder' -%}
    <div
      class="nether-collection-page__module nether-collection-page__module--compare nether-collection-page__compare"
      data-nether-collection-page-module="compare"
      data-nether-collection-page-animate
      {{ block.shopify_attributes }}
    >
      <div class="nether-collection-page__compare-inner" role="group" aria-label="{{ 'sections.nether_compare.title' | t }}">
        <p class="nether-collection-page__compare-note type-body-sm">
          {%- if block.settings.text != blank -%}
            {{ block.settings.text }}
          {%- else -%}
            {{ 'sections.nether_compare.collection_note' | t }}
          {%- endif -%}
        </p>
      </div>
      {% render 'nether-compare-extensions', type: 'recently' %}
    </div>

  {%- when 'quick_view_placeholder' -%}
    <div
      class="nether-collection-page__module nether-collection-page__module--quick-view nether-collection-page__quick-view"
      data-nether-collection-page-module="quick-view"
      data-nether-collection-page-animate
      {{ block.shopify_attributes }}
    >
      <div class="nether-collection-page__quick-view-inner" role="group" aria-label="{{ 'sections.nether_quick_view.title' | t }}">
        <p class="nether-collection-page__quick-view-note type-body-sm">
          {%- if block.settings.text != blank -%}
            {{ block.settings.text }}
          {%- else -%}
            {{ 'sections.nether_quick_view.collection_note' | t }}
          {%- endif -%}
        </p>
      </div>
      {% render 'nether-quick-view-extensions', type: 'recommendations' %}
      {% render 'nether-recommendations-extensions', type: 'recently_viewed' %}
    </div>

  {%- when 'recommendations_placeholder' -%}
    <div
      class="nether-collection-page__module nether-collection-page__module--recommendations nether-collection-page__recommendations"
      data-nether-collection-page-module="recommendations"
      data-nether-collection-page-animate
      {{ block.shopify_attributes }}
    >
      <div class="nether-collection-page__recommendations-inner" role="group" aria-label="{{ 'sections.nether_recommendations.heading' | t }}">
        <p class="nether-collection-page__recommendations-note type-body-sm">
          {%- if block.settings.text != blank -%}
            {{ block.settings.text }}
          {%- else -%}
            {{ 'sections.nether_recommendations.collection_note' | t }}
          {%- endif -%}
        </p>
      </div>
      {% render 'nether-recommendations-extensions', type: 'for_you' %}
      {% render 'nether-recommendations-extensions', type: 'merchandising' %}
    </div>

  {%- when 'infinite_scroll_placeholder', 'merchandising_rules_placeholder' -%}
    {% render 'nether-collection-page-extensions', block: block, section: section %}
{%- endcase -%}
