{% comment %}
  Central dispatcher for Nether Premium Hero content blocks.

  Accepts:
  - block: {Object} Theme Editor block (required)
  - section: {Object} Hero section (required)
  - heading_tag: {String} Primary heading element (default: h1)

  Usage:
  {% render 'nether-hero-block', block: block, section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h1'
  assign subheading_element = 'h2'
  if heading_element == 'h2'
    assign subheading_element = 'h3'
  endif
-%}

{%- case block.type -%}
  {%- when '@app', 'eyebrow', 'heading', 'subheading', 'text', 'buttons' -%}
    {%- render 'nether-shared-header-block',
      block: block,
      class_prefix: 'nether-hero',
      heading_element: heading_element,
      subheading_element: subheading_element,
      motion_attr: 'data-nether-hero-animate',
      role_attr: 'data-nether-hero-role'
    -%}

  {%- when 'trust_badges' -%}
    {%- render 'nether-hero-trust-badges', block: block -%}

  {%- when 'stat' -%}
    {%- render 'nether-hero-stat', block: block -%}

  {%- when 'feature_list' -%}
    {%- render 'nether-hero-feature-list', block: block -%}

  {%- when 'hero_card' -%}
    <div class="nether-hero__card-slot" data-nether-hero-animate data-nether-hero-role="card" {{ block.shopify_attributes }}>
      {%- render 'card',
        type: 'content',
        style: block.settings.card_style,
        heading: block.settings.heading,
        caption: block.settings.caption,
        description: block.settings.description,
        image: block.settings.image,
        cta_label: block.settings.cta_label,
        cta_link: block.settings.cta_link,
        cta_style: block.settings.cta_style,
        icon: block.settings.icon,
        hover: block.settings.hover_effects,
        radius: block.settings.card_radius,
        shadow: block.settings.card_shadow
      -%}
    </div>
{%- endcase -%}
