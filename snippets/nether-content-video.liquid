{% comment %}
  Renders Nether Premium Content inline video block.
  Uses shared Media Engine video helper.

  Accepts:
  - block: {Object} Theme Editor block (required)
  - motion_attr: {String} Motion data attribute from host framework (optional; defaults to Content + Hero animate attributes)

  Usage:
  {% render 'nether-content-video', block: block %}
  {% render 'nether-content-video', block: block, motion_attr: motion_attr %}
{% endcomment %}

{%- liquid
  assign media_type = block.settings.media_type | default: 'video'
  assign shopify_video = block.settings.video
  assign video_url = block.settings.video_url
  assign poster_image = block.settings.poster_image
  assign video_description = block.settings.video_description
  assign video_loop = block.settings.video_loop
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000'
  assign sizes = '(min-width: 990px) 60rem, (min-width: 750px) 50vw, 100vw'
-%}

{%- if shopify_video != blank or video_url != blank -%}
  <div
    class="nether-content__video-block"
    {%- if motion_attr != blank %}
    {{ motion_attr }}
    {%- else %}
    data-nether-content-animate
    data-nether-hero-animate
    {%- endif %}
    data-nether-hero-role="video"
    {{ block.shopify_attributes }}
  >
    {%- if media_type == 'background_video' -%}
      {%- render 'nether-media-video',
        mode: 'background',
        shopify_video: shopify_video,
        video_url: video_url,
        poster_image: poster_image,
        video_description: video_description,
        video_loop: video_loop,
        widths: widths,
        sizes: sizes,
        loading: 'lazy',
        fetchpriority: 'auto',
        video_class: 'nether-content__video',
        bg_attr: 'data-nether-content-bg-video',
        video_image_size: '1500x',
        poster_width: 2000,
        placeholder: 'hero-apparel-2'
      -%}
    {%- else -%}
      {%- render 'nether-media-video',
        mode: 'deferred',
        shopify_video: shopify_video,
        video_url: video_url,
        poster_image: poster_image,
        video_description: video_description,
        video_loop: video_loop,
        widths: widths,
        sizes: sizes,
        loading: 'lazy',
        fetchpriority: 'auto',
        video_class: 'nether-content__video',
        deferred_class: 'nether-content__deferred-video media',
        poster_class: 'nether-content__video-poster',
        video_image_size: '1500x',
        poster_width: 2000,
        placeholder: 'hero-apparel-2'
      -%}
    {%- endif -%}
  </div>
{%- endif -%}
