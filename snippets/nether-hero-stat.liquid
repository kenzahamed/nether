{% comment %}
  Renders Nether Premium Hero statistics block.

  Accepts:
  - block: {Object} Theme Editor block (required)

  Usage:
  {% render 'nether-hero-stat', block: block %}
{% endcomment %}

{%- liquid
  assign motion_attr = motion_attr | default: 'data-nether-hero-animate'
-%}

{%- capture stat_attributes -%}
  {{ motion_attr }} data-nether-hero-role="stats" {{ block.shopify_attributes }}
{%- endcapture -%}

{%- render 'nether-stat',
  block: block,
  class_prefix: 'nether-hero',
  value_type_class: 'type-display-lg',
  attributes: stat_attributes
-%}
