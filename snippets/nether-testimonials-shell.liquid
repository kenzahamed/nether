{% comment %}
  Renders Nether Premium Testimonials hero-composed shell for editorial/minimal layouts.

  Accepts:
  - section: {Object} Testimonials section (required)
  - heading_tag: {String} Primary heading element (default: h2)

  Usage:
  {% render 'nether-testimonials-shell', section: section, heading_tag: heading_tag %}
{% endcomment %}

{%- liquid
  assign heading_element = heading_tag | default: 'h2'
  assign alignment = section.settings.nether_content_alignment | default: 'left'
  assign panel_classes = 'nether-hero__panel nether-testimonials__panel color-' | append: section.settings.color_scheme | append: ' gradient'

  if section.settings.nether_enable_glass
    case section.settings.nether_glass_style
      when 'light'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-light'
      when 'heavy'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-heavy'
      when 'frosted'
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-frosted'
      else
        assign panel_classes = panel_classes | append: ' nether-hero__panel--glass glass-hero-medium'
    endcase
  endif

  if section.settings.nether_enable_floating_cards
    assign panel_classes = panel_classes | append: ' nether-testimonials__panel--floating'
  endif

  assign shell_block_types = 'eyebrow,heading,subheading,text,quote,author,author_image,company,role,rating,statistic,award,certification,press_mention,trust_badge,video_testimonial,customer_testimonial,buttons,divider,custom_html,@app' | split: ','
-%}

<div class="nether-hero__content-shell page-width">
  <div class="nether-hero__content nether-testimonials__content" data-nether-testimonials-shell>
    <div class="{{ panel_classes }}" data-nether-testimonials-panel>
      <div class="nether-hero__blocks nether-testimonials__blocks nether-hero__blocks--align-{{ alignment }}">
        {%- for block in section.blocks -%}
          {%- if shell_block_types contains block.type -%}
            {%- render 'nether-testimonials-block',
              block: block,
              section: section,
              heading_tag: heading_element
            -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
