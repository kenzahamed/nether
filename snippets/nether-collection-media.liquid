{% comment %}
  Renders media for a Nether Premium Collection card.

  Accepts:
  - block: {Object} Collection block (required)
  - section: {Object} Collection section (required)
  - collection: {Object} Shopify collection (required)
  - columns: {Number} Grid columns for image sizes (optional)
  - lazy_load: {Boolean} Lazy load images (default: true)
  - fetch_priority: {String} Image fetch priority (optional)

  Usage:
  {% render 'nether-collection-media', block: block, section: section, collection: collection, columns: columns %}
{% endcomment %}

{%- liquid
  assign card_collection = collection
  assign media_type = block.settings.media_type | default: 'image'
  assign custom_image = block.settings.custom_image
  assign custom_image_mobile = block.settings.custom_image_mobile | default: custom_image
  assign shopify_video = block.settings.video
  assign video_url = block.settings.video_url
  assign poster_image = block.settings.poster_image
  assign video_description = block.settings.video_description | default: card_collection.title
  assign video_loop = block.settings.video_loop
  assign image_ratio = section.settings.nether_image_ratio | default: section.settings.image_ratio | default: 'portrait'
  assign columns_count = columns | default: 3
  assign is_lazy = lazy_load | default: true
  assign fetch_priority_value = fetch_priority | default: 'auto'

  assign desktop_image = custom_image
  if desktop_image == blank and card_collection != blank
    if card_collection.featured_image != blank
      assign desktop_image = card_collection.featured_image
    elsif card_collection.image != blank
      assign desktop_image = card_collection.image
    endif
  endif

  assign mobile_image = custom_image_mobile | default: desktop_image

  if poster_image == blank
    assign poster_image = desktop_image
  endif

  # Showcase ratio contract (identical across product/collection/media-render):
  # portrait 0.8 · landscape 1.4 · square 1 · adapt image AR (fallback 1)
  assign ratio = 1
  if desktop_image != blank and image_ratio == 'portrait'
    assign ratio = 0.8
  elsif desktop_image != blank and image_ratio == 'landscape'
    assign ratio = 1.4
  elsif desktop_image != blank and image_ratio == 'adapt'
    assign ratio = desktop_image.aspect_ratio
  elsif image_ratio == 'square'
    assign ratio = 1
  endif
  if ratio == 0 or ratio == null
    assign ratio = 1
  endif

  assign widths = '165, 330, 535, 750, 1000, 1500, 2000, 3000'
  assign sizes = '(min-width: ' | append: settings.page_width | append: 'px) ' | append: settings.page_width | minus: 100 | divided_by: columns_count | append: 'px, (min-width: 750px) calc((100vw - 10rem) / ' | append: columns_count | append: '), calc(100vw - 3rem)'
-%}

<div
  class="nether-collection-card__media ratio"
  style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
  data-nether-collection-media
  {% if section.settings.nether_enable_parallax %}data-nether-collection-parallax{% endif %}
>
  <div class="nether-collection-card__media-inner media media--transparent media--hover-effect">
    {%- case media_type -%}
      {%- when 'video' -%}
        {%- if shopify_video != blank -%}
          <deferred-media class="nether-collection-card__deferred-media">
            {{
              shopify_video
              | video_tag:
                image_size: '1100x',
                autoplay: false,
                loop: video_loop,
                muted: true,
                controls: true,
                playsinline: true,
                poster: poster_image,
                class: 'nether-collection-card__video'
            }}
          </deferred-media>
        {%- elsif video_url != blank -%}
          {%- if video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ video_url.id }}"
              class="nether-collection-card__video nether-collection-card__video--iframe"
              allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
              title="{{ video_description | escape }}"
              loading="lazy"
            ></iframe>
          {%- elsif video_url.type == 'vimeo' -%}
            <iframe
              src="https://player.vimeo.com/video/{{ video_url.id }}"
              class="nether-collection-card__video nether-collection-card__video--iframe"
              allow="autoplay; encrypted-media"
              title="{{ video_description | escape }}"
              loading="lazy"
            ></iframe>
          {%- endif -%}
        {%- elsif desktop_image != blank -%}
          {{
            desktop_image
            | image_url: width: 1500
            | image_tag:
              widths: widths,
              sizes: sizes,
              alt: desktop_image.alt | default: card_collection.title,
              class: 'motion-reduce',
              loading: is_lazy,
              fetchpriority: fetch_priority_value
          }}
        {%- else -%}
          {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

      {%- else -%}
        {%- if desktop_image != blank -%}
          <picture>
            {%- if mobile_image != blank and mobile_image != desktop_image -%}
              <source
                media="(max-width: 749px)"
                srcset="
                  {%- if mobile_image.width >= 330 -%}{{ mobile_image | image_url: width: 330 }} 330w,{%- endif -%}
                  {%- if mobile_image.width >= 535 -%}{{ mobile_image | image_url: width: 535 }} 535w,{%- endif -%}
                  {%- if mobile_image.width >= 750 -%}{{ mobile_image | image_url: width: 750 }} 750w,{%- endif -%}
                  {{ mobile_image | image_url }} {{ mobile_image.width }}w
                "
                sizes="{{ sizes }}"
              >
            {%- endif -%}
            {{
              desktop_image
              | image_url: width: 1500
              | image_tag:
                widths: widths,
                sizes: sizes,
                alt: desktop_image.alt | default: card_collection.title,
                class: 'motion-reduce',
                loading: is_lazy,
                fetchpriority: fetch_priority_value
            }}
          </picture>
        {%- else -%}
          {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
    {%- endcase -%}
  </div>
</div>
