{% comment %}
  Nether Premium Mega Menu Framework.
  Extends Dawn header-mega-menu — preserves header-menu, details, and mega-menu classes.

  Usage:
  {% render 'nether-mega-menu' %}
{% endcomment %}

{%- liquid
  case section.settings.nether_mega_animation_speed
    when 'fast'
      assign mega_animation_duration = 0.15
    when 'slow'
      assign mega_animation_duration = 0.5
    else
      assign mega_animation_duration = 0.3
  endcase
-%}

<nether-mega-menu
  class="nether-mega-menu{% unless section.settings.nether_mega_desktop %} nether-mega-menu--hide-desktop{% endunless %}{% unless section.settings.nether_mega_tablet %} nether-mega-menu--hide-tablet{% endunless %}"
  data-section-id="{{ section.id }}"
  data-enable-overlay="{{ section.settings.nether_mega_enable_overlay }}"
  data-desktop="{{ section.settings.nether_mega_desktop }}"
  data-tablet="{{ section.settings.nether_mega_tablet }}"
  data-layout-type="{{ section.settings.nether_mega_layout_type }}"
  data-column-count="{{ section.settings.nether_mega_column_count }}"
  data-animation-duration="{{ mega_animation_duration }}"
  data-nether-motion="megamenu"
  aria-label="{{ 'sections.header.nether_mega_menu.label' | t }}"
>
  {%- if section.settings.nether_mega_enable_overlay -%}
    <div
      class="nether-mega-menu__overlay"
      data-nether-megamenu-overlay
      hidden
      aria-hidden="true"
    ></div>
  {%- endif -%}

  <nav class="header__inline-menu nether-mega-menu__nav" aria-label="{{ 'sections.header.menu' | t }}">
    <ul class="list-menu list-menu--inline" role="list">
      {%- for link in section.settings.menu.links -%}
        <li>
          {%- if link.links != blank -%}
            <header-menu>
              <details
                id="Details-HeaderMenu-{{ forloop.index }}"
                class="mega-menu nether-mega-menu__item"
                data-nether-mega-item="{{ link.handle }}"
              >
                <summary
                  id="HeaderMenu-{{ link.handle }}"
                  class="header__menu-item list-menu__item link focus-inset"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="MegaMenu-Content-{{ forloop.index }}"
                >
                  <span{% if link.child_active %} class="header__active-menu-item"{% endif %}>
                    {{- link.title | escape -}}
                  </span>
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </summary>
                <div
                  id="MegaMenu-Content-{{ forloop.index }}"
                  class="mega-menu__content nether-mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                  tabindex="-1"
                  role="region"
                  aria-label="{{ link.title | escape }}"
                >
                  {%- render 'nether-mega-menu-panel',
                    link: link,
                    link_index: forloop.index,
                    section: section
                  -%}
                </div>
              </details>
            </header-menu>
          {%- else -%}
            <a
              id="HeaderMenu-{{ link.handle }}"
              href="{{ link.url }}"
              class="header__menu-item list-menu__item link link--text focus-inset"
              {% if link.current %}aria-current="page"{% endif %}
            >
              <span{% if link.current %} class="header__active-menu-item"{% endif %}>
                {{- link.title | escape -}}
              </span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</nether-mega-menu>
