{% comment %}
  Optional section divider for Nether Premium Banner.

  Accepts:
  - section: {Object} Banner section (required)
  - position: {String} top or bottom (required)

  Usage:
  {% render 'nether-banner-divider', section: section, position: 'bottom' %}
{% endcomment %}

{%- liquid
  assign divider_position = position | default: 'bottom'
  assign divider_style = section.settings.nether_banner_divider_style | default: 'line'
-%}

{%- render 'nether-divider',
  class_prefix: 'nether-banner',
  position: divider_position,
  style: divider_style
-%}
