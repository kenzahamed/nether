{% comment %}
  Nether Premium Commerce Enhancements Framework
  Reusable composition host — not a standalone page framework.
  Place on product, cart, collection, or custom templates to compose commerce modules.
{% endcomment %}

{% render 'nether-commerce-assets' %}

{%- liquid
  assign trust_layout = section.settings.trust_layout | default: 'stack'
  assign badge_style = section.settings.badge_style | default: 'solid'
  assign notice_style = section.settings.notice_style | default: 'soft'
  assign animation_style = section.settings.animation_style | default: 'fade'
  assign animation_speed = section.settings.animation_speed | default: 0.45
  assign desktop_layout = section.settings.desktop_layout | default: 'stack'
  assign tablet_layout = section.settings.tablet_layout | default: 'stacked'
  assign mobile_layout = section.settings.mobile_layout | default: 'stacked'

  assign section_classes = 'nether-commerce color-' | append: section.settings.color_scheme
  assign section_classes = section_classes | append: ' nether-commerce--trust-' | append: trust_layout
  assign section_classes = section_classes | append: ' nether-commerce--desktop-' | append: desktop_layout
  assign section_classes = section_classes | append: ' nether-commerce--tablet-' | append: tablet_layout
  assign section_classes = section_classes | append: ' nether-commerce--mobile-' | append: mobile_layout
  if section.settings.enable_glass
    assign section_classes = section_classes | append: ' nether-commerce--glass'
  endif
-%}

{%- if section.settings.enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<section
  id="NetherCommerce-{{ section.id }}"
  class="nether-commerce-section section-{{ section.id }}-padding gradient {{ section_classes }}"
  style="--section-nether-commerce-padding-top: {{ section.settings.padding_top }}px; --section-nether-commerce-padding-bottom: {{ section.settings.padding_bottom }}px;"
  aria-label="{{ section.settings.aria_label | default: 'sections.nether_commerce.label' | t | escape }}"
>
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %}">
    <nether-commerce
      id="NetherCommerceRoot-{{ section.id }}"
      class="nether-commerce nether-commerce--layout-{{ desktop_layout }}"
      data-nether-motion="commerce"
      data-nether-commerce-root
      data-section-id="{{ section.id }}"
      data-animation-style="{{ animation_style }}"
      data-animation-duration="{{ animation_speed }}"
      data-trust-layout="{{ trust_layout }}"
      data-badge-style="{{ badge_style }}"
      data-notice-style="{{ notice_style }}"
      data-inventory-display="{{ section.settings.inventory_display }}"
    >
      {%- if section.settings.heading != blank -%}
        <header class="nether-commerce__header" data-nether-commerce-animate>
          <h2 class="nether-commerce__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="nether-commerce__subheading type-body-sm">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="nether-commerce__modules nether-commerce__modules--desktop-{{ desktop_layout }}">
        {%- for block in section.blocks -%}
          <div class="nether-commerce__module-wrap" {{ block.shopify_attributes }}>
            {% render 'nether-commerce-block', block: block, section: section, product: product %}
          </div>
        {%- endfor -%}
      </div>

      {% render 'nether-commerce-extensions', extension: 'delivery_provider' %}
      {% render 'nether-commerce-extensions', extension: 'shipping_api' %}
      {% render 'nether-commerce-extensions', extension: 'ai_messaging' %}
      {% render 'nether-commerce-extensions', extension: 'localization' %}
    </nether-commerce>
  </div>
</section>

<style>
  #NetherCommerce-{{ section.id }}.section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

{% schema %}
