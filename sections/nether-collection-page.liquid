{%- if section.settings.nether_enable_wishlist_cards -%}
  {% render 'nether-wishlist-assets' %}
{%- else -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'wishlist_placeholder' -%}
      {% render 'nether-wishlist-assets' %}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if section.settings.nether_enable_compare_cards -%}
  {% render 'nether-compare-assets' %}
{%- else -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'compare_placeholder' -%}
      {% render 'nether-compare-assets' %}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if section.settings.nether_enable_quick_view_cards -%}
  {% render 'nether-quick-view-assets' %}
{%- else -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'quick_view_placeholder' -%}
      {% render 'nether-quick-view-assets' %}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign use_premium_cards = false
  if section.settings.nether_card_mode == 'premium'
    assign use_premium_cards = true
  endif

  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign nether_class_list = 'nether-collection-page nether-collection-page--grid'
  assign nether_class_list = nether_class_list | append: ' nether-collection-page--toolbar-' | append: section.settings.nether_toolbar_layout
  assign nether_class_list = nether_class_list | append: ' nether-collection-page--grid-' | append: section.settings.nether_grid_layout
  assign nether_class_list = nether_class_list | append: ' nether-collection-page--card-' | append: section.settings.nether_card_mode
  assign nether_class_list = nether_class_list | append: ' nether-collection-page--filter-' | append: section.settings.filter_type
  assign nether_class_list = nether_class_list | append: ' nether-collection-page--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-collection-page--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-collection-page--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_enable_sticky_toolbar
    assign nether_class_list = nether_class_list | append: ' nether-collection-page--sticky-toolbar'
  endif

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-collection-page--glass-enabled'
  endif

  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-collection-page--gradient-enabled'
  endif

  if use_premium_cards
    assign nether_class_list = nether_class_list | append: ' nether-collection-page--premium-cards'
  endif
-%}

{%- if use_premium_cards -%}
  {{ 'component-product-showcase.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if use_premium_cards and section.settings.nether_show_rating -%}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-collection-page {
    --nether-collection-page-gap: {{ section.settings.nether_grid_gap }}px;
    --nether-collection-page-card-gap: {{ section.settings.nether_card_gap }}px;
    --nether-collection-page-columns-desktop: {{ section.settings.columns_desktop }};
    --nether-collection-page-columns-mobile: {{ section.settings.columns_mobile }};
    --nether-collection-page-transition-duration: {{ nether_animation_duration }}s;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-collection-page.js' | asset_url }}" defer="defer"></script>

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <nether-collection-page
    id="NetherCollectionPage-{{ section.id }}"
    class="{{ nether_class_list }}"
    data-section-id="{{ section.id }}"
    data-nether-motion="collection-page"
    data-animation-style="{{ section.settings.nether_animation_style }}"
    data-animation-duration="{{ nether_animation_duration }}"
    data-enable-sticky-toolbar="{{ section.settings.nether_enable_sticky_toolbar }}"
    data-default-view="{{ section.settings.nether_default_view }}"
    data-view-mode="{{ section.settings.nether_default_view | default: 'grid' }}"
    data-carousel-ready="true"
    role="region"
    aria-label="{{ section.settings.nether_aria_label | default: collection.title | escape }}"
  >
    <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
      {%- if section.settings.nether_show_top_divider -%}
        {% render 'nether-collection-page-divider', section: section, position: 'top' %}
      {%- endif -%}

      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
          {% render 'nether-collection-page-toolbar', section: section, collection: collection, paginate: paginate %}
        {%- elsif section.settings.nether_enable_sticky_toolbar or section.settings.nether_enable_view_toggle -%}
          <div class="page-width">
            {% render 'nether-collection-page-toolbar', section: section, collection: collection, paginate: paginate %}
          </div>
        {%- endif -%}

        <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %} nether-collection-page__commerce">
          {{ 'component-facets.css' | asset_url | stylesheet_tag }}

          {% render 'nether-collection-page-filters', section: section, collection: collection, paginate: paginate %}

          <div
            class="product-grid-container nether-collection-page__grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            id="ProductGridContainer"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- if collection.products.size == 0 -%}
              {% render 'nether-collection-page-empty', section: section, collection: collection %}
            {%- else -%}
              {% render 'nether-collection-page-grid', section: section, collection: collection, paginate: paginate %}
            {%- endif -%}
          </div>
        </div>

        <div class="page-width">
          {% render 'nether-collection-page-footer', section: section, collection: collection, paginate: paginate %}
        </div>
      {%- endpaginate -%}

      {%- if section.settings.nether_show_bottom_divider -%}
        {% render 'nether-collection-page-divider', section: section, position: 'bottom' %}
      {%- endif -%}

      {%- if section.settings.image_shape == 'arch' -%}
        {{ 'mask-arch.svg' | inline_asset_content }}
      {%- endif -%}
    </div>
  </nether-collection-page>
</collection-component>

