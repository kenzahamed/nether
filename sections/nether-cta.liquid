        }
      ],
      "info": "t:nether.common.info_glass_style",
      "visible_if": "{{ section.settings.nether_enable_glass }}"
    },
    {
      "type": "checkbox",
      "id": "nether_enable_gradient",
      "default": false,
      "label": "t:nether.common.enable_gradient_panel",
      "info": "t:nether.common.info_enable_gradient"
    },
    {
      "type": "select",
      "id": "nether_gradient_style",
