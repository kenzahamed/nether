        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" },
        { "value": "background_video", "label": "Background video" }
      ]
    },
    { "type": "image_picker", "id": "nether_cta_image_desktop", "label": "Desktop image" },
    { "type": "image_picker", "id": "nether_cta_image_mobile", "label": "Mobile image" },
    { "type": "video", "id": "nether_cta_video", "label": "Shopify-hosted video" },
