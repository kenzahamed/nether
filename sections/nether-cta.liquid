<script src="{{ 'component-cta.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign nether_layout = section.settings.nether_layout | default: 'centered_cta'
  assign nether_content_width = section.settings.nether_content_width | default: 'medium'
  assign nether_content_position = section.settings.nether_content_position | default: 'middle-center'
  capture nether_content_position
    render 'nether-position-value', position: nether_content_position, default: 'middle-center'
  endcapture
  assign nether_content_position = nether_content_position | strip

  assign uses_hero_shell = false
  assign uses_section_media = false
  assign uses_promotion_aside = false

  case nether_layout
    when 'editorial_cta'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign nether_hero_layout = 'editorial'
    when 'centered_cta'
      assign uses_hero_shell = false
      assign nether_hero_layout = 'classic'
    when 'split_cta', 'image_cta'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign nether_hero_layout = 'split'
    when 'background_image_cta', 'background_video_cta'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign nether_hero_layout = 'overlay'
    when 'product_promotion_cta'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign uses_promotion_aside = true
      assign nether_hero_layout = 'split'
    when 'collection_promotion_cta'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign uses_promotion_aside = true
      assign nether_hero_layout = 'split'
    when 'minimal_cta'
      assign uses_hero_shell = true
      assign nether_hero_layout = 'minimal'
    when 'luxury_cta'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign nether_hero_layout = 'editorial'
  endcase

  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign enable_glass = section.settings.nether_enable_glass
  assign enable_gradient = section.settings.nether_enable_gradient
  if nether_layout == 'luxury_cta'
    assign enable_glass = true
  endif
  if nether_layout == 'background_image_cta' or nether_layout == 'background_video_cta'
    assign enable_gradient = true
  endif

  assign nether_class_list = 'nether-cta nether-hero'
  assign nether_class_list = nether_class_list | append: ' nether-cta--layout-' | append: nether_layout
  if uses_hero_shell
    assign nether_class_list = nether_class_list | append: ' nether-hero--layout-' | append: nether_hero_layout
    assign nether_class_list = nether_class_list | append: ' nether-hero--position-' | append: nether_content_position
  endif
  if uses_hero_shell or nether_layout == 'centered_cta'
    assign nether_class_list = nether_class_list | append: ' nether-hero--width-' | append: nether_content_width
  endif
  assign nether_class_list = nether_class_list | append: ' nether-hero--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-hero--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-hero--mobile-' | append: section.settings.nether_layout_mobile
  assign nether_class_list = nether_class_list | append: ' nether-cta--spacing-' | append: section.settings.nether_spacing_preset
  assign nether_class_list = nether_class_list | append: ' nether-cta--background-' | append: section.settings.nether_background_style

  if enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-hero--glass-enabled nether-cta--glass-enabled'
  endif

  if enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-hero--gradient-enabled'
  endif

  if section.settings.nether_media_position == 'right'
    assign nether_class_list = nether_class_list | append: ' nether-hero--split-media-right'
  endif

  if section.settings.nether_enable_floating_card
    assign nether_class_list = nether_class_list | append: ' nether-cta--floating-enabled'
  endif

  case section.settings.nether_layout_tablet
    when 'stacked'
      assign nether_class_list = nether_class_list | append: ' nether-cta--tablet-stacked'
    when 'centered'
      assign nether_class_list = nether_class_list | append: ' nether-cta--tablet-centered'
  endcase

  case section.settings.nether_layout_mobile
    when 'stacked'
      assign nether_class_list = nether_class_list | append: ' nether-cta--mobile-stacked'
    when 'centered'
      assign nether_class_list = nether_class_list | append: ' nether-cta--mobile-centered'
    when 'minimal'
      assign nether_class_list = nether_class_list | append: ' nether-cta--mobile-minimal'
  endcase

  assign overlay_classes = 'nether-hero__overlay'
  if enable_gradient
    case section.settings.nether_gradient_style
      when 'dramatic'
        assign overlay_classes = overlay_classes | append: ' grad-hero-dramatic'
      when 'vignette'
        assign overlay_classes = overlay_classes | append: ' grad-hero-vignette'
      when 'fade-down'
        assign overlay_classes = overlay_classes | append: ' grad-linear-fade-down'
      else
        assign overlay_classes = overlay_classes | append: ' grad-hero-brand'
    endcase
  endif

  assign heading_tag = 'h2'
  if section.settings.nether_heading_level == 'h3'
    assign heading_tag = 'h3'
  endif

  assign needs_deferred_media = false
  if section.settings.nether_cta_media_type == 'video'
    assign needs_deferred_media = true
  endif
  for block in section.blocks
    if block.type == 'video'
      assign needs_deferred_media = true
      break
    endif
  endfor

  case section.settings.nether_spacing_preset
    when 'compact'
      assign spacing_block = 1.6
      assign spacing_inline = 2.4
    when 'spacious'
      assign spacing_block = 4.8
      assign spacing_inline = 6.4
    else
      assign spacing_block = 3.2
      assign spacing_inline = 4.8
  endcase
-%}

{%- if needs_deferred_media -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-cta {
    --nether-cta-overlay-opacity: {{ section.settings.nether_overlay_opacity | divided_by: 100.0 }};
    --nether-cta-transition-duration: {{ nether_animation_duration }}s;
    --nether-hero-overlay-opacity: {{ section.settings.nether_overlay_opacity | divided_by: 100.0 }};
    --nether-hero-transition-duration: {{ nether_animation_duration }}s;
    --nether-cta-gap: {{ spacing_block }}rem;
    --nether-cta-content-padding: {{ spacing_inline }}rem;
    --nether-hero-content-padding: var(--nether-cta-content-padding);
    --nether-hero-gap: var(--nether-cta-gap);
  }

  {% render 'nether-section-padding', section: section %}

{%- endstyle -%}

{%- if section.settings.nether_show_divider_top -%}
  {%- render 'nether-cta-divider', section: section, position: 'top' -%}
{%- endif -%}

<nether-cta
  id="NetherCta-{{ section.id }}"
  class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-nether-motion="cta"
  data-cta-layout="{{ nether_layout }}"
  data-nether-cta-layout="{{ nether_layout }}"
  {% if uses_hero_shell %}data-nether-hero-layout="{{ nether_hero_layout }}"{% endif %}
  {% if section.settings.nether_enable_parallax or section.settings.nether_enable_button_reveal or section.settings.nether_enable_card_reveal %}data-nether-motion-plugins="scrollTrigger"{% endif %}
  data-animation-style="{{ section.settings.nether_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-enable-parallax="{{ section.settings.nether_enable_parallax }}"
  data-button-reveal="{{ section.settings.nether_enable_button_reveal }}"
  data-card-reveal="{{ section.settings.nether_enable_card_reveal }}"
  data-hover-reveal="{{ section.settings.nether_enable_hover_reveal }}"
  {% if section.settings.nether_enable_floating_card %}data-floating-enabled="true"{% endif %}
  {% if section.settings.nether_enable_analytics %}data-nether-cta-analytics="true"{% endif %}
  {% if section.settings.nether_popup_target != blank %}data-nether-cta-popup-target="{{ section.settings.nether_popup_target | escape }}"{% endif %}
  role="region"
  aria-label="{% render 'nether-locale-text', value: section.settings.nether_aria_label, key: 'sections.nether_cta.aria_label' %}"
>
  <div class="nether-cta__inner nether-hero__inner{% if uses_promotion_aside %} nether-cta__inner--promotion{% endif %}">
    {%- if uses_section_media -%}
      {%- render 'nether-hero-media', section: section, adapter: 'cta' -%}

      {%- if section.settings.nether_enable_image_overlay or enable_gradient -%}
        <div class="{{ overlay_classes }}" data-nether-hero-overlay data-nether-cta-overlay aria-hidden="true"></div>
      {%- endif -%}
    {%- endif -%}

    {%- if uses_hero_shell -%}
      {%- render 'nether-cta-content', section: section, heading_tag: heading_tag -%}
    {%- else -%}
      <div class="nether-cta__body page-width" data-nether-cta-content data-nether-hero-content>
        <div class="nether-cta__blocks nether-hero__blocks nether-hero__blocks--align-{{ section.settings.nether_content_alignment | default: 'center' }}">
          {%- for block in section.blocks -%}
            {%- render 'nether-cta-block',
              block: block,
              section: section,
              heading_tag: heading_tag
            -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if uses_promotion_aside -%}
      {%- render 'nether-cta-aside', section: section -%}
    {%- endif -%}
  </div>
</nether-cta>

{%- if section.settings.nether_show_divider_bottom -%}
  {%- render 'nether-cta-divider', section: section, position: 'bottom' -%}
{%- endif -%}

