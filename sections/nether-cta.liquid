            { "value": "h1", "label": "Medium" },
            { "value": "h0", "label": "Large" }
          ]
        }
      ]
    },
    {
      "type": "subheading",
      "name": "Subheading",
      "settings": [
        { "type": "inline_richtext", "id": "subheading", "label": "Subheading" },
        {
          "type": "select",
          "id": "subheading_size",
          "label": "Subheading size",
          "default": "h3",
          "options": [
