      "visible_if": "{{ section.settings.nether_content_layout != 'alternating_story' and section.settings.nether_content_layout != 'timeline' and section.settings.nether_content_layout != 'multi_column' and section.settings.nether_content_layout != 'feature_grid' }}"
    },
    {
      "type": "select",
      "id": "nether_content_alignment",
      "label": "t:nether.common.ui.layout.content_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:nether.common.ui.layout.left"
