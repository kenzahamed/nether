      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "t:nether.common.px",
      "label": "t:nether.common.ui.labels.grid_gap",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:sections.nether_content.settings.media_header.content"
    },
    {
      "type": "select",
      "id": "nether_content_media_type",
      "label": "t:nether.common.ui.media.media_type",
      "default": "image",
      "options": [
        {
          "value": "image",
          "label": "t:nether.common.ui.media.image"
        },
        {
          "value": "video",
          "label": "t:nether.common.ui.media.video"
        },
        {
          "value": "background_video",
          "label": "t:nether.common.ui.media.background_video"
        }
      ],
