  "settings": [
    {
      "type": "header",
      "content": "t:sections.nether_content.settings.framework_header.content"
    },
    {
      "type": "select",
      "id": "nether_content_layout",
      "label": "t:sections.nether_content.settings.nether_content_layout.label",
      "default": "editorial_story",
      "options": [
        {
          "value": "editorial_story",
          "label": "t:sections.nether_content.settings.nether_content_layout.options__1.label"
        },
        {
          "value": "image_with_text",
          "label": "t:nether.common.ui.labels.image_with_text"
        },
        {
          "value": "split_content",
          "label": "t:sections.nether_content.settings.nether_content_layout.options__3.label"
        },
        {
          "value": "alternating_story",
          "label": "t:sections.nether_content.settings.nether_content_layout.options__4.label"
        },
        {
          "value": "timeline",
          "label": "t:sections.nether_content.settings.nether_content_layout.options__5.label"
        },
        {
          "value": "multi_column",
          "label": "t:sections.nether_content.settings.nether_content_layout.options__6.label"
        },
        {
          "value": "feature_grid",
          "label": "t:sections.nether_content.settings.nether_content_layout.options__7.label"
        },
        {
          "value": "brand_story",
          "label": "t:nether.common.ui.labels.brand_story"
        },
        {
          "value": "magazine",
          "label": "t:nether.common.ui.labels.magazine_layout"
        },
        {
          "value": "minimal",
          "label": "t:sections.nether_content.settings.nether_content_layout.options__10.label"
        }
      ],
      "info": "t:nether.common.info_layout"
    },
    {
      "type": "select",
      "id": "nether_content_width",
      "label": "t:nether.common.ui.layout.content_width",
      "default": "medium",
      "options": [
        {
          "value": "narrow",
          "label": "t:nether.common.ui.layout.narrow"
        },
        {
          "value": "medium",
          "label": "t:nether.common.ui.sizing.medium"
        },
        {
          "value": "wide",
          "label": "t:nether.common.ui.layout.wide"
        },
        {
          "value": "full",
          "label": "t:nether.common.ui.labels.full"
        }
      ],
      "visible_if": "{{ section.settings.nether_content_layout != 'alternating_story' and section.settings.nether_content_layout != 'timeline' and section.settings.nether_content_layout != 'multi_column' and section.settings.nether_content_layout != 'feature_grid' }}"
    },
    {
      "type": "select",
      "id": "nether_content_position",
      "label": "t:nether.common.ui.layout.content_position",
      "default": "middle-center",
      "options": [
        {
          "value": "top-left",
          "label": "t:nether.common.ui.layout.top_left_2"
        },
        {
          "value": "top-center",
          "label": "t:nether.common.ui.layout.top_center_2"
        },
        {
          "value": "top-right",
          "label": "t:nether.common.ui.layout.top_right_2"
        },
        {
          "value": "middle-left",
          "label": "t:nether.common.ui.layout.middle_left_2"
        },
        {
          "value": "middle-center",
          "label": "t:nether.common.ui.layout.middle_center_2"
        },
        {
          "value": "middle-right",
          "label": "t:nether.common.ui.layout.middle_right_2"
        },
        {
          "value": "bottom-left",
          "label": "t:nether.common.ui.layout.bottom_left_2"
        },
        {
          "value": "bottom-center",
          "label": "t:nether.common.ui.layout.bottom_center_2"
        },
        {
          "value": "bottom-right",
          "label": "t:nether.common.ui.layout.bottom_right_2"
        }
