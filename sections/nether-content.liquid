{{ 'component-hero.css' | asset_url | stylesheet_tag }}
{{ 'component-content.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-typography.css' | asset_url | stylesheet_tag }}
{{ 'component-card-premium.css' | asset_url | stylesheet_tag }}
{{ 'component-shadow.css' | asset_url | stylesheet_tag }}
{{ 'component-radius.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-hero.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-content.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.nether_content_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_content_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign nether_content_layout = section.settings.nether_content_layout | default: 'editorial_story'
  assign nether_content_width = section.settings.nether_content_width | default: 'medium'
  assign nether_content_position = section.settings.nether_content_position | default: 'middle-center'
  capture nether_content_position
    render 'nether-position-value', position: nether_content_position, default: 'middle-center'
  endcapture
  assign nether_content_position = nether_content_position | strip

  assign uses_hero_shell = false
  assign uses_row_layout = false
  assign uses_section_media = false

  case nether_content_layout
    when 'editorial_story', 'image_with_text', 'split_content', 'brand_story', 'magazine'
      assign uses_hero_shell = true
      assign uses_section_media = true
    when 'minimal'
      assign uses_hero_shell = true
    when 'alternating_story', 'timeline', 'multi_column', 'feature_grid'
      assign uses_row_layout = true
  endcase

  case nether_content_layout
    when 'editorial_story', 'magazine'
      assign nether_hero_layout = 'editorial'
    when 'image_with_text', 'split_content', 'brand_story'
      assign nether_hero_layout = 'split'
    when 'minimal'
      assign nether_hero_layout = 'minimal'
    else
      assign nether_hero_layout = 'classic'
  endcase

  case section.settings.nether_content_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign nether_class_list = 'nether-content nether-hero'
  assign nether_class_list = nether_class_list | append: ' nether-content--layout-' | append: nether_content_layout
  assign nether_class_list = nether_class_list | append: ' nether-hero--layout-' | append: nether_hero_layout
  if uses_hero_shell
    assign nether_class_list = nether_class_list | append: ' nether-hero--width-' | append: nether_content_width
    assign nether_class_list = nether_class_list | append: ' nether-hero--position-' | append: nether_content_position
  endif
  assign nether_class_list = nether_class_list | append: ' nether-hero--desktop-' | append: section.settings.nether_content_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-hero--tablet-' | append: section.settings.nether_content_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-hero--mobile-' | append: section.settings.nether_content_layout_mobile

  if uses_row_layout
    assign nether_class_list = nether_class_list | append: ' nether-content--stacked'
  endif

  if section.settings.nether_content_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-hero--glass-enabled nether-content--glass-enabled'
  endif

  if section.settings.nether_content_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-hero--gradient-enabled'
  endif

  if section.settings.nether_content_media_position == 'right'
    assign nether_class_list = nether_class_list | append: ' nether-hero--split-media-right'
  endif

  if section.settings.nether_content_enable_floating_card
    assign nether_class_list = nether_class_list | append: ' nether-content--floating-card'
  endif

  assign overlay_classes = 'nether-hero__overlay'
  if section.settings.nether_content_enable_gradient
    case section.settings.nether_content_gradient_style
      when 'dramatic'
        assign overlay_classes = overlay_classes | append: ' grad-hero-dramatic'
      when 'vignette'
        assign overlay_classes = overlay_classes | append: ' grad-hero-vignette'
      when 'fade-down'
        assign overlay_classes = overlay_classes | append: ' grad-linear-fade-down'
      else
        assign overlay_classes = overlay_classes | append: ' grad-hero-brand'
    endcase
  endif

  assign heading_tag = 'h2'
  if section.settings.nether_content_heading_level == 'h3'
    assign heading_tag = 'h3'
  endif

  assign needs_deferred_media = false
  if section.settings.nether_content_media_type == 'video'
    assign needs_deferred_media = true
  endif
  for block in section.blocks
    if block.type == 'video' or block.settings.media_type == 'video'
      assign needs_deferred_media = true
      break
    endif
  endfor
-%}

{%- if needs_deferred_media -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-content {
    --nether-hero-overlay-opacity: {{ section.settings.nether_content_overlay_opacity | divided_by: 100.0 }};
    --nether-hero-transition-duration: {{ nether_animation_duration }}s;
    --nether-content-columns-desktop: {{ section.settings.nether_content_columns_desktop }};
    --nether-content-columns-tablet: {{ section.settings.nether_content_columns_tablet }};
    --nether-content-columns-mobile: {{ section.settings.nether_content_columns_mobile }};
    --nether-content-row-gap: {{ section.settings.nether_content_gap }}px;
    --nether-content-gap: {{ section.settings.nether_content_gap | plus: 8 }}px;
  }

  {% render 'nether-section-padding', section: section %}

{%- endstyle -%}

{%- if section.settings.nether_content_show_divider_top -%}
  {%- render 'nether-content-divider', section: section, position: 'top' -%}
{%- endif -%}

<nether-content
  id="NetherContent-{{ section.id }}"
  class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-nether-motion="content"
  data-nether-hero-layout="{{ nether_hero_layout }}"
  data-content-layout="{{ nether_content_layout }}"
  {% if section.settings.nether_content_enable_parallax or section.settings.nether_content_animation_style == 'timeline_reveal' or uses_row_layout %}data-nether-motion-plugins="scrollTrigger"{% endif %}
  data-animation-style="{{ section.settings.nether_content_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-enable-parallax="{{ section.settings.nether_content_enable_parallax }}"
  role="region"
  aria-label="{% render 'nether-locale-text', value: section.settings.nether_content_aria_label, key: 'sections.nether_content.aria_label' %}"
>
  <div class="nether-hero__inner nether-content__inner">
    {%- if uses_section_media -%}
      {%- render 'nether-hero-media', section: section, adapter: 'content' -%}

      {%- if section.settings.nether_content_enable_image_overlay or section.settings.nether_content_enable_gradient -%}
        <div class="{{ overlay_classes }}" data-nether-hero-overlay aria-hidden="true"></div>
      {%- endif -%}
    {%- endif -%}

    {%- if uses_hero_shell -%}
      {%- render 'nether-content-shell', section: section, heading_tag: heading_tag -%}
    {%- elsif uses_row_layout -%}
      {%- render 'nether-content-grid', section: section, heading_tag: heading_tag -%}
    {%- endif -%}
  </div>
</nether-content>

{%- if section.settings.nether_content_show_divider_bottom -%}
  {%- render 'nether-content-divider', section: section, position: 'bottom' -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.nether_content.name",
  "tag": "section",
  "class": "section section-nether-content",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
