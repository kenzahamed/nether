      "info": "t:nether.common.info_image_fields"
    },
    {
      "type": "image_picker",
      "id": "nether_content_image_mobile",
      "label": "t:nether.common.ui.media.mobile_image",
      "info": "t:sections.nether_content.settings.nether_content_image_mobile.info",
