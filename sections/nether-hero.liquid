{{ 'component-hero.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-typography.css' | asset_url | stylesheet_tag }}
{{ 'component-card-premium.css' | asset_url | stylesheet_tag }}
{{ 'component-shadow.css' | asset_url | stylesheet_tag }}
{{ 'component-radius.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-hero.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_media_type == 'video' -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign nether_hero_layout = section.settings.nether_hero_layout | default: 'classic'
  assign nether_hero_height = section.settings.nether_hero_height | default: 'medium'
  assign nether_content_width = section.settings.nether_content_width | default: 'medium'
  assign nether_content_position = section.settings.nether_content_position | default: 'middle-center'

  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign nether_class_list = 'nether-hero'
  assign nether_class_list = nether_class_list | append: ' nether-hero--layout-' | append: nether_hero_layout
  assign nether_class_list = nether_class_list | append: ' nether-hero--height-' | append: nether_hero_height
  assign nether_class_list = nether_class_list | append: ' nether-hero--width-' | append: nether_content_width
  assign nether_class_list = nether_class_list | append: ' nether-hero--position-' | append: nether_content_position
  assign nether_class_list = nether_class_list | append: ' nether-hero--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-hero--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-hero--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-hero--glass-enabled'
  endif

  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-hero--gradient-enabled'
  endif

  if section.settings.nether_split_media_position == 'right'
    assign nether_class_list = nether_class_list | append: ' nether-hero--split-media-right'
  endif

  assign overlay_classes = 'nether-hero__overlay'
  if section.settings.nether_enable_gradient
    case section.settings.nether_gradient_style
      when 'dramatic'
        assign overlay_classes = overlay_classes | append: ' grad-hero-dramatic'
      when 'vignette'
        assign overlay_classes = overlay_classes | append: ' grad-hero-vignette'
      when 'fade-down'
        assign overlay_classes = overlay_classes | append: ' grad-linear-fade-down'
      else
        assign overlay_classes = overlay_classes | append: ' grad-hero-brand'
    endcase
  endif

  assign heading_tag = 'h1'
  if section.settings.nether_heading_level == 'h2'
    assign heading_tag = 'h2'
  endif

  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-hero {
    --nether-hero-overlay-opacity: {{ section.settings.nether_overlay_opacity | divided_by: 100.0 }};
    --nether-hero-transition-duration: {{ nether_animation_duration }}s;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if nether_hero_height == 'adapt' and section.settings.nether_image_desktop != blank -%}
    #NetherHero-{{ section.id }} .nether-hero__media::before {
      padding-bottom: {{ 1 | divided_by: section.settings.nether_image_desktop.aspect_ratio | times: 100 }}%;
      content: '';
      display: block;
    }
  {%- endif -%}
{%- endstyle -%}

<nether-hero
  id="NetherHero-{{ section.id }}"
  class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-nether-motion="hero"
  data-nether-hero-layout="{{ nether_hero_layout }}"
  {% if section.settings.nether_enable_parallax %}data-nether-motion-plugins="scrollTrigger"{% endif %}
  data-animation-style="{{ section.settings.nether_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-enable-parallax="{{ section.settings.nether_enable_parallax }}"
  data-enable-scroll-indicator="{{ section.settings.nether_show_scroll_indicator }}"
  role="region"
  aria-label="{% render 'nether-locale-text', value: section.settings.nether_aria_label, key: 'sections.nether_hero.aria_label' %}"
>
  <div class="nether-hero__inner">
    {%- render 'nether-hero-media', section: section, fetch_priority: fetch_priority -%}

    {%- if section.settings.nether_enable_image_overlay or section.settings.nether_enable_gradient -%}
      <div class="{{ overlay_classes }}" data-nether-hero-overlay aria-hidden="true"></div>
    {%- endif -%}

    {%- if section.settings.nether_show_decorative_shapes -%}
      <div class="nether-hero__shapes" data-nether-hero-decor aria-hidden="true">
        <span class="nether-hero__shape nether-hero__shape--one"></span>
        <span class="nether-hero__shape nether-hero__shape--two"></span>
        <span class="nether-hero__shape nether-hero__shape--three"></span>
      </div>
    {%- endif -%}

    {%- render 'nether-hero-content', section: section, heading_tag: heading_tag -%}

    {%- render 'nether-hero-scroll-indicator', section: section -%}
  </div>
</nether-hero>

