<script src="{{ 'component-faq.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign nether_layout = section.settings.nether_layout | default: 'classic_accordion'
  assign nether_columns_desktop = section.settings.nether_columns_desktop | default: 2
  assign nether_columns_tablet = section.settings.nether_columns_tablet | default: 2
  assign nether_columns_mobile = section.settings.nether_columns_mobile | default: 1
  assign nether_gap = section.settings.nether_gap | default: 24

  assign uses_hero_shell = false
  assign uses_section_media = false
  assign is_magazine = false

  case nether_layout
    when 'editorial_faq'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign nether_hero_layout = 'editorial'
    when 'minimal_faq'
      assign uses_hero_shell = true
      assign nether_hero_layout = 'minimal'
    when 'magazine'
      assign is_magazine = true
  endcase

  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign nether_class_list = 'nether-faq nether-hero'
  assign nether_class_list = nether_class_list | append: ' nether-faq--layout-' | append: nether_layout
  if uses_hero_shell
    assign nether_class_list = nether_class_list | append: ' nether-hero--layout-' | append: nether_hero_layout
  endif
  assign nether_class_list = nether_class_list | append: ' nether-faq--card-' | append: section.settings.nether_card_style
  assign nether_class_list = nether_class_list | append: ' nether-hero--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-hero--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-hero--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-hero--glass-enabled nether-faq--glass-enabled'
  endif

  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-hero--gradient-enabled'
  endif

  if section.settings.nether_enable_floating_cards
    assign nether_class_list = nether_class_list | append: ' nether-faq--floating-enabled'
  endif

  if section.settings.nether_full_width
    assign nether_class_list = nether_class_list | append: ' nether-faq--full-width'
  endif

  case section.settings.nether_layout_mobile
    when 'stacked'
      assign nether_class_list = nether_class_list | append: ' nether-faq--mobile-stacked'
    when 'centered'
      assign nether_class_list = nether_class_list | append: ' nether-faq--mobile-centered'
    when 'minimal'
      assign nether_class_list = nether_class_list | append: ' nether-faq--mobile-minimal'
  endcase

  assign overlay_classes = 'nether-hero__overlay'
  if section.settings.nether_enable_gradient
    case section.settings.nether_gradient_style
      when 'dramatic'
        assign overlay_classes = overlay_classes | append: ' grad-hero-dramatic'
      when 'vignette'
        assign overlay_classes = overlay_classes | append: ' grad-hero-vignette'
      when 'fade-down'
        assign overlay_classes = overlay_classes | append: ' grad-linear-fade-down'
      else
        assign overlay_classes = overlay_classes | append: ' grad-hero-brand'
    endcase
  endif

  assign heading_tag = 'h2'
  if section.settings.nether_heading_level == 'h3'
    assign heading_tag = 'h3'
  endif

  assign needs_deferred_media = false
  if section.settings.nether_faq_media_type == 'video'
    assign needs_deferred_media = true
  endif
  for block in section.blocks
    if block.type == 'video'
      assign needs_deferred_media = true
      break
    endif
  endfor
-%}

{%- if needs_deferred_media -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-faq {
    --nether-faq-gap: {{ nether_gap }}px;
    --nether-faq-columns-desktop: {{ nether_columns_desktop }};
    --nether-faq-columns-tablet: {{ nether_columns_tablet }};
    --nether-faq-columns-mobile: {{ nether_columns_mobile }};
    --nether-faq-overlay-opacity: {{ section.settings.nether_overlay_opacity | divided_by: 100.0 }};
    --nether-faq-transition-duration: {{ nether_animation_duration }}s;
  }

  {% render 'nether-section-padding', section: section %}

{%- endstyle -%}

{%- if section.settings.nether_show_divider_top -%}
  {%- render 'nether-faq-divider', section: section, position: 'top' -%}
{%- endif -%}

<nether-faq
  id="NetherFaq-{{ section.id }}"
  class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-nether-motion="faq"
  data-faq-layout="{{ nether_layout }}"
  data-nether-faq-card-style="{{ section.settings.nether_card_style }}"
  {% if section.settings.nether_enable_parallax or nether_layout == 'editorial_faq' or nether_layout == 'magazine' or nether_layout == 'categorized_faq' or nether_layout == 'help_center' or nether_layout == 'support_center' or nether_layout == 'knowledge_base' or section.settings.nether_animation_style == 'stagger' or section.settings.nether_animation_style == 'accordion_reveal' or section.settings.nether_animation_style == 'category_reveal' %}data-nether-motion-plugins="scrollTrigger"{% endif %}
  data-animation-style="{{ section.settings.nether_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-enable-parallax="{{ section.settings.nether_enable_parallax }}"
  data-expand-all="{{ section.settings.nether_expand_all }}"
  data-search-result-singular="{{ 'sections.nether_faq.search.result_singular' | t | escape }}"
  data-search-result-plural="{{ 'sections.nether_faq.search.result_plural' | t | escape }}"
  role="region"
  aria-label="{% render 'nether-locale-text', value: section.settings.nether_aria_label, key: 'sections.nether_faq.aria_label' %}"
>
  <div class="nether-faq__inner nether-hero__inner">
    {%- if uses_section_media -%}
      {%- render 'nether-hero-media', section: section, adapter: 'faq' -%}

      {%- if section.settings.nether_enable_image_overlay or section.settings.nether_enable_gradient -%}
        <div class="{{ overlay_classes }}" aria-hidden="true" data-nether-faq-overlay></div>
      {%- endif -%}
    {%- endif -%}

    {%- if uses_hero_shell -%}
      {%- render 'nether-faq-shell', section: section, heading_tag: heading_tag -%}
    {%- else -%}
      <div class="{% render 'nether-layout-container-class', full_width: section.settings.nether_full_width, class: 'nether-faq__body-wrap' %}">
        {%- render 'nether-faq-content', section: section, heading_tag: heading_tag -%}

        {%- render 'nether-faq-search', section: section -%}

        {%- if section.settings.nether_show_expand_controls -%}
          <div class="nether-faq__controls" data-nether-faq-controls>
            <button type="button" class="nether-faq__control link" data-nether-faq-expand-all>
              {{- 'sections.nether_faq.controls.expand_all' | t -}}
            </button>
            <span class="nether-faq__control-separator" aria-hidden="true">·</span>
            <button type="button" class="nether-faq__control link" data-nether-faq-collapse-all>
              {{- 'sections.nether_faq.controls.collapse_all' | t -}}
            </button>
          </div>
        {%- endif -%}

        {%- render 'nether-faq-list', section: section, layout: nether_layout, is_magazine: is_magazine, heading_tag: heading_tag -%}
      </div>
    {%- endif -%}
  </div>
</nether-faq>

{%- if section.settings.nether_show_divider_bottom -%}
  {%- render 'nether-faq-divider', section: section, position: 'bottom' -%}
{%- endif -%}

