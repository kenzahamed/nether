      ]
    },
    {
      "type": "image_picker",
      "id": "nether_faq_image_desktop",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "nether_faq_image_mobile",
      "label": "Mobile image"
    },
