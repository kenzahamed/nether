        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>We offer a 30-day return policy on most items. Contact support for details.</p>" },
        { "type": "page", "id": "page", "label": "Page content" },
        { "type": "text", "id": "category_slug", "label": "Category slug", "info": "Match a category block slug for navigation filtering." },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "question_mark",
          "options": [
            { "value": "none", "label": "None" },
