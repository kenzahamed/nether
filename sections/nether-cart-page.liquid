{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-typography.css' | asset_url | stylesheet_tag }}
{{ 'component-shadow.css' | asset_url | stylesheet_tag }}
{{ 'component-radius.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-framework.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{% render 'nether-commerce-assets' %}

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-cart-framework.js' | asset_url }}" defer="defer"></script>

{%- liquid
  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign nether_class_list = 'nether-cart-page'
  assign nether_class_list = nether_class_list | append: ' nether-cart-page--layout-' | append: section.settings.nether_layout
  assign nether_class_list = nether_class_list | append: ' nether-cart-page--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-cart-page--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-cart-page--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_enable_sticky_summary
    assign nether_class_list = nether_class_list | append: ' nether-cart-page--sticky-enabled'
  endif

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-cart-page--glass-enabled'
  endif

  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-cart-page--gradient-enabled'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .nether-cart-page {
    --nether-cart-gap: {{ section.settings.nether_content_gap }}px;
    --nether-cart-module-gap: {{ section.settings.nether_module_gap }}px;
    --nether-cart-transition-duration: {{ nether_animation_duration }}s;
  }
{%- endstyle -%}

<nether-cart-page
  class="{{ nether_class_list }} section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-nether-motion="cart-page"
  data-section-id="{{ section.id }}"
  data-animation-style="{{ section.settings.nether_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-enable-sticky="{{ section.settings.nether_enable_sticky_summary }}"
  data-cart-layout="{{ section.settings.nether_layout }}"
>
  <div class="page-width">
    {% render 'nether-cart-divider', section: section, position: 'top' %}
    {% render 'nether-cart-header', section: section %}

    <div class="nether-cart-page__layout">
      <div class="nether-cart-page__main">
        {% render 'nether-cart-items', section: section %}

        {%- for block in section.blocks -%}
          {%- liquid
            assign footer_block = false
            if block.type == 'merchant_content' or block.type == 'recommendations'
              assign footer_block = true
            endif
            if block.type contains 'placeholder' and block.type != 'analytics_placeholder'
              assign footer_block = true
            endif
          -%}
          {%- if footer_block -%}
            {% render 'nether-cart-block', block: block, section: section, zone: 'footer' %}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {% render 'nether-cart-summary', section: section %}
    </div>

    {% render 'nether-cart-divider', section: section, position: 'bottom' %}
  </div>
</nether-cart-page>

