          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "nether_show_secondary_image",
      "label": "t:sections.nether_bundles.settings.nether_show_secondary_image.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "nether_show_vendor",
      "label": "t:nether.common.ui.labels.show_vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "nether_show_rating",
      "label": "t:nether.common.ui.commerce.show_rating",
      "default": false
    },
    {
