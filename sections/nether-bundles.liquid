{% comment %}
  Nether Premium Bundles & Product Packs Commerce Framework — section orchestrator.
  Extends product cards, recommendations complementary intent, and Shopify Cart AJAX.
  Does not replace product-form, product-info, variants, cart drawer, or checkout.
{% endcomment %}

{% render 'nether-bundles-assets' %}

{%- if section.settings.nether_enable_wishlist_cards -%}
  {% render 'nether-wishlist-assets' %}
{%- endif -%}
{%- if section.settings.nether_enable_compare_cards -%}
  {% render 'nether-compare-assets' %}
{%- endif -%}
{%- if section.settings.nether_enable_quick_view_cards -%}
  {% render 'nether-quick-view-assets' %}
{%- endif -%}

{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-typography.css' | asset_url | stylesheet_tag }}
{{ 'component-shadow.css' | asset_url | stylesheet_tag }}
{{ 'component-radius.css' | asset_url | stylesheet_tag }}

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if section.settings.nether_image_shape == 'blob' -%}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign strategy = section.settings.nether_strategy | default: 'curated'
  assign layout = section.settings.nether_layout | default: 'split'
  assign products_limit = section.settings.nether_products_to_show | default: 4
  assign gap = section.settings.nether_gap | default: 24

  assign uses_api = false
  if strategy == 'frequently_bought' or strategy == 'complete_the_look'
    assign uses_api = true
  endif

  assign uses_collection = false
  if strategy == 'mix_match' and section.settings.collection != blank
    assign uses_collection = true
  endif

  assign is_future_strategy = false
  if strategy == 'build_your_own' or strategy == 'subscription' or strategy == 'ai' or strategy == 'dynamic_merchandising'
    assign is_future_strategy = true
  endif

  assign use_product_blocks = false
  for block in section.blocks
    if block.type == 'bundle_product' and block.settings.product != blank
      assign use_product_blocks = true
      break
    endif
  endfor

  assign seed_product = section.settings.product
  if seed_product == blank and product != blank
    assign seed_product = product
  endif

  assign include_product = nil
  if section.settings.nether_include_current_product and seed_product != blank
    assign include_product = seed_product
  endif

  assign source_products = section.settings.product_list
  if uses_collection
    assign source_products = section.settings.collection.products
  endif

  assign seed_product_id = blank
  if seed_product != blank
    assign seed_product_id = seed_product.id
  endif

  assign recommendation_url = routes.product_recommendations_url | append: '?limit=' | append: products_limit | append: '&intent=complementary'

  case strategy
    when 'frequently_bought'
      assign strategy_label = 'sections.nether_bundles.strategies.frequently_bought' | t
    when 'complete_the_look'
      assign strategy_label = 'sections.nether_bundles.strategies.complete_the_look' | t
    when 'product_pack'
      assign strategy_label = 'sections.nether_bundles.strategies.product_pack' | t
    when 'volume_discount'
      assign strategy_label = 'sections.nether_bundles.strategies.volume_discount' | t
    when 'mix_match'
      assign strategy_label = 'sections.nether_bundles.strategies.mix_match' | t
    when 'curated'
      assign strategy_label = 'sections.nether_bundles.strategies.curated' | t
    when 'gift_set'
      assign strategy_label = 'sections.nether_bundles.strategies.gift_set' | t
    when 'build_your_own'
      assign strategy_label = 'sections.nether_bundles.strategies.build_your_own' | t
    when 'subscription'
      assign strategy_label = 'sections.nether_bundles.strategies.subscription' | t
    when 'ai'
      assign strategy_label = 'sections.nether_bundles.strategies.ai' | t
    when 'dynamic_merchandising'
      assign strategy_label = 'sections.nether_bundles.strategies.dynamic_merchandising' | t
    else
      assign strategy_label = 'sections.nether_bundles.strategies.generic' | t
  endcase

  assign nether_class_list = 'nether-bundles'
  assign nether_class_list = nether_class_list | append: ' nether-bundles--layout-' | append: layout
  assign nether_class_list = nether_class_list | append: ' nether-bundles--strategy-' | append: strategy
  assign nether_class_list = nether_class_list | append: ' nether-bundles--pricing-' | append: section.settings.nether_pricing_style
  assign nether_class_list = nether_class_list | append: ' nether-bundles--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-bundles--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-bundles--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-bundles--glass-enabled'
  endif
  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-bundles--gradient-enabled'
  endif
  if section.settings.nether_full_width
    assign nether_class_list = nether_class_list | append: ' nether-bundles--full-width'
  endif
-%}

{%- style -%}
  {% render 'nether-section-padding', section: section %}

  #shopify-section-{{ section.id }} .nether-bundles {
    --nether-bundles-gap: {{ gap }}px;
    --nether-bundles-columns-desktop: {{ section.settings.nether_columns_desktop | default: 3 }};
    --nether-bundles-columns-tablet: {{ section.settings.nether_columns_tablet | default: 2 }};
    --nether-bundles-columns-mobile: {{ section.settings.nether_columns_mobile | default: 1 }};
    --nether-bundles-transition-duration: {{ nether_animation_duration }}s;
  }
{%- endstyle -%}

{%- liquid
  assign count_label = 'sections.nether_bundles.summary.count' | t: count: '__COUNT__' | replace: '__COUNT__', '{{ count }}'
-%}

{%- if uses_api -%}
  <product-recommendations
    class="nether-bundles__api complementary-products"
    data-url="{{ recommendation_url }}"
    data-section-id="{{ section.id }}"
    {% if seed_product_id != blank %}data-product-id="{{ seed_product_id }}"{% endif %}
  >
    <nether-bundles
      id="NetherBundles-{{ section.id }}"
      class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
      data-nether-motion="bundles"
      data-section-id="{{ section.id }}"
      data-animation-style="{{ section.settings.nether_animation_style }}"
      data-animation-duration="{{ nether_animation_duration }}"
      data-nether-motion-plugins="scrollTrigger"
      data-bundle-strategy="{{ strategy }}"
      data-layout="{{ layout }}"
      data-money-format="{{ shop.money_format | escape }}"
      data-currency-code="{{ cart.currency.iso_code }}"
      data-display-discount-percent="{{ section.settings.nether_display_discount_percent | default: 0 }}"
      data-include-properties="true"
      data-count-label="{{ count_label | escape }}"
      data-success-message="{{ 'sections.nether_bundles.actions.success' | t | escape }}"
      data-error-empty="{{ 'sections.nether_bundles.errors.empty' | t | escape }}"
      data-error-generic="{{ 'sections.nether_bundles.errors.generic' | t | escape }}"
      role="region"
      aria-label="{{ section.settings.nether_aria_label | default: strategy_label | escape }}"
    >
      <div class="{% render 'nether-layout-container-class', full_width: section.settings.nether_full_width, class: 'nether-bundles__inner' %}">
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          {% render 'nether-bundles-body',
            section: section,
            products: recommendations.products,
            products_limit: products_limit,
            product_count: recommendations.products_count,
            strategy: strategy,
            strategy_label: strategy_label,
            include_product: include_product
          %}
        {%- elsif request.design_mode -%}
          {% render 'nether-bundles-body',
            section: section,
            products: nil,
            strategy: strategy,
            strategy_label: strategy_label,
            show_empty: true,
            empty_context: 'design'
          %}
        {%- else -%}
          {% render 'nether-bundles-body',
            section: section,
            products: nil,
            strategy: strategy,
            strategy_label: strategy_label,
            show_empty: true,
            empty_context: 'api'
          %}
        {%- endif -%}
      </div>
    </nether-bundles>
  </product-recommendations>

{%- elsif is_future_strategy -%}
  <nether-bundles
    id="NetherBundles-{{ section.id }}"
    class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
    data-nether-motion="bundles"
    data-section-id="{{ section.id }}"
    data-animation-style="{{ section.settings.nether_animation_style }}"
    data-animation-duration="{{ nether_animation_duration }}"
    data-nether-motion-plugins="scrollTrigger"
    data-bundle-strategy="{{ strategy }}"
    data-layout="{{ layout }}"
    role="region"
    aria-label="{{ section.settings.nether_aria_label | default: strategy_label | escape }}"
  >
    <div class="{% render 'nether-layout-container-class', full_width: section.settings.nether_full_width, class: 'nether-bundles__inner' %}">
      {% render 'nether-bundles-header', section: section, strategy_label: strategy_label %}
      {% render 'nether-bundles-extensions', type: strategy, section: section %}
      {%- for block in section.blocks -%}
        {% render 'nether-bundles-block', block: block, section: section %}
      {%- endfor -%}
    </div>
  </nether-bundles>

{%- else -%}
  <nether-bundles
    id="NetherBundles-{{ section.id }}"
    class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
    data-nether-motion="bundles"
    data-section-id="{{ section.id }}"
    data-animation-style="{{ section.settings.nether_animation_style }}"
    data-animation-duration="{{ nether_animation_duration }}"
    data-nether-motion-plugins="scrollTrigger"
    data-bundle-strategy="{{ strategy }}"
    data-layout="{{ layout }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-currency-code="{{ cart.currency.iso_code }}"
    data-display-discount-percent="{{ section.settings.nether_display_discount_percent | default: 0 }}"
    data-include-properties="true"
    data-count-label="{{ count_label | escape }}"
    data-success-message="{{ 'sections.nether_bundles.actions.success' | t | escape }}"
    data-error-empty="{{ 'sections.nether_bundles.errors.empty' | t | escape }}"
    data-error-generic="{{ 'sections.nether_bundles.errors.generic' | t | escape }}"
    role="region"
    aria-label="{{ section.settings.nether_aria_label | default: strategy_label | escape }}"
  >
    <div class="{% render 'nether-layout-container-class', full_width: section.settings.nether_full_width, class: 'nether-bundles__inner' %}">
      {% render 'nether-bundles-body',
        section: section,
        products: source_products,
        products_limit: products_limit,
        strategy: strategy,
        strategy_label: strategy_label,
        include_product: include_product,
        use_product_blocks: use_product_blocks
      %}
    </div>
  </nether-bundles>
{%- endif -%}

{%- if section.settings.nether_image_shape == 'arch' -%}
  {{ 'mask-arch.svg' | inline_asset_content }}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.nether_bundles.name",
  "tag": "section",
  "class": "section section-nether-bundles",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.nether_bundles.settings.paragraph.content"
    },
    {
      "type": "header",
      "content": "t:sections.nether_bundles.settings.framework.content"
    },
    {
      "type": "select",
      "id": "nether_strategy",
      "label": "t:nether.common.ui.labels.bundle_strategy",
      "info": "t:sections.nether_bundles.settings.nether_strategy.info",
      "default": "curated",
      "options": [
        {
          "value": "frequently_bought",
          "label": "t:nether.common.ui.labels.frequently_bought_together"
        },
        {
          "value": "complete_the_look",
          "label": "t:nether.common.ui.labels.complete_the_look"
        },
        {
          "value": "product_pack",
          "label": "t:nether.common.ui.labels.product_pack"
        },
        {
          "value": "volume_discount",
          "label": "t:nether.common.ui.labels.volume_discount"
        },
        {
          "value": "mix_match",
          "label": "t:nether.common.ui.labels.mix_match"
        },
        {
          "value": "curated",
          "label": "t:nether.common.ui.labels.curated_bundle"
        },
        {
          "value": "gift_set",
          "label": "t:nether.common.ui.labels.gift_set"
        },
        {
          "value": "build_your_own",
          "label": "t:sections.nether_bundles.settings.nether_strategy.options__8.label"
        },
        {
          "value": "subscription",
          "label": "t:sections.nether_bundles.settings.nether_strategy.options__9.label"
        },
        {
          "value": "ai",
          "label": "t:sections.nether_bundles.settings.nether_strategy.options__10.label"
        },
        {
          "value": "dynamic_merchandising",
          "label": "t:sections.nether_bundles.settings.nether_strategy.options__11.label"
        }
      ]
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:nether.common.ui.labels.seed_product",
      "info": "t:sections.nether_bundles.settings.product.info"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "t:nether.common.ui.labels.bundle_products",
      "info": "t:sections.nether_bundles.settings.product_list.info",
      "limit": 12
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:nether.common.ui.commerce.collection",
      "info": "t:sections.nether_bundles.settings.collection.info"
    },
    {
      "type": "checkbox",
      "id": "nether_include_current_product",
      "label": "t:sections.nether_bundles.settings.nether_include_current_product.label",
      "default": true
    },
    {
      "type": "range",
      "id": "nether_products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:nether.common.ui.labels.products_to_show"
    },
    {
      "type": "select",
      "id": "nether_layout",
      "label": "t:nether.common.ui.layout.layout",
      "default": "split",
      "options": [
        {
          "value": "split",
          "label": "t:sections.nether_bundles.settings.nether_layout.options__1.label"
        },
        {
          "value": "stacked",
          "label": "t:nether.common.ui.layout.stacked"
        },
        {
          "value": "compact",
          "label": "t:nether.common.ui.sizing.compact"
        }
      ],
      "info": "t:nether.common.info_layout"
    },
    {
      "type": "range",
      "id": "nether_columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:nether.common.ui.layout.desktop_columns"
    },
    {
      "type": "range",
      "id": "nether_columns_tablet",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "label": "t:nether.common.ui.layout.tablet_columns"
    },
    {
      "type": "select",
      "id": "nether_columns_mobile",
      "label": "t:nether.common.ui.layout.mobile_columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "t:sections.nether_bundles.settings.nether_columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.nether_bundles.settings.nether_columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "nether_gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "t:nether.common.px",
      "default": 24,
      "label": "t:sections.nether_bundles.settings.nether_gap.label"
    },
    {
      "type": "checkbox",
      "id": "nether_full_width",
      "label": "t:nether.common.ui.layout.full_width",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.nether_bundles.settings.content.content"
    },
    {
      "type": "text",
      "id": "nether_eyebrow",
      "label": "t:nether.common.ui.typography.eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "nether_heading",
      "label": "t:nether.common.ui.typography.heading",
      "default": "Complete the set"
    },
    {
      "type": "text",
      "id": "nether_subheading",
      "label": "t:nether.common.ui.typography.subheading"
    },
    {
      "type": "select",
      "id": "nether_heading_level",
      "label": "t:nether.common.ui.labels.heading_level",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        }
      ],
      "info": "t:nether.common.info_heading_level"
    },
    {
      "type": "checkbox",
      "id": "nether_show_strategy_badge",
      "label": "t:nether.common.ui.labels.show_strategy_badge",
      "default": false
    },
    {
      "type": "text",
      "id": "nether_card_badge_label",
      "label": "t:sections.nether_bundles.settings.nether_card_badge_label.label"
    },
    {
      "type": "text",
      "id": "nether_aria_label",
      "label": "t:nether.common.ui.content.accessibility_label",
      "info": "t:nether.common.info_aria_label"
    },
    {
      "type": "header",
      "content": "t:sections.nether_bundles.settings.pricing.content"
    },
    {
      "type": "select",
      "id": "nether_pricing_style",
      "label": "t:sections.nether_bundles.settings.nether_pricing_style.label",
      "default": "stacked",
      "options": [
        {
          "value": "stacked",
          "label": "t:nether.common.ui.layout.stacked"
        },
        {
          "value": "inline",
          "label": "t:nether.common.ui.layout.inline"
        },
        {
          "value": "minimal",
          "label": "t:nether.common.ui.states.minimal"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "nether_show_savings",
      "label": "t:sections.nether_bundles.settings.nether_show_savings.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "nether_show_savings_badge",
      "label": "t:sections.nether_bundles.settings.nether_show_savings_badge.label",
      "default": true
    },
    {
      "type": "range",
      "id": "nether_display_discount_percent",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 0,
      "label": "t:sections.nether_bundles.settings.nether_display_discount_percent.label",
      "info": "t:sections.nether_bundles.settings.nether_display_discount_percent.info"
    },
    {
      "type": "checkbox",
      "id": "nether_show_summary",
      "label": "t:sections.nether_bundles.settings.nether_show_summary.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "nether_show_bundle_notes",
      "label": "t:sections.nether_bundles.settings.nether_show_bundle_notes.label",
      "default": false
    },
    {
      "type": "text",
      "id": "nether_add_label",
      "label": "t:sections.nether_bundles.settings.nether_add_label.label",
      "default": "Add bundle to cart"
    },
    {
      "type": "checkbox",
      "id": "nether_enable_drawer",
      "label": "t:sections.nether_bundles.settings.nether_enable_drawer.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.nether_bundles.settings.pack.content"
    },
    {
      "type": "checkbox",
      "id": "nether_allow_optional",
      "label": "t:sections.nether_bundles.settings.nether_allow_optional.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "nether_show_variant_select",
      "label": "t:sections.nether_bundles.settings.nether_show_variant_select.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "nether_show_item_quantity",
      "label": "t:sections.nether_bundles.settings.nether_show_item_quantity.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.nether_bundles.settings.cards.content"
    },
    {
      "type": "select",
      "id": "nether_image_ratio",
      "label": "t:nether.common.ui.media.image_ratio",
      "default": "adapt",
      "options": [
        {
          "value": "adapt",
          "label": "t:nether.common.ui.media.adapt"
        },
        {
          "value": "portrait",
          "label": "t:nether.common.ui.media.portrait"
