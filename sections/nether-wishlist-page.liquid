          "label": "t:nether.common.ui.motion.stagger"
        }
      ],
      "info": "t:nether.common.info_animation_style"
    },
    {
      "type": "select",
      "id": "nether_animation_speed",
      "label": "t:nether.common.ui.motion.animation_speed",
      "default": "default",
      "options": [
        {
          "value": "fast",
          "label": "t:nether.common.ui.motion.fast"
        },
        {
          "value": "default",
          "label": "t:nether.common.ui.states.default"
        },
        {
          "value": "slow",
          "label": "t:nether.common.ui.motion.slow"
        }
      ],
      "info": "t:nether.common.info_animation_speed",
      "visible_if": "{{ section.settings.nether_animation_style != 'none' }}"
    },
    {
      "type": "header",
      "content": "t:sections.nether_wishlist_page.settings.responsive.content"
    },
    {
      "type": "select",
      "id": "nether_layout_desktop",
