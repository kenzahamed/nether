  "tag": "section",
  "class": "section section-nether-wishlist-page",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.nether_wishlist_page.settings.framework.content"
    },
    {
      "type": "text",
      "id": "nether_wishlist_heading",
      "label": "t:nether.common.ui.typography.heading",
      "default": "Wishlist"
    },
    {
      "type": "text",
      "id": "nether_wishlist_subheading",
      "label": "t:nether.common.ui.typography.subheading"
    },
    {
      "type": "select",
      "id": "nether_layout",
      "label": "t:sections.nether_wishlist_page.settings.nether_layout.label",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "t:nether.common.ui.layout.grid"
        },
        {
          "value": "list",
          "label": "t:nether.common.ui.labels.list"
        },
        {
          "value": "editorial",
          "label": "t:nether.common.ui.states.editorial"
        }
      ],
      "info": "t:nether.common.info_layout"
    },
    {
      "type": "range",
      "id": "nether_content_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "t:nether.common.px",
      "label": "t:nether.common.ui.labels.content_spacing",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "nether_wishlist_show_count",
      "label": "t:nether.common.ui.labels.show_wishlist_count",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.nether_wishlist_page.settings.empty.content"
    },
    {
      "type": "text",
      "id": "nether_wishlist_empty_heading",
      "label": "t:nether.common.ui.labels.empty_heading"
    },
    {
      "type": "textarea",
      "id": "nether_wishlist_empty_text",
      "label": "t:nether.common.ui.labels.empty_text"
