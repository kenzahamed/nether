      "info": "t:nether.common.info_enable_glass"
    },
    {
      "type": "checkbox",
      "id": "nether_enable_gradient",
      "label": "t:nether.common.ui.labels.enable_gradient_accents",
      "default": false,
      "info": "t:nether.common.info_enable_gradient"
    },
    {
      "type": "header",
      "content": "t:sections.nether_wishlist_page.settings.motion.content"
    },
    {
      "type": "select",
      "id": "nether_animation_style",
      "label": "t:nether.common.ui.motion.animation_style",
      "default": "fade",
      "options": [
        {
          "value": "none",
          "label": "t:nether.common.ui.states.none"
        },
        {
          "value": "fade",
          "label": "t:nether.common.ui.motion.fade"
        },
        {
          "value": "rise",
          "label": "t:nether.common.ui.labels.rise"
        },
