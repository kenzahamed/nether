{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-typography.css' | asset_url | stylesheet_tag }}
{{ 'component-shadow.css' | asset_url | stylesheet_tag }}
{{ 'component-radius.css' | asset_url | stylesheet_tag }}
{{ 'component-wishlist.css' | asset_url | stylesheet_tag }}

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'nether-commerce-interaction.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-wishlist.js' | asset_url }}" defer="defer"></script>

{%- liquid
  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign layout = section.settings.nether_layout | default: 'grid'
  assign nether_class_list = 'nether-wishlist-page'
  assign nether_class_list = nether_class_list | append: ' nether-wishlist-page--layout-' | append: layout
  assign nether_class_list = nether_class_list | append: ' nether-wishlist-page--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-wishlist-page--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-wishlist-page--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-wishlist-page--glass-enabled'
  endif

  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-wishlist-page--gradient-enabled'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .nether-wishlist-page {
    --nether-wishlist-gap: {{ section.settings.nether_content_gap }}px;
    --nether-wishlist-duration: {{ nether_animation_duration }}s;
  }
{%- endstyle -%}

<nether-wishlist-page
  class="{{ nether_class_list }} section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-nether-motion="wishlist-page"
  data-section-id="{{ section.id }}"
  data-animation-style="{{ section.settings.nether_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-page-layout="{{ layout }}"
  data-show-count="{{ section.settings.nether_wishlist_show_count }}"
>
  <script type="application/json" data-nether-wishlist-i18n>
    {
      "title": {{ 'sections.nether_wishlist.title' | t | json }},
      "countOne": {{ 'sections.nether_wishlist.count.one' | t | json }},
      "countOther": {{ 'sections.nether_wishlist.count.other' | t | json }},
      "add": {{ 'sections.nether_wishlist.actions.add' | t | json }},
      "remove": {{ 'sections.nether_wishlist.actions.remove' | t | json }},
      "clear": {{ 'sections.nether_wishlist.actions.clear' | t | json }},
      "moveToCart": {{ 'sections.nether_wishlist.actions.move_to_cart' | t | json }},
      "moving": {{ 'sections.nether_wishlist.actions.moving' | t | json }},
      "moved": {{ 'sections.nether_wishlist.actions.moved' | t | json }},
      "unavailable": {{ 'sections.nether_wishlist.availability.unavailable' | t | json }},
      "available": {{ 'sections.nether_wishlist.availability.available' | t | json }},
      "error": {{ 'sections.nether_wishlist.errors.generic' | t | json }},
      "liveAdd": {{ 'sections.nether_wishlist.live.added' | t | json }},
      "liveRemove": {{ 'sections.nether_wishlist.live.removed' | t | json }}
    }
  </script>

  <div class="page-width">
    {% render 'nether-wishlist-header', section: section %}

    <div class="nether-wishlist-page__layout">
      <div class="nether-wishlist-page__main" data-nether-wishlist-body>
        {% render 'nether-wishlist-empty', section: section, context: 'page' %}

        <div
          class="nether-wishlist-page__list nether-wishlist-page__list--{{ layout }}"
          data-nether-wishlist-list
          role="list"
          aria-label="{{ 'sections.nether_wishlist.list_label' | t }}"
          hidden
        ></div>

        {% render 'nether-wishlist-card', context: 'page' %}
      </div>

      <aside class="nether-wishlist-page__sidebar" data-nether-wishlist-sidebar>
        {%- for block in section.blocks -%}
          {% render 'nether-wishlist-block', block: block, section: section %}
        {%- endfor -%}
      </aside>
    </div>

    <div class="visually-hidden" data-nether-wishlist-live role="status" aria-live="polite"></div>
  </div>
</nether-wishlist-page>

{% schema %}
{
