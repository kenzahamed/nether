            { "value": "waitlist", "label": "Waitlist" },
            { "value": "discount", "label": "Discount signup" }
          ]
        },
        { "type": "text", "id": "contact_tags", "label": "Customer tags", "default": "newsletter" },
        { "type": "text", "id": "capture_note", "label": "Hidden capture note" },
        {
          "type": "select",
          "id": "form_layout",
          "label": "Form layout",
          "default": "stacked",
          "options": [
            { "value": "stacked", "label": "Stacked" },
            { "value": "inline", "label": "Inline" }
          ]
