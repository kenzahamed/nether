{%- endif -%}

{%- liquid
  assign nether_layout = section.settings.nether_layout | default: 'centered_signup'
  assign nether_content_width = section.settings.nether_content_width | default: 'medium'
  assign nether_content_position = section.settings.nether_content_position | default: 'middle-center'

  assign uses_hero_shell = false
  assign uses_section_media = false

  case nether_layout
    when 'editorial_newsletter'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign nether_hero_layout = 'editorial'
    when 'split_layout', 'image_with_signup'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign nether_hero_layout = 'split'
    when 'background_image', 'background_video'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign nether_hero_layout = 'overlay'
    when 'minimal_layout'
      assign uses_hero_shell = true
      assign nether_hero_layout = 'minimal'
    when 'magazine_layout'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign nether_hero_layout = 'editorial'
    when 'vip_membership'
      assign uses_hero_shell = true
      assign nether_hero_layout = 'card'
    when 'early_access_waitlist'
      assign uses_hero_shell = true
      assign nether_hero_layout = 'classic'
  endcase

  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign enable_glass = section.settings.nether_enable_glass
  assign enable_gradient = section.settings.nether_enable_gradient
  if nether_layout == 'vip_membership'
    assign enable_glass = true
  endif
  if nether_layout == 'background_image' or nether_layout == 'background_video'
    assign enable_gradient = true
  endif

  assign nether_class_list = 'nether-newsletter nether-hero'
  assign nether_class_list = nether_class_list | append: ' nether-newsletter--layout-' | append: nether_layout
  if uses_hero_shell
    assign nether_class_list = nether_class_list | append: ' nether-hero--layout-' | append: nether_hero_layout
  endif
  assign nether_class_list = nether_class_list | append: ' nether-hero--width-' | append: nether_content_width
  assign nether_class_list = nether_class_list | append: ' nether-hero--position-' | append: nether_content_position
  assign nether_class_list = nether_class_list | append: ' nether-hero--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-hero--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-hero--mobile-' | append: section.settings.nether_layout_mobile

  if enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-hero--glass-enabled nether-newsletter--glass-enabled'
  endif

  if enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-hero--gradient-enabled'
  endif

  if section.settings.nether_media_position == 'right'
    assign nether_class_list = nether_class_list | append: ' nether-hero--split-media-right'
  endif

  if section.settings.nether_enable_floating_card
    assign nether_class_list = nether_class_list | append: ' nether-newsletter--floating-enabled'
  endif

  case section.settings.nether_layout_tablet
    when 'stacked'
      assign nether_class_list = nether_class_list | append: ' nether-newsletter--tablet-stacked'
    when 'centered'
      assign nether_class_list = nether_class_list | append: ' nether-newsletter--tablet-centered'
  endcase

  case section.settings.nether_layout_mobile
    when 'stacked'
      assign nether_class_list = nether_class_list | append: ' nether-newsletter--mobile-stacked'
    when 'centered'
      assign nether_class_list = nether_class_list | append: ' nether-newsletter--mobile-centered'
    when 'minimal'
      assign nether_class_list = nether_class_list | append: ' nether-newsletter--mobile-minimal'
  endcase

  assign overlay_classes = 'nether-hero__overlay'
  if enable_gradient
    case section.settings.nether_gradient_style
      when 'dramatic'
        assign overlay_classes = overlay_classes | append: ' grad-hero-dramatic'
      when 'vignette'
        assign overlay_classes = overlay_classes | append: ' grad-hero-vignette'
      when 'fade-down'
        assign overlay_classes = overlay_classes | append: ' grad-linear-fade-down'
      else
        assign overlay_classes = overlay_classes | append: ' grad-hero-brand'
    endcase
  endif

  assign heading_tag = 'h2'
  if section.settings.nether_heading_level == 'h3'
    assign heading_tag = 'h3'
  endif

  assign needs_deferred_media = false
  if section.settings.nether_newsletter_media_type == 'video'
    assign needs_deferred_media = true
  endif
  for block in section.blocks
    if block.type == 'video'
      assign needs_deferred_media = true
      break
    endif
  endfor
-%}

{%- if needs_deferred_media -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-newsletter {
    --nether-newsletter-overlay-opacity: {{ section.settings.nether_overlay_opacity | divided_by: 100.0 }};
    --nether-newsletter-transition-duration: {{ nether_animation_duration }}s;
    --nether-hero-overlay-opacity: {{ section.settings.nether_overlay_opacity | divided_by: 100.0 }};
    --nether-hero-transition-duration: {{ nether_animation_duration }}s;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if uses_section_media and section.settings.nether_newsletter_image_desktop != blank -%}
    #NetherNewsletter-{{ section.id }} .nether-hero__media::before {
      padding-bottom: {{ 1 | divided_by: section.settings.nether_newsletter_image_desktop.aspect_ratio | times: 100 }}%;
      content: '';
      display: block;
    }
  {%- endif -%}
{%- endstyle -%}

{%- if section.settings.nether_show_divider_top -%}
  {%- render 'nether-newsletter-divider', section: section, position: 'top' -%}
{%- endif -%}

<nether-newsletter
  id="NetherNewsletter-{{ section.id }}"
  class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-nether-motion="newsletter"
  data-newsletter-layout="{{ nether_layout }}"
  data-nether-newsletter-layout="{{ nether_layout }}"
  {% if section.settings.nether_enable_parallax or section.settings.nether_enable_form_reveal %}data-nether-motion-plugins="scrollTrigger"{% endif %}
  data-animation-style="{{ section.settings.nether_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-enable-parallax="{{ section.settings.nether_enable_parallax }}"
  data-form-reveal="{{ section.settings.nether_enable_form_reveal }}"
  data-hover-reveal="{{ section.settings.nether_enable_hover_reveal }}"
  {% if section.settings.nether_enable_floating_card %}data-floating-enabled="true"{% endif %}
  role="region"
  aria-label="{% render 'nether-locale-text', value: section.settings.nether_aria_label, key: 'sections.nether_newsletter.aria_label' %}"
>
  <div class="nether-newsletter__inner nether-hero__inner">
    {%- if uses_section_media -%}
      {%- render 'nether-hero-media', section: section, adapter: 'newsletter' -%}

      {%- if section.settings.nether_enable_image_overlay or enable_gradient -%}
        <div class="{{ overlay_classes }}" data-nether-hero-overlay data-nether-newsletter-overlay aria-hidden="true"></div>
      {%- endif -%}
    {%- endif -%}

    {%- if uses_hero_shell -%}
      {%- render 'nether-newsletter-content', section: section, heading_tag: heading_tag -%}
    {%- else -%}
      <div class="nether-newsletter__body page-width" data-nether-newsletter-content data-nether-hero-content>
        <div class="nether-newsletter__blocks nether-hero__blocks nether-hero__blocks--align-{{ section.settings.nether_content_alignment | default: 'center' }}">
          {%- for block in section.blocks -%}
            {%- unless block.type == 'email_field' or block.type == 'name_field' or block.type == 'consent_checkbox' -%}
              {%- render 'nether-newsletter-block',
                block: block,
                section: section,
                heading_tag: heading_tag
              -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</nether-newsletter>

{%- if section.settings.nether_show_divider_bottom -%}
  {%- render 'nether-newsletter-divider', section: section, position: 'bottom' -%}
{%- endif -%}

