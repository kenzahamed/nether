{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{% render 'nether-commerce-assets' %}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'component-form.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-footer.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign has_social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign has_social_icons = false
  endif

  if settings.brand_image == blank and settings.brand_headline == blank and settings.brand_description == blank
    assign brand_empty = true
  endif

  if section.blocks.size == 1 and section.blocks[0].type == 'brand_information' and brand_empty and has_social_icons == false and section.settings.newsletter_enable == false and section.settings.enable_follow_on_shop == false
    assign only_empty_brand = true
  endif

  assign nether_column_layout = section.settings.nether_column_layout | default: 'auto'
  assign footer_grid_class = ''

  case nether_column_layout
    when '2'
      assign footer_grid_class = 'nether-footer__grid--2-col'
    when '3'
      assign footer_grid_class = 'nether-footer__grid--3-col'
    when '4'
      assign footer_grid_class = 'nether-footer__grid--4-col'
    when '5'
      assign footer_grid_class = 'nether-footer__grid--5-col'
    else
      if section.blocks.size == 9
        assign footer_grid_class = 'grid--3-col-tablet'
      elsif section.blocks.size > 6
        assign footer_grid_class = 'grid--4-col-desktop'
      elsif section.blocks.size > 4
        assign footer_grid_class = 'grid--3-col-tablet'
      endif
  endcase

  assign nether_class_list = 'nether-footer'
  assign nether_class_list = nether_class_list | append: ' nether-footer--spacing-' | append: section.settings.nether_footer_spacing
  assign nether_class_list = nether_class_list | append: ' nether-footer--bg-' | append: section.settings.nether_background_style
  assign nether_class_list = nether_class_list | append: ' nether-footer--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-footer--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-footer--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_show_divider
    assign nether_class_list = nether_class_list | append: ' nether-footer--divider'
  endif

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-footer--glass-enabled'
  endif

  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-footer--gradient-enabled'
  endif

  if section.settings.nether_layout_mobile == 'accordion'
    assign nether_class_list = nether_class_list | append: ' nether-footer--mobile-accordion'
  endif

  assign footer_surface_classes = 'footer color-' | append: section.settings.color_scheme | append: ' gradient section-' | append: section.id | append: '-padding'

  if section.settings.nether_enable_glass
    assign footer_surface_classes = footer_surface_classes | append: ' glass-drawer-medium'
  endif

  if section.settings.nether_enable_gradient
    assign footer_surface_classes = footer_surface_classes | append: ' grad-linear-subtle'
  endif

  assign nether_logo_width = section.settings.nether_logo_width
  if nether_logo_width == 0
    assign nether_logo_width = settings.logo_width
  endif

  assign footer_heading_tag = 'h2'
  if section.settings.nether_heading_level == 'h3'
    assign footer_heading_tag = 'h3'
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-footer {
    --nether-footer-padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --nether-footer-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --nether-footer-gap: {{ section.settings.nether_column_gap }}px;
    --nether-footer-logo-width: {{ nether_logo_width }}px;
    --nether-footer-divider-opacity: {{ section.settings.nether_divider_opacity | divided_by: 100.0 }};
  }

  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .nether-footer {
      --nether-footer-padding-top: {{ section.settings.padding_top }}px;
      --nether-footer-padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<nether-footer
  class="{{ nether_class_list }}"
  data-section-id="{{ section.id }}"
  data-column-layout="{{ nether_column_layout }}"
  data-nether-motion="footer"
  role="contentinfo"
  aria-label="{{ 'sections.nether_footer.aria_label' | t }}"
>
  <footer class="{{ footer_surface_classes }}">
    {%- if section.blocks.size > 0
      or section.settings.newsletter_enable
      or section.settings.show_social
      and has_social_icons == true
      or section.settings.enable_follow_on_shop
      or section.settings.nether_enable_footer_logo
    -%}
      {%- unless only_empty_brand -%}
        <div class="footer__content-top page-width nether-footer__content-top">
          {%- if section.settings.nether_enable_footer_logo -%}
            <div class="nether-footer__section-logo">
              {%- render 'nether-footer-logo', image_width: nether_logo_width -%}
            </div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <div
              class="footer__blocks-wrapper grid grid--1-col grid--2-col grid--4-col-tablet {{ footer_grid_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
              {% endif %}
            >
              {%- for block in section.blocks -%}
                <div
                  class="footer-block grid__item nether-footer__block footer-block--{{ block.type | replace: '_', '-' }}{% if block.type == 'link_list' %} footer-block--menu{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {{ block.shopify_attributes }}
                  {% if section.settings.nether_layout_mobile == 'accordion' %}
                    data-nether-footer-accordion
                  {% endif %}
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {%- if section.settings.nether_layout_mobile == 'accordion' and block.settings.heading != blank -%}
                    <button
                      type="button"
                      class="nether-footer__accordion-trigger"
                      data-nether-footer-accordion-trigger
                      aria-expanded="false"
                      aria-controls="FooterAccordionPanel-{{ block.id }}"
                    >
                      <span class="footer-block__heading inline-richtext">{{ block.settings.heading }}</span>
                      <span class="svg-wrapper" aria-hidden="true">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </button>
                    <div
                      id="FooterAccordionPanel-{{ block.id }}"
                      class="nether-footer__accordion-panel"
                      data-nether-footer-accordion-panel
                      hidden
                    >
                      {%- render 'nether-footer-block',
                        block: block,
                        section: section,
                        has_social_icons: has_social_icons,
                        heading_tag: footer_heading_tag,
                        hide_heading: true
                      -%}
                    </div>
                    <div class="nether-footer__accordion-desktop">
                      {%- render 'nether-footer-block',
                        block: block,
                        section: section,
                        has_social_icons: has_social_icons,
                        heading_tag: footer_heading_tag
                      -%}
                    </div>
                  {%- else -%}
                    {%- render 'nether-footer-block',
                      block: block,
                      section: section,
                      has_social_icons: has_social_icons,
                      heading_tag: footer_heading_tag
                    -%}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div
            class="footer-block--newsletter nether-footer__newsletter-column{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- if section.settings.newsletter_enable -%}
              {%- render 'nether-footer-newsletter', section: section -%}
            {%- endif -%}

            {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
              <div class="footer__follow-on-shop">
                {{ shop | login_button: action: 'follow' }}
              </div>
            {%- endif -%}

            {%- if section.settings.show_social and has_social_icons and section.settings.nether_social_in_bottom_bar == false -%}
              {%- render 'nether-footer-social', show_heading: false, class: 'footer__list-social' -%}
            {%- endif -%}
          </div>
        </div>
      {%- endunless -%}
    {%- endif -%}

    {%- render 'nether-footer-bottom-bar', section: section, has_social_icons: has_social_icons -%}
  </footer>
</nether-footer>

{% schema %}
{
