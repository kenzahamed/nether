<style>
  #shopify-section-{{ section.id }} .acs-root {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    color: #ffffff;
    background-color: #000000;
    text-transform: uppercase;
    isolation: isolate;
    touch-action: none;
  }

  #shopify-section-{{ section.id }} .acs-root,
  #shopify-section-{{ section.id }} .acs-root * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .acs-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    visibility: hidden;
  }

  #shopify-section-{{ section.id }} .acs-outer,
  #shopify-section-{{ section.id }} .acs-inner {
    width: 100%;
    height: 100%;
    overflow-y: hidden;
  }

  #shopify-section-{{ section.id }} .acs-bg {
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  #shopify-section-{{ section.id }} .acs-heading {
    font-size: clamp(1rem, 5vw, 5rem);
    font-weight: 400;
    text-align: center;
    letter-spacing: 0.5em;
    margin: 0;
    margin-right: -0.5em;
    width: 90%;
    max-width: 1200px;
    z-index: 2;
    overflow: hidden;
    line-height: 1.1;
  }

  #shopify-section-{{ section.id }} .acs-char {
    display: inline-block;
    will-change: transform, opacity;
  }

  #shopify-section-{{ section.id }} .acs-char--space {
    width: 0.25em;
  }

  #shopify-section-{{ section.id }} .acs-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 2rem;
    text-align: center;
    opacity: 0.6;
    text-transform: none;
  }
</style>

{%- liquid
  assign bg_gradient = 'linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.3) 100%)'
-%}

<div class="acs-root" data-acs-root data-nether-motion data-nether-motion-plugins="observer">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div
        class="acs-slide"
        data-acs-slide
        data-slide-index="{{ forloop.index0 }}"
        {{ block.shopify_attributes }}
      >
        <div class="acs-outer">
          <div class="acs-inner">
            <div
              class="acs-bg"
              {% if block.settings.background_image != blank %}
                style="background-image: {{ bg_gradient }}, url('{{ block.settings.background_image | image_url: width: 2000 }}');"
              {% else %}
                style="background-image: {{ bg_gradient }};"
              {% endif %}
            >
              {%- if block.settings.heading != blank -%}
                <h2
                  class="acs-heading section-heading"
                  style="color: {{ block.settings.heading_color }};"
                  data-acs-heading
                >
                  {{ block.settings.heading | escape }}
                </h2>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  {%- else -%}
    <p class="acs-empty">Add slide blocks to build your animated continuous section.</p>
  {%- endif -%}
</div>

<script>
  (function () {
    const SECTION_ID = '{{ section.id }}';
    const SECTION_SELECTOR = '#shopify-section-' + SECTION_ID;

    let observerInstance = null;

    function splitHeadingIntoChars(heading) {
      const originalText = heading.textContent.trim();
      if (!originalText) return { chars: [] };

      heading.setAttribute('aria-label', originalText);
      heading.textContent = '';

      const chars = [];
      const parts = originalText.split(/(\s+)/).filter(function (part) {
        return part.length > 0;
      });

      parts.forEach(function (part) {
        if (/^\s+$/.test(part)) {
          const space = document.createElement('span');
          space.className = 'acs-char acs-char--space';
          space.setAttribute('aria-hidden', 'true');
          space.innerHTML = '&nbsp;';
          heading.appendChild(space);
          chars.push(space);
          return;
        }

        part.split('').forEach(function (character) {
          const span = document.createElement('span');
          span.className = 'acs-char';
          span.textContent = character;
          span.setAttribute('aria-hidden', 'true');
          heading.appendChild(span);
          chars.push(span);
        });
      });

      return { chars: chars };
    }

    function initAnimatedContinuousSection() {
      const root = document.querySelector(SECTION_SELECTOR + ' [data-acs-root]');
      if (!root || typeof gsap === 'undefined' || typeof Observer === 'undefined') return;

      if (observerInstance) {
        observerInstance.kill();
        observerInstance = null;
      }

      const slides = gsap.utils.toArray(root.querySelectorAll('[data-acs-slide]'));
      if (!slides.length) return;

      const images = gsap.utils.toArray(root.querySelectorAll('.acs-bg'));
      const outerWrappers = gsap.utils.toArray(root.querySelectorAll('.acs-outer'));
      const innerWrappers = gsap.utils.toArray(root.querySelectorAll('.acs-inner'));
      const splitHeadings = slides.map(function (slide) {
        const heading = slide.querySelector('[data-acs-heading]');
        return heading ? splitHeadingIntoChars(heading) : { chars: [] };
      });

      const prefersReducedMotion =
        window.NetherMotion && typeof window.NetherMotion.prefersReducedMotion === 'function'
          ? window.NetherMotion.prefersReducedMotion()
          : window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let currentIndex = -1;
      const wrap = gsap.utils.wrap(0, slides.length);
      let animating = false;

      if (prefersReducedMotion) {
        slides.forEach(function (slide, index) {
          gsap.set(slide, { autoAlpha: index === 0 ? 1 : 0, visibility: 'inherit' });
        });
        return;
      }

      gsap.set(outerWrappers, { yPercent: 100 });
      gsap.set(innerWrappers, { yPercent: -100 });

      function gotoSection(index, direction) {
        index = wrap(index);
        animating = true;

        const fromTop = direction === -1;
        const dFactor = fromTop ? -1 : 1;
        const tl = gsap.timeline({
          defaults: { duration: 1.25, ease: 'power1.inOut' },
          onComplete: function () {
            animating = false;
          },
        });

        if (currentIndex >= 0) {
          gsap.set(slides[currentIndex], { zIndex: 0 });
          tl.to(images[currentIndex], { yPercent: -15 * dFactor }).set(slides[currentIndex], { autoAlpha: 0 });
        }

        gsap.set(slides[index], { autoAlpha: 1, zIndex: 1, visibility: 'inherit' });

        tl.fromTo(
          [outerWrappers[index], innerWrappers[index]],
          {
            yPercent: function (i) {
              return i ? -100 * dFactor : 100 * dFactor;
            },
          },
          { yPercent: 0 },
          0
        )
          .fromTo(images[index], { yPercent: 15 * dFactor }, { yPercent: 0 }, 0);

        const chars = splitHeadings[index] ? splitHeadings[index].chars : [];
        if (chars.length) {
          tl.fromTo(
            chars,
            {
              autoAlpha: 0,
              yPercent: 150 * dFactor,
            },
            {
              autoAlpha: 1,
              yPercent: 0,
              duration: 1,
              ease: 'power2',
              stagger: {
                each: 0.02,
                from: 'random',
              },
            },
            0.2
          );
        }

        currentIndex = index;
      }

      if (slides.length > 1) {
        observerInstance = Observer.create({
          target: root,
          type: 'wheel,touch,pointer',
          wheelSpeed: -1,
          onDown: function () {
            if (!animating) gotoSection(currentIndex - 1, -1);
          },
          onUp: function () {
            if (!animating) gotoSection(currentIndex + 1, 1);
          },
          tolerance: 10,
          preventDefault: true,
        });
      }

      gotoSection(0, 1);
    }

    function destroyAnimatedContinuousSection() {
      if (observerInstance) {
        observerInstance.kill();
        observerInstance = null;
      }
    }

    function boot() {
      if (!window.NetherMotion || typeof window.NetherMotion.load !== 'function') return;

      window.NetherMotion.load(['observer']).then(function () {
        initAnimatedContinuousSection();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }

    if (window.NetherMotion && typeof window.NetherMotion.registerSection === 'function') {
      window.NetherMotion.registerSection(SECTION_ID, {
        init: function () {
          boot();
        },
        destroy: function () {
          destroyAnimatedContinuousSection();
        },
      });
    }

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === SECTION_ID) {
        boot();
      }
    });

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.detail.sectionId === SECTION_ID) {
        destroyAnimatedContinuousSection();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Animated Continuous",
  "tag": "section",
  "class": "section-animated-continuous",
  "max_blocks": 10,
  "settings": [
    {
      "type": "paragraph",
      "content": "Scroll or swipe over this section to animate between slides. Add up to 10 slide blocks below."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading text",
          "default": "Scroll down"
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading color",
          "default": "#cccccc"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Animated Continuous",
      "category": "Custom",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
