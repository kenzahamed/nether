          "value": "brand",
          "label": "t:nether.common.ui.labels.brand"
        },
        {
          "value": "dramatic",
          "label": "t:nether.common.ui.labels.dramatic"
        },
        {
          "value": "vignette",
          "label": "t:nether.common.ui.labels.vignette"
        },
        {
          "value": "fade-down",
          "label": "t:nether.common.ui.labels.fade_down"
