      "type": "checkbox",
      "id": "nether_enable_floating_cards",
      "label": "t:nether.common.ui.labels.floating_cards",
      "default": false,
      "info": "t:nether.common.info_floating_card"
    },
    {
      "type": "select",
      "id": "nether_hover_effect",
      "label": "t:nether.common.ui.motion.hover_effect",
      "default": "zoom",
      "options": [
        {
          "value": "zoom",
          "label": "t:nether.common.ui.motion.zoom"
        },
