{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card-premium.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-typography.css' | asset_url | stylesheet_tag }}
{{ 'component-shadow.css' | asset_url | stylesheet_tag }}
{{ 'component-radius.css' | asset_url | stylesheet_tag }}
{{ 'component-collection-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-collection-showcase.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_layout == 'carousel' or section.settings.nether_layout == 'horizontal_scroll' -%}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign nether_layout = section.settings.nether_layout | default: 'luxury_grid'
  assign nether_columns_desktop = section.settings.nether_columns_desktop | default: 3
  assign nether_columns_tablet = section.settings.nether_columns_tablet | default: 2
  assign nether_columns_mobile = section.settings.nether_columns_mobile | default: 1
  assign nether_gap = section.settings.nether_gap | default: 24

  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign collection_blocks = section.blocks | where: 'type', 'collection'
  assign collection_count = collection_blocks.size

  assign show_slider = false
  if nether_layout == 'carousel'
    assign show_slider = true
  endif

  assign show_horizontal = false
  if nether_layout == 'horizontal_scroll'
    assign show_horizontal = true
  endif

  assign nether_class_list = 'nether-collection'
  assign nether_class_list = nether_class_list | append: ' nether-collection--layout-' | append: nether_layout
  assign nether_class_list = nether_class_list | append: ' nether-collection--card-' | append: section.settings.nether_card_style
  assign nether_class_list = nether_class_list | append: ' nether-collection--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-collection--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-collection--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-collection--glass-enabled'
  endif

  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-collection--gradient-enabled'
  endif

  if section.settings.nether_enable_floating_cards
    assign nether_class_list = nether_class_list | append: ' nether-collection--floating-enabled'
  endif

  if section.settings.nether_full_width
    assign nether_class_list = nether_class_list | append: ' nether-collection--full-width'
  endif

  assign heading_tag = 'h2'
  if section.settings.nether_heading_level == 'h3'
    assign heading_tag = 'h3'
  endif

  # Placeholder ratio respects section setting (no image → adapt falls back to 1)
  assign placeholder_image_ratio = section.settings.nether_image_ratio | default: 'portrait'
  assign placeholder_ratio = 1
  if placeholder_image_ratio == 'portrait'
    assign placeholder_ratio = 0.8
  elsif placeholder_image_ratio == 'landscape'
    assign placeholder_ratio = 1.4
  elsif placeholder_image_ratio == 'square'
    assign placeholder_ratio = 1
  endif

  assign grid_classes = 'nether-collection__grid'
  if show_slider
    assign grid_classes = grid_classes | append: ' slider slider--desktop grid--peek'
  endif
  if show_horizontal
    assign grid_classes = grid_classes | append: ' nether-collection__grid--horizontal'
  endif

  assign needs_deferred_media = false
  for block in collection_blocks
    if block.settings.media_type == 'video'
      assign needs_deferred_media = true
      break
    endif
  endfor
-%}

{%- if needs_deferred_media -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-collection {
    --nether-collection-gap: {{ nether_gap }}px;
    --nether-collection-columns-desktop: {{ nether_columns_desktop }};
    --nether-collection-columns-tablet: {{ nether_columns_tablet }};
    --nether-collection-columns-mobile: {{ nether_columns_mobile }};
    --nether-collection-overlay-opacity: {{ section.settings.nether_overlay_opacity | divided_by: 100.0 }};
    --nether-collection-transition-duration: {{ nether_animation_duration }}s;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.nether_show_divider_top -%}
  {%- render 'nether-collection-divider', section: section, position: 'top' -%}
{%- endif -%}

<nether-collection
  id="NetherCollection-{{ section.id }}"
  class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-nether-motion="collection"
  data-collection-layout="{{ nether_layout }}"
  data-nether-collection-layout="{{ nether_layout }}"
  data-nether-collection-card-style="{{ section.settings.nether_card_style }}"
  {% if section.settings.nether_enable_parallax or nether_layout == 'editorial_grid' or nether_layout == 'magazine' or nether_layout == 'split_collection' or nether_layout == 'masonry_grid' or nether_layout == 'carousel' or nether_layout == 'horizontal_scroll' or section.settings.nether_animation_style == 'stagger' or section.settings.nether_animation_style == 'slide' or section.settings.nether_animation_style == 'scale' %}data-nether-motion-plugins="scrollTrigger"{% endif %}
  data-animation-style="{{ section.settings.nether_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-enable-parallax="{{ section.settings.nether_enable_parallax }}"
  data-hover-reveal="{{ section.settings.nether_hover_effect }}"
  data-carousel-ready="{{ show_slider }}"
  role="region"
  aria-label="{% render 'nether-locale-text', value: section.settings.nether_aria_label, key: 'sections.nether_collection.aria_label' %}"
>
  <div class="nether-collection__inner{% unless section.settings.nether_full_width %} page-width{% endunless %}">
    {%- render 'nether-collection-content', section: section, heading_tag: heading_tag -%}

    {%- if collection_count > 0 -%}
      {%- if show_slider -%}
        <slider-component
          class="nether-collection__slider slider-mobile-gutter{% if section.settings.nether_full_width %} slider-component-full-width{% endif %}"
          data-nether-collection-carousel
        >
      {%- endif -%}

      <ul
        id="NetherCollectionGrid-{{ section.id }}"
        class="{{ grid_classes }}"
        role="list"
        aria-label="{{ 'sections.nether_collection.grid.label' | t }}"
        data-nether-collection-grid
        data-collection-count="{{ collection_count }}"
      >
        {%- assign card_index = 0 -%}
        {%- for block in collection_blocks -%}
          {%- assign card_index = card_index | plus: 1 -%}
          {%- liquid
            assign is_featured = false
            if nether_layout == 'split_collection' or nether_layout == 'magazine'
              if card_index == 1
                assign is_featured = true
              endif
            endif

            assign lazy_load = true
            if card_index <= nether_columns_desktop
              assign lazy_load = false
            endif
          -%}
          <li
            id="NetherCollectionSlide-{{ section.id }}-{{ card_index }}"
            class="nether-collection__item{% if show_slider %} slider__slide{% endif %}{% if is_featured %} nether-collection__item--featured{% endif %}"
            data-nether-collection-item
          >
            {%- render 'nether-collection-card',
              block: block,
              section: section,
              columns: nether_columns_desktop,
              lazy_load: lazy_load,
              is_featured: is_featured,
              card_index: card_index
            -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_slider -%}
          <div class="slider-buttons no-js-hidden">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              data-nether-collection-nav-control
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="NetherCollectionGrid-{{ section.id }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
              <span class="slider-counter--total">{{ collection_count }}</span>
            </div>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              data-nether-collection-nav-control
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="NetherCollectionGrid-{{ section.id }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        </slider-component>
      {%- endif -%}
    {%- else -%}
      <ul class="nether-collection__grid nether-collection__grid--placeholder" role="list">
        {%- for i in (1..nether_columns_desktop) -%}
          {%- assign placeholder_index = i | modulo: 4 | plus: 1 -%}
          <li class="nether-collection__item">
            <article class="nether-collection-card nether-collection-card--placeholder">
              <div class="nether-collection-card__inner card card--card card--media">
                <div class="nether-collection-card__media ratio" style="--ratio-percent: {{ 1 | divided_by: placeholder_ratio | times: 100 }}%;">
                  {{ 'collection-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="nether-collection-card__content">
                  <h3 class="nether-collection-card__heading type-heading-md">{{ 'onboarding.collection_title' | t }}</h3>
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.nether_show_view_all and section.settings.nether_view_all_collection != blank -%}
      {%- assign view_all_collection = collections[section.settings.nether_view_all_collection] -%}
      {%- if view_all_collection != blank -%}
        <div class="nether-collection__view-all" data-nether-collection-animate data-nether-collection-role="buttons">
          {%- liquid
            assign view_all_label = section.settings.nether_view_all_label
            if view_all_label == blank
              assign view_all_label = 'sections.nether_collection.view_all' | t
            endif
            assign view_all_aria = 'sections.nether_collection.view_all_label' | t: collection_name: view_all_collection.title
          -%}
          {%- render 'button',
            label: view_all_label,
            link: view_all_collection.url,
            style: section.settings.nether_view_all_style,
            show_arrow: true,
            aria_label: view_all_aria
          -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.nether_show_recommendations_note -%}
      <div class="nether-collection__recommendations-note" data-nether-collection-animate data-nether-recommendations-integration>
        {% render 'nether-recommendations-extensions', type: 'collection_cards' %}
        <p class="type-body-sm">{{ 'sections.nether_recommendations.collection_showcase_note' | t }}</p>
      </div>
    {%- endif -%}

    {%- if section.settings.nether_show_bundles_note -%}
      <div class="nether-collection__bundles-note" data-nether-collection-animate data-nether-bundles-integration>
        {% render 'nether-bundles-extensions', type: 'dynamic_merchandising' %}
        <p class="type-body-sm">{{ 'sections.nether_bundles.collection_showcase_note' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</nether-collection>

{%- if section.settings.nether_show_divider_bottom -%}
  {%- render 'nether-collection-divider', section: section, position: 'bottom' -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.nether_collection.name",
  "tag": "section",
  "class": "section section-nether-collection",
  "max_blocks": 16,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.nether_collection.settings.framework_header.content"
    },
    {
      "type": "select",
      "id": "nether_layout",
      "label": "t:nether.common.ui.layout.layout",
      "default": "luxury_grid",
      "options": [
        {
          "value": "editorial_grid",
          "label": "t:nether.common.ui.labels.editorial_grid"
        },
        {
          "value": "luxury_grid",
          "label": "t:nether.common.ui.labels.luxury_grid"
        },
        {
          "value": "masonry_grid",
          "label": "t:sections.nether_collection.settings.nether_layout.options__3.label"
        },
        {
          "value": "magazine",
          "label": "t:nether.common.ui.labels.magazine_layout"
        },
        {
          "value": "split_collection",
          "label": "t:sections.nether_collection.settings.nether_layout.options__5.label"
        },
        {
          "value": "card_layout",
          "label": "t:sections.nether_collection.settings.nether_layout.options__6.label"
        },
        {
          "value": "minimal_grid",
          "label": "t:sections.nether_collection.settings.nether_layout.options__7.label"
        },
        {
          "value": "horizontal_scroll",
          "label": "t:nether.common.ui.labels.horizontal_scroll"
        },
        {
          "value": "carousel",
          "label": "t:nether.common.ui.labels.carousel"
        }
      ],
      "info": "t:nether.common.info_layout"
    },
    {
      "type": "range",
      "id": "nether_columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:nether.common.ui.layout.desktop_columns"
    },
    {
      "type": "range",
      "id": "nether_columns_tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:nether.common.ui.layout.tablet_columns"
    },
    {
      "type": "select",
      "id": "nether_columns_mobile",
      "label": "t:nether.common.ui.layout.mobile_columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "t:nether.common.ui.labels.1_column"
        },
        {
          "value": "2",
          "label": "t:nether.common.ui.labels.2_columns"
        }
      ]
    },
    {
      "type": "range",
      "id": "nether_gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "t:nether.common.px",
      "default": 24,
      "label": "t:nether.common.ui.labels.grid_gap"
    },
    {
      "type": "select",
      "id": "nether_card_style",
      "label": "t:nether.common.ui.labels.card_style",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:nether.common.ui.sizing.small"
        },
        {
          "value": "medium",
          "label": "t:nether.common.ui.sizing.medium"
        },
        {
          "value": "large",
          "label": "t:nether.common.ui.sizing.large"
        },
        {
          "value": "editorial",
          "label": "t:nether.common.ui.states.editorial"
        },
        {
          "value": "glass",
          "label": "t:nether.common.ui.states.glass"
        },
        {
          "value": "gradient",
          "label": "t:nether.common.ui.states.gradient"
        },
        {
          "value": "minimal",
