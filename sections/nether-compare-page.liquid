      "default": "split",
      "options": [
        { "value": "split", "label": "t:sections.nether_compare_page.settings.nether_layout_desktop.options__1.label" },
        { "value": "stacked", "label": "t:sections.nether_compare_page.settings.nether_layout_desktop.options__2.label" }
      ]
