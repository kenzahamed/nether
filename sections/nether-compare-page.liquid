      "id": "nether_compare_empty_button_link",
      "label": "t:sections.nether_compare_page.settings.nether_compare_empty_button_link.label"
    },
    {
      "type": "header",
      "content": "t:sections.nether_compare_page.settings.visual.content"
    },
    {
      "type": "checkbox",
      "id": "nether_enable_glass",
      "label": "t:sections.nether_compare_page.settings.nether_enable_glass.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "nether_enable_gradient",
      "label": "t:sections.nether_compare_page.settings.nether_enable_gradient.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.nether_compare_page.settings.motion.content"
    },
    {
