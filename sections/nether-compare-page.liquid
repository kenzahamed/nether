      "id": "nether_layout_tablet",
      "label": "t:sections.nether_compare_page.settings.nether_layout_tablet.label",
      "default": "stacked",
      "options": [
        { "value": "split", "label": "t:sections.nether_compare_page.settings.nether_layout_tablet.options__1.label" },
        { "value": "stacked", "label": "t:sections.nether_compare_page.settings.nether_layout_tablet.options__2.label" }
