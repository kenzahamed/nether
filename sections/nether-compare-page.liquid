        {
          "value": "table",
          "label": "t:nether.common.ui.labels.table"
        },
        {
          "value": "cards",
          "label": "t:nether.common.ui.labels.cards"
        },
        {
          "value": "editorial",
          "label": "t:nether.common.ui.states.editorial"
        }
      ],
