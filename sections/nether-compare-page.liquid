        { "value": "none", "label": "t:sections.nether_compare_page.settings.nether_animation_style.options__1.label" },
        { "value": "fade", "label": "t:sections.nether_compare_page.settings.nether_animation_style.options__2.label" },
        { "value": "rise", "label": "t:sections.nether_compare_page.settings.nether_animation_style.options__3.label" },
        { "value": "stagger", "label": "t:sections.nether_compare_page.settings.nether_animation_style.options__4.label" }
      ]
    },
    {
      "type": "select",
      "id": "nether_animation_speed",
