      "step": 4,
      "unit": "px",
      "label": "t:sections.nether_compare_page.settings.nether_content_gap.label",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "nether_compare_show_count",
      "label": "t:sections.nether_compare_page.settings.nether_compare_show_count.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.nether_compare_page.settings.empty.content"
    },
    {
      "type": "text",
      "id": "nether_compare_empty_heading",
      "label": "t:sections.nether_compare_page.settings.nether_compare_empty_heading.label"
    },
    {
      "type": "textarea",
