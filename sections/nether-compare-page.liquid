{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-typography.css' | asset_url | stylesheet_tag }}
{{ 'component-shadow.css' | asset_url | stylesheet_tag }}
{{ 'component-radius.css' | asset_url | stylesheet_tag }}
{{ 'component-compare.css' | asset_url | stylesheet_tag }}

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'nether-commerce-interaction.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-compare.js' | asset_url }}" defer="defer"></script>

{%- liquid
  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign layout = section.settings.nether_layout | default: 'table'
  assign nether_class_list = 'nether-compare-page'
  assign nether_class_list = nether_class_list | append: ' nether-compare-page--layout-' | append: layout
  assign nether_class_list = nether_class_list | append: ' nether-compare-page--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-compare-page--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-compare-page--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-compare-page--glass-enabled'
  endif

  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-compare-page--gradient-enabled'
  endif
-%}

{%- style -%}
  {% render 'nether-section-padding', section: section %}

  #shopify-section-{{ section.id }} .nether-compare-page {
    --nether-compare-gap: {{ section.settings.nether_content_gap }}px;
    --nether-compare-duration: {{ nether_animation_duration }}s;
  }
{%- endstyle -%}

<nether-compare-page
  class="{{ nether_class_list }} section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-nether-motion="compare-page"
  data-section-id="{{ section.id }}"
  data-animation-style="{{ section.settings.nether_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-page-layout="{{ layout }}"
  data-table-style="{{ section.settings.nether_compare_table_style | default: 'standard' }}"
  data-highlight-differences="{{ section.settings.nether_compare_highlight_differences }}"
  data-max-items="{{ section.settings.nether_compare_max_items | default: 4 }}"
  data-show-count="{{ section.settings.nether_compare_show_count }}"
>
  <script type="application/json" data-nether-compare-i18n>
    {
      "title": {{ 'sections.nether_compare.title' | t | json }},
      "countOne": {{ 'sections.nether_compare.count.one' | t | json }},
      "countOther": {{ 'sections.nether_compare.count.other' | t | json }},
      "add": {{ 'sections.nether_compare.actions.add' | t | json }},
      "remove": {{ 'sections.nether_compare.actions.remove' | t | json }},
      "clear": {{ 'sections.nether_compare.actions.clear' | t | json }},
      "moveToCart": {{ 'sections.nether_compare.actions.move_to_cart' | t | json }},
      "moving": {{ 'sections.nether_compare.actions.moving' | t | json }},
      "moved": {{ 'sections.nether_compare.actions.moved' | t | json }},
      "unavailable": {{ 'sections.nether_compare.availability.unavailable' | t | json }},
      "available": {{ 'sections.nether_compare.availability.available' | t | json }},
      "error": {{ 'sections.nether_compare.errors.generic' | t | json }},
      "full": {{ 'sections.nether_compare.errors.full' | t | json }},
      "liveAdd": {{ 'sections.nether_compare.live.added' | t | json }},
      "liveRemove": {{ 'sections.nether_compare.live.removed' | t | json }},
      "liveFull": {{ 'sections.nether_compare.live.full' | t | json }},
      "attributeLabel": {{ 'sections.nether_compare.table.attribute' | t | json }},
      "productLabel": {{ 'sections.nether_compare.table.product' | t | json }}
    }
  </script>

  <div class="page-width">
    {% render 'nether-compare-header', section: section %}

    <div class="nether-compare-page__layout">
      <div class="nether-compare-page__main" data-nether-compare-body>
        {% render 'nether-compare-empty', section: section, context: 'page' %}

        <div
          class="nether-compare-page__list nether-compare-page__list--{{ layout }}"
          data-nether-compare-list
          role="list"
          aria-label="{{ 'sections.nether_compare.list_label' | t }}"
          hidden
        ></div>

        {% render 'nether-compare-card', context: 'page' %}
        {% render 'nether-compare-table',
          context: 'page',
          table_style: section.settings.nether_compare_table_style,
          highlight_differences: section.settings.nether_compare_highlight_differences
        %}
      </div>

      <aside class="nether-compare-page__sidebar" data-nether-compare-sidebar>
        {%- for block in section.blocks -%}
          {% render 'nether-compare-block', block: block, section: section %}
        {%- endfor -%}
      </aside>
    </div>

    <div class="visually-hidden" data-nether-compare-live role="status" aria-live="polite"></div>
  </div>
</nether-compare-page>

