      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "attributes",
      "name": "t:sections.nether_compare_page.blocks.attributes.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.nether_compare_page.blocks.settings.label" },
        { "type": "text", "id": "text", "label": "t:sections.nether_compare_page.blocks.settings.text" }
