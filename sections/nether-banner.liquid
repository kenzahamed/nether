{%- liquid
  assign nether_banner_layout = section.settings.nether_banner_layout | default: 'promotional'
  assign nether_banner_height = section.settings.nether_banner_height | default: 'medium'
  assign nether_content_width = section.settings.nether_banner_content_width | default: 'medium'
  assign nether_content_position = section.settings.nether_banner_content_position | default: 'middle-center'

  case nether_banner_layout
    when 'split', 'collection'
      assign nether_hero_layout = 'split'
    when 'editorial'
      assign nether_hero_layout = 'editorial'
    when 'brand_story'
      assign nether_hero_layout = 'split'
    when 'minimal'
      assign nether_hero_layout = 'minimal'
    when 'glass'
      assign nether_hero_layout = 'card'
    when 'gradient'
      assign nether_hero_layout = 'overlay'
    else
      assign nether_hero_layout = 'classic'
  endcase

  case section.settings.nether_banner_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign enable_glass = section.settings.nether_banner_enable_glass
  assign enable_gradient = section.settings.nether_banner_enable_gradient
  if nether_banner_layout == 'glass'
    assign enable_glass = true
  endif
  if nether_banner_layout == 'gradient'
    assign enable_gradient = true
  endif

  assign nether_class_list = 'nether-banner nether-hero'
  assign nether_class_list = nether_class_list | append: ' nether-banner--layout-' | append: nether_banner_layout
  assign nether_class_list = nether_class_list | append: ' nether-hero--layout-' | append: nether_hero_layout
  assign nether_class_list = nether_class_list | append: ' nether-banner--height-' | append: nether_banner_height
  assign nether_class_list = nether_class_list | append: ' nether-hero--height-' | append: nether_banner_height
  assign nether_class_list = nether_class_list | append: ' nether-hero--width-' | append: nether_content_width
  assign nether_class_list = nether_class_list | append: ' nether-hero--position-' | append: nether_content_position
  assign nether_class_list = nether_class_list | append: ' nether-hero--desktop-' | append: section.settings.nether_banner_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-hero--tablet-' | append: section.settings.nether_banner_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-hero--mobile-' | append: section.settings.nether_banner_layout_mobile

  if enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-hero--glass-enabled'
  endif

  if enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-hero--gradient-enabled'
  endif

  if section.settings.nether_banner_split_media_position == 'right'
    assign nether_class_list = nether_class_list | append: ' nether-hero--split-media-right'
  endif

  if section.settings.nether_banner_enable_floating_card
    assign nether_class_list = nether_class_list | append: ' nether-banner--floating-card'
  endif

  assign overlay_classes = 'nether-hero__overlay'
  if enable_gradient
    case section.settings.nether_banner_gradient_style
      when 'dramatic'
        assign overlay_classes = overlay_classes | append: ' grad-hero-dramatic'
      when 'vignette'
        assign overlay_classes = overlay_classes | append: ' grad-hero-vignette'
      when 'fade-down'
        assign overlay_classes = overlay_classes | append: ' grad-linear-fade-down'
      else
        assign overlay_classes = overlay_classes | append: ' grad-hero-brand'
    endcase
  endif

  assign heading_tag = 'h2'
  if section.settings.nether_banner_heading_level == 'h3'
    assign heading_tag = 'h3'
  endif

  assign fetch_priority = 'auto'
  if section.index <= 2
    assign fetch_priority = 'high'
  endif

  assign banner_collection = nil
  if section.settings.nether_banner_collection != blank
    assign banner_collection = collections[section.settings.nether_banner_collection]
  endif
-%}

{%- if enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_banner_media_type == 'video' -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-banner {
    --nether-hero-overlay-opacity: {{ section.settings.nether_banner_overlay_opacity | divided_by: 100.0 }};
    --nether-hero-transition-duration: {{ nether_animation_duration }}s;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if nether_banner_height == 'adapt' and section.settings.nether_banner_image_desktop != blank -%}
    #NetherBanner-{{ section.id }} .nether-hero__media::before {
      padding-bottom: {{ 1 | divided_by: section.settings.nether_banner_image_desktop.aspect_ratio | times: 100 }}%;
      content: '';
      display: block;
    }
  {%- elsif nether_banner_height == 'adapt' and banner_collection.image != blank -%}
    #NetherBanner-{{ section.id }} .nether-hero__media::before {
      padding-bottom: {{ 1 | divided_by: banner_collection.image.aspect_ratio | times: 100 }}%;
      content: '';
      display: block;
    }
  {%- endif -%}
{%- endstyle -%}

{%- if section.settings.nether_banner_show_divider_top -%}
  {%- render 'nether-banner-divider', section: section, position: 'top' -%}
{%- endif -%}

<nether-banner
  id="NetherBanner-{{ section.id }}"
  class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-nether-motion="banner"
  data-nether-hero-layout="{{ nether_hero_layout }}"
  data-nether-banner-layout="{{ nether_banner_layout }}"
  {% if section.settings.nether_banner_enable_parallax %}data-nether-motion-plugins="scrollTrigger"{% endif %}
  data-animation-style="{{ section.settings.nether_banner_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-enable-parallax="{{ section.settings.nether_banner_enable_parallax }}"
  data-banner-hover="{{ section.settings.nether_banner_enable_hover }}"
  role="region"
  aria-label="{{ section.settings.nether_banner_aria_label | default: 'Promotional banner' | escape }}"
>
  <div class="nether-hero__inner">
    {%- render 'nether-hero-media', section: section, fetch_priority: fetch_priority, adapter: 'banner' -%}

    {%- if section.settings.nether_banner_enable_image_overlay or enable_gradient -%}
      <div class="{{ overlay_classes }}" data-nether-hero-overlay aria-hidden="true"></div>
    {%- endif -%}

    {%- if section.settings.nether_banner_show_decorative_shapes -%}
      <div class="nether-hero__shapes" data-nether-hero-decor aria-hidden="true">
        <span class="nether-hero__shape nether-hero__shape--one"></span>
        <span class="nether-hero__shape nether-hero__shape--two"></span>
        <span class="nether-hero__shape nether-hero__shape--three"></span>
      </div>
    {%- endif -%}

    {%- render 'nether-banner-content', section: section, heading_tag: heading_tag -%}

    {%- if nether_banner_layout == 'collection' and banner_collection != blank -%}
      <div
        class="nether-banner__collection-bar page-width"
        data-nether-banner-collection-bar
        data-nether-hero-animate
        data-nether-hero-role="collection"
      >
        <div class="nether-banner__collection-bar-inner">
          <a class="nether-banner__collection-link type-label" href="{{ banner_collection.url }}">
            {{- 'sections.nether_banner.collection.view' | t: title: banner_collection.title -}}
            {%- render 'icon', icon: 'arrow' -%}
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
</nether-banner>

{%- if section.settings.nether_banner_show_divider_bottom -%}
  {%- render 'nether-banner-divider', section: section, position: 'bottom' -%}
{%- endif -%}

