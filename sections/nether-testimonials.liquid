{{ 'component-hero.css' | asset_url | stylesheet_tag }}
{{ 'component-testimonials.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-typography.css' | asset_url | stylesheet_tag }}
{{ 'component-card-premium.css' | asset_url | stylesheet_tag }}
{{ 'component-shadow.css' | asset_url | stylesheet_tag }}
{{ 'component-radius.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-hero.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-testimonials.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign nether_layout = section.settings.nether_layout | default: 'grid_testimonials'
  assign nether_columns_desktop = section.settings.nether_columns_desktop | default: 3
  assign nether_columns_tablet = section.settings.nether_columns_tablet | default: 2
  assign nether_columns_mobile = section.settings.nether_columns_mobile | default: 1
  assign nether_gap = section.settings.nether_gap | default: 24

  assign uses_hero_shell = false
  assign uses_section_media = false
  assign is_magazine = false
  assign show_slider = false

  case nether_layout
    when 'editorial_testimonials'
      assign uses_hero_shell = true
      assign uses_section_media = true
      assign nether_hero_layout = 'editorial'
    when 'minimal'
      assign uses_hero_shell = true
      assign nether_hero_layout = 'minimal'
    when 'magazine'
      assign is_magazine = true
    when 'carousel_testimonials'
      assign show_slider = true
    when 'grid_testimonials', 'video_testimonials', 'brand_logos', 'statistics', 'awards', 'press_mentions', 'magazine'
  endcase

  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign nether_class_list = 'nether-testimonials nether-hero'
  assign nether_class_list = nether_class_list | append: ' nether-testimonials--layout-' | append: nether_layout
  if uses_hero_shell
    assign nether_class_list = nether_class_list | append: ' nether-hero--layout-' | append: nether_hero_layout
  endif
  assign nether_class_list = nether_class_list | append: ' nether-testimonials--card-' | append: section.settings.nether_card_style
  assign nether_class_list = nether_class_list | append: ' nether-hero--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-hero--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-hero--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-hero--glass-enabled nether-testimonials--glass-enabled'
  endif

  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-hero--gradient-enabled'
  endif

  if section.settings.nether_enable_floating_cards
    assign nether_class_list = nether_class_list | append: ' nether-testimonials--floating-enabled'
  endif

  if section.settings.nether_full_width
    assign nether_class_list = nether_class_list | append: ' nether-testimonials--full-width'
  endif

  assign overlay_classes = 'nether-hero__overlay'
  if section.settings.nether_enable_gradient
    case section.settings.nether_gradient_style
      when 'dramatic'
        assign overlay_classes = overlay_classes | append: ' grad-hero-dramatic'
      when 'vignette'
        assign overlay_classes = overlay_classes | append: ' grad-hero-vignette'
      when 'fade-down'
        assign overlay_classes = overlay_classes | append: ' grad-linear-fade-down'
      else
        assign overlay_classes = overlay_classes | append: ' grad-hero-brand'
    endcase
  endif

  assign heading_tag = 'h2'
  if section.settings.nether_heading_level == 'h3'
    assign heading_tag = 'h3'
  endif

  assign needs_deferred_media = false
  if section.settings.nether_testimonials_media_type == 'video'
    assign needs_deferred_media = true
  endif
  for block in section.blocks
    if block.type == 'video_testimonial'
      assign needs_deferred_media = true
      break
    endif
  endfor
-%}

{%- if show_slider -%}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if needs_deferred_media -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-testimonials {
    --nether-testimonials-gap: {{ nether_gap }}px;
    --nether-testimonials-columns-desktop: {{ nether_columns_desktop }};
    --nether-testimonials-columns-tablet: {{ nether_columns_tablet }};
    --nether-testimonials-columns-mobile: {{ nether_columns_mobile }};
    --nether-testimonials-overlay-opacity: {{ section.settings.nether_overlay_opacity | divided_by: 100.0 }};
    --nether-testimonials-transition-duration: {{ nether_animation_duration }}s;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if uses_section_media and section.settings.nether_testimonials_image_desktop != blank -%}
    #NetherTestimonials-{{ section.id }} .nether-hero__media::before {
      padding-bottom: {{ 1 | divided_by: section.settings.nether_testimonials_image_desktop.aspect_ratio | times: 100 }}%;
      content: '';
      display: block;
    }
  {%- endif -%}
{%- endstyle -%}

{%- if section.settings.nether_show_divider_top -%}
  {%- render 'nether-testimonials-divider', section: section, position: 'top' -%}
{%- endif -%}

<nether-testimonials
  id="NetherTestimonials-{{ section.id }}"
  class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-nether-motion="testimonials"
  data-testimonials-layout="{{ nether_layout }}"
  data-nether-testimonials-layout="{{ nether_layout }}"
  data-nether-testimonials-card-style="{{ section.settings.nether_card_style }}"
  {% if section.settings.nether_enable_parallax or nether_layout == 'editorial_testimonials' or nether_layout == 'magazine' or nether_layout == 'brand_logos' or nether_layout == 'statistics' or section.settings.nether_animation_style == 'stagger' or section.settings.nether_animation_style == 'card_reveal' or section.settings.nether_animation_style == 'logo_reveal' or section.settings.nether_animation_style == 'counter_reveal' %}data-nether-motion-plugins="scrollTrigger"{% endif %}
  data-animation-style="{{ section.settings.nether_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-enable-parallax="{{ section.settings.nether_enable_parallax }}"
  data-hover-reveal="{{ section.settings.nether_hover_effect }}"
  data-carousel-ready="{{ show_slider }}"
  role="region"
  aria-label="{{ section.settings.nether_aria_label | default: 'Testimonials and social proof' | escape }}"
>
  <div class="nether-testimonials__inner nether-hero__inner" data-nether-testimonials-shell-outer>
    {%- if uses_section_media -%}
      {%- render 'nether-hero-media', section: section, adapter: 'testimonials' -%}

      {%- if section.settings.nether_enable_image_overlay or section.settings.nether_enable_gradient -%}
        <div class="{{ overlay_classes }}" aria-hidden="true" data-nether-testimonials-overlay></div>
      {%- endif -%}
    {%- endif -%}

    {%- if uses_hero_shell -%}
      {%- render 'nether-testimonials-shell', section: section, heading_tag: heading_tag -%}
    {%- else -%}
      <div class="nether-testimonials__body{% unless section.settings.nether_full_width %} page-width{% endunless %}">
        {%- render 'nether-testimonials-content', section: section, heading_tag: heading_tag -%}
        {%- render 'nether-testimonials-grid',
          section: section,
          layout: nether_layout,
          show_slider: show_slider,
          is_magazine: is_magazine
        -%}
      </div>
    {%- endif -%}
  </div>
</nether-testimonials>

{%- if section.settings.nether_show_divider_bottom -%}
  {%- render 'nether-testimonials-divider', section: section, position: 'bottom' -%}
{%- endif -%}

{% schema %}
