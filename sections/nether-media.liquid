          "label": "t:sections.nether_media.settings.nether_layout.options__4.label"
        },
        {
          "value": "split_media",
          "label": "t:sections.nether_media.settings.nether_layout.options__5.label"
        },
        {
          "value": "video_showcase",
          "label": "t:sections.nether_media.settings.nether_layout.options__6.label"
        },
        {
          "value": "lookbook",
          "label": "t:sections.nether_media.settings.nether_layout.options__7.label"
        },
        {
          "value": "magazine_layout",
          "label": "t:nether.common.ui.labels.magazine_layout"
        },
        {
          "value": "before_after",
          "label": "t:sections.nether_media.settings.nether_layout.options__9.label"
