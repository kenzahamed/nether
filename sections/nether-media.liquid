{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-card-premium.css' | asset_url | stylesheet_tag }}
{{ 'component-button.css' | asset_url | stylesheet_tag }}
{{ 'component-icon.css' | asset_url | stylesheet_tag }}
{{ 'component-badge.css' | asset_url | stylesheet_tag }}
{{ 'component-typography.css' | asset_url | stylesheet_tag }}
{{ 'component-shadow.css' | asset_url | stylesheet_tag }}
{{ 'component-radius.css' | asset_url | stylesheet_tag }}
{{ 'component-media.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-media.js' | asset_url }}" defer="defer"></script>

{%- if section.settings.nether_enable_glass -%}
  {{ 'component-glass.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_gradient -%}
  {{ 'component-gradient.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_layout == 'horizontal_gallery' -%}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- liquid
  assign nether_layout = section.settings.nether_layout | default: 'grid_gallery'
  assign nether_columns_desktop = section.settings.nether_columns_desktop | default: 3
  assign nether_columns_tablet = section.settings.nether_columns_tablet | default: 2
  assign nether_columns_mobile = section.settings.nether_columns_mobile | default: 1
  assign nether_gap = section.settings.nether_gap | default: 24

  case section.settings.nether_animation_speed
    when 'slow'
      assign nether_animation_duration = 0.8
    when 'fast'
      assign nether_animation_duration = 0.3
    else
      assign nether_animation_duration = 0.5
  endcase

  assign media_item_blocks = section.blocks | where: 'type', 'media_item'
  assign before_after_blocks = section.blocks | where: 'type', 'before_after'
  assign media_item_count = media_item_blocks.size
  assign before_after_count = before_after_blocks.size
  assign total_media_count = media_item_count | plus: before_after_count

  assign show_horizontal = false
  if nether_layout == 'horizontal_gallery'
    assign show_horizontal = true
  endif

  assign uses_before_after_layout = false
  if nether_layout == 'before_after'
    assign uses_before_after_layout = true
  endif

  assign nether_class_list = 'nether-media'
  assign nether_class_list = nether_class_list | append: ' nether-media--layout-' | append: nether_layout
  assign nether_class_list = nether_class_list | append: ' nether-media--style-' | append: section.settings.nether_media_style
  assign nether_class_list = nether_class_list | append: ' nether-media--desktop-' | append: section.settings.nether_layout_desktop
  assign nether_class_list = nether_class_list | append: ' nether-media--tablet-' | append: section.settings.nether_layout_tablet
  assign nether_class_list = nether_class_list | append: ' nether-media--mobile-' | append: section.settings.nether_layout_mobile

  if section.settings.nether_enable_glass
    assign nether_class_list = nether_class_list | append: ' nether-media--glass-enabled'
  endif

  if section.settings.nether_enable_gradient
    assign nether_class_list = nether_class_list | append: ' nether-media--gradient-enabled'
  endif

  if section.settings.nether_enable_floating_cards
    assign nether_class_list = nether_class_list | append: ' nether-media--floating-enabled'
  endif

  if section.settings.nether_full_width
    assign nether_class_list = nether_class_list | append: ' nether-media--full-width'
  endif

  assign heading_tag = 'h2'
  if section.settings.nether_heading_level == 'h3'
    assign heading_tag = 'h3'
  endif

  # Placeholder ratio respects section setting (no image → adapt falls back to 1)
  assign placeholder_image_ratio = section.settings.nether_image_ratio | default: 'portrait'
  assign placeholder_ratio = 1
  if placeholder_image_ratio == 'portrait'
    assign placeholder_ratio = 0.8
  elsif placeholder_image_ratio == 'landscape'
    assign placeholder_ratio = 1.4
  elsif placeholder_image_ratio == 'square'
    assign placeholder_ratio = 1
  endif

  assign grid_classes = 'nether-media__grid'
  if show_horizontal
    assign grid_classes = grid_classes | append: ' nether-media__grid--horizontal'
  endif

  assign needs_deferred_media = false
  for block in media_item_blocks
    assign block_media_type = block.settings.media_type | default: 'image'
    if block_media_type == 'video'
      assign needs_deferred_media = true
      break
    endif
  endfor
-%}

{%- if needs_deferred_media -%}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  #shopify-section-{{ section.id }} .nether-media {
    --nether-media-gap: {{ nether_gap }}px;
    --nether-media-columns-desktop: {{ nether_columns_desktop }};
    --nether-media-columns-tablet: {{ nether_columns_tablet }};
    --nether-media-columns-mobile: {{ nether_columns_mobile }};
    --nether-media-overlay-opacity: {{ section.settings.nether_overlay_opacity | divided_by: 100.0 }};
    --nether-media-transition-duration: {{ nether_animation_duration }}s;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.nether_show_divider_top -%}
  {%- render 'nether-media-divider', section: section, position: 'top' -%}
{%- endif -%}

<nether-media
  id="NetherMedia-{{ section.id }}"
  class="{{ nether_class_list }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-nether-motion="media"
  data-nether-media-layout="{{ nether_layout }}"
  data-nether-media-style="{{ section.settings.nether_media_style }}"
  {% if section.settings.nether_enable_parallax or nether_layout == 'before_after' or nether_layout == 'editorial_gallery' or nether_layout == 'magazine_layout' or nether_layout == 'lookbook' %}data-nether-motion-plugins="scrollTrigger"{% endif %}
  data-animation-style="{{ section.settings.nether_animation_style }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-enable-parallax="{{ section.settings.nether_enable_parallax }}"
  data-hover-reveal="{{ section.settings.nether_hover_effect }}"
  data-carousel-ready="{{ show_horizontal }}"
  role="region"
  aria-label="{% render 'nether-locale-text', value: section.settings.nether_aria_label, key: 'sections.nether_media.aria_label' %}"
>
  <div class="nether-media__inner{% unless section.settings.nether_full_width %} page-width{% endunless %}" data-nether-media-shell>
    {%- render 'nether-media-content', section: section, heading_tag: heading_tag -%}

    {%- if total_media_count > 0 -%}
      <ul
        id="NetherMediaGrid-{{ section.id }}"
        class="{{ grid_classes }}"
        role="list"
        aria-label="{{ 'sections.nether_media.grid.label' | t }}"
        data-nether-media-grid
        data-media-count="{{ total_media_count }}"
      >
        {%- if uses_before_after_layout and before_after_count > 0 -%}
          {%- for block in before_after_blocks -%}
            <li
              id="NetherMediaItem-{{ section.id }}-ba-{{ forloop.index }}"
              class="nether-media__item"
              data-nether-media-item
            >
              {%- render 'nether-media-before-after', block: block, section: section -%}
            </li>
          {%- endfor -%}
        {%- endif -%}

        {%- unless uses_before_after_layout and media_item_count == 0 -%}
          {%- assign card_index = 0 -%}
          {%- for block in media_item_blocks -%}
            {%- assign card_index = card_index | plus: 1 -%}
            {%- liquid
              assign is_featured = false
              if nether_layout == 'split_media' or nether_layout == 'magazine_layout' or nether_layout == 'video_showcase'
                if card_index == 1
                  assign is_featured = true
                endif
              endif

              assign lazy_load = true
              if card_index <= nether_columns_desktop
                assign lazy_load = false
              endif
            -%}
            <li
              id="NetherMediaItem-{{ section.id }}-{{ card_index }}"
              class="nether-media__item{% if is_featured %} nether-media__item--featured{% endif %}"
              data-nether-media-item
            >
              {%- render 'nether-media-card',
                block: block,
                section: section,
                columns: nether_columns_desktop,
                lazy_load: lazy_load,
                is_featured: is_featured,
                card_index: card_index
              -%}
            </li>
          {%- endfor -%}
        {%- endunless -%}
      </ul>
    {%- else -%}
      <ul class="nether-media__grid nether-media__grid--placeholder" role="list">
        {%- for i in (1..nether_columns_desktop) -%}
          {%- assign placeholder_index = i | modulo: 4 | plus: 1 -%}
          <li class="nether-media__item">
            <article class="nether-media-card nether-media-card--placeholder">
              <div class="nether-media-card__inner card card--card card--media">
                <div class="nether-media-card__media ratio" style="--ratio-percent: {{ 1 | divided_by: placeholder_ratio | times: 100 }}%;">
                  {{ 'hero-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="nether-media-card__content">
                  <h3 class="nether-media-card__heading type-heading-md">{{ 'sections.nether_media.placeholder.title' | t }}</h3>
                </div>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</nether-media>

{%- if section.settings.nether_show_divider_bottom -%}
  {%- render 'nether-media-divider', section: section, position: 'bottom' -%}
{%- endif -%}

{% schema %}
