{{ 'component-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-header.js' | asset_url }}" defer="defer"></script>

{%- comment -%} Header schema validated for Theme Dev upload (Sprint 2). {%- endcomment -%}

{%- if section.settings.nether_enable_mobile_drawer -%}
  {{ 'component-mobile-drawer.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_search_drawer -%}
  {{ 'component-search-drawer.css' | asset_url | stylesheet_tag }}
  {%- if section.settings.nether_search_predictive and settings.predictive_search_enabled == false -%}
    <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endif -%}
{%- endif -%}

{%- if section.settings.nether_enable_wishlist -%}
  {{ 'component-wishlist.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_compare -%}
  {{ 'component-compare.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.settings.nether_enable_quick_view -%}
  {{ 'component-quick-view.css' | asset_url | stylesheet_tag }}
  {%- if section.settings.nether_quick_view_enable_glass -%}
    {{ 'component-glass.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
{%- endif -%}

<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- if section.settings.nether_enable_mega_menu -%}
    {{ 'component-mega-menu-premium.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'component-mega-menu.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
{%- endif -%}

{%- liquid
  assign nether_layout = section.settings.nether_header_layout | default: 'standard'
  assign nether_split_nav = false
  assign nether_logo_width = section.settings.nether_logo_width
  if nether_logo_width == 0
    assign nether_logo_width = settings.logo_width
  endif

  case section.settings.nether_animation_speed
    when 'fast'
      assign nether_animation_duration = 0.15
    when 'slow'
      assign nether_animation_duration = 0.5
    else
      assign nether_animation_duration = 0.3
  endcase

  case section.settings.nether_search_animation_speed
    when 'fast'
      assign nether_search_animation_duration = 0.15
    when 'slow'
      assign nether_search_animation_duration = 0.5
    else
      assign nether_search_animation_duration = 0.3
  endcase

  case section.settings.nether_mega_animation_speed
    when 'fast'
      assign nether_mega_animation_duration = 0.15
    when 'slow'
      assign nether_mega_animation_duration = 0.5
    else
      assign nether_mega_animation_duration = 0.3
  endcase

  case nether_layout
    when 'center-logo'
      assign effective_logo_position = 'middle-center'
    when 'left-logo'
      assign effective_logo_position = 'middle-left'
    when 'split-nav'
      assign effective_logo_position = 'middle-center'
      assign nether_split_nav = true
    when 'minimal'
      assign effective_logo_position = 'middle-left'
    when 'commerce'
      assign effective_logo_position = 'middle-left'
    else
      assign effective_logo_position = section.settings.logo_position
  endcase
-%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }

  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }
</style>

{%- style -%}
  #shopify-section-{{ section.id }} .nether-header {
    --nether-header-height: {{ section.settings.nether_header_height }}px;
    --nether-header-logo-width: {{ nether_logo_width }}px;
    --nether-header-padding-block: {{ section.settings.padding_top }}px;
    --nether-header-gap: {{ section.settings.nether_header_gap }}px;
    --nether-header-shrink-height: {{ section.settings.nether_shrink_height }}px;
    --nether-header-transition-duration: {{ nether_animation_duration }}s;
    --nether-mega-duration: {{ nether_mega_animation_duration }}s;
  }

  .header {
    padding: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px 3rem {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px 3rem;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .nether-header {
      --nether-header-padding-block: {{ section.settings.padding_top }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor

  assign nether_class_list = 'nether-header'
  assign nether_class_list = nether_class_list | append: ' nether-header--layout-' | append: nether_layout
  assign nether_class_list = nether_class_list | append: ' nether-header--spacing-' | append: section.settings.nether_header_spacing
  assign nether_class_list = nether_class_list | append: ' nether-header--icon-' | append: section.settings.nether_icon_size
  assign nether_class_list = nether_class_list | append: ' nether-header--mobile-' | append: section.settings.nether_mobile_layout

  if section.settings.nether_header_border != 'none'
    assign nether_class_list = nether_class_list | append: ' nether-header--border-' | append: section.settings.nether_header_border
  endif

  if section.settings.nether_header_shadow != 'none'
    assign nether_class_list = nether_class_list | append: ' nether-header--shadow-' | append: section.settings.nether_header_shadow
  endif

  if section.settings.nether_enable_transparent
    assign nether_class_list = nether_class_list | append: ' nether-header--state-transparent'
    if section.settings.nether_enable_glass
      assign nether_class_list = nether_class_list | append: ' nether-header--glass-enabled'
    endif
  else
    assign nether_class_list = nether_class_list | append: ' nether-header--state-solid'
  endif

  if section.settings.nether_enable_sticky
    assign nether_class_list = nether_class_list | append: ' nether-header--sticky-ready'
  endif

  if section.settings.nether_enable_shrink
    assign nether_class_list = nether_class_list | append: ' nether-header--shrink-ready'
  endif

  if section.settings.nether_enable_auto_hide or section.settings.sticky_header_type == 'on-scroll-up'
    assign nether_class_list = nether_class_list | append: ' nether-header--hide-scroll-ready'
  endif

  if section.settings.nether_announcement_integration
    assign nether_class_list = nether_class_list | append: ' nether-header--announcement-aware'
  endif
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.nether_enable_sticky and section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<nether-header
  class="{{ nether_class_list }}"
  data-section-id="{{ section.id }}"
  data-layout="{{ nether_layout }}"
  data-announcement-integration="{{ section.settings.nether_announcement_integration }}"
  data-transparent="{{ section.settings.nether_enable_transparent }}"
  data-sticky="{{ section.settings.nether_enable_sticky }}"
  data-enable-shrink="{{ section.settings.nether_enable_shrink }}"
  data-enable-auto-hide="{{ section.settings.nether_enable_auto_hide }}"
  data-scroll-threshold="{{ section.settings.nether_scroll_threshold }}"
  data-shrink-height="{{ section.settings.nether_shrink_height }}"
  data-animation-duration="{{ nether_animation_duration }}"
  data-behavior-desktop="{{ section.settings.nether_behavior_desktop }}"
  data-behavior-tablet="{{ section.settings.nether_behavior_tablet }}"
  data-behavior-mobile="{{ section.settings.nether_behavior_mobile }}"
  data-nether-motion="header"
>
  <div class="nether-header__inner">
    <{{ header_tag }}
      {% if header_tag == 'sticky-header' %}
        data-sticky-type="{{ section.settings.sticky_header_type }}"
      {% endif %}
      class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
    >
      {%- liquid
        assign social_links = false
        assign localization_forms = false

        if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
          assign social_links = true
        endif

        if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
          assign localization_forms = true
        endif
      -%}
      <header class="header header--{{ effective_logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}">
        {%- liquid
          if nether_split_nav
            render 'nether-header-navigation', nether_split_nav: true, menu_half: 'left'
          else
            render 'nether-header-navigation'
          endif

          if effective_logo_position == 'top-center' or section.settings.menu == blank
            unless section.settings.nether_search_placeholder or section.settings.nether_enable_search_drawer
              render 'header-search', input_id: 'Search-In-Modal-1'
            endunless
          endif
        -%}

        {%- if effective_logo_position != 'middle-center' -%}
          {%- render 'nether-header-logo',
            logo_position: effective_logo_position,
            logo_width: nether_logo_width
          -%}
        {%- endif -%}

        {%- if effective_logo_position == 'middle-center' -%}
          {%- render 'nether-header-logo',
            logo_position: effective_logo_position,
            logo_width: nether_logo_width
          -%}
        {%- endif -%}

        {%- if nether_split_nav -%}
          {%- render 'nether-header-navigation', nether_split_nav: true, menu_half: 'right' -%}
        {%- endif -%}

        {%- render 'nether-header-actions', search_input_id: 'Search-In-Modal' -%}
      </header>
    </{{ header_tag }}>
  </div>
</nether-header>

{%- if section.settings.nether_enable_mobile_drawer -%}
  <script src="{{ 'component-mobile-drawer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.nether_enable_search_drawer -%}
  {%- render 'nether-search-drawer',
    section: section,
    input_id: 'Nether-Search-Input',
    color_scheme: section.settings.color_scheme,
    animation_duration: nether_search_animation_duration
  -%}
  {%- if section.settings.nether_search_predictive and settings.predictive_search_enabled == false -%}
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  <script src="{{ 'component-search-drawer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.nether_enable_wishlist or section.settings.nether_enable_compare -%}
  <script src="{{ 'nether-commerce-interaction.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.nether_enable_wishlist -%}
  {%- render 'nether-wishlist-drawer',
    section: section,
    color_scheme: section.settings.color_scheme,
    animation_duration: nether_animation_duration
  -%}
  <script src="{{ 'component-wishlist.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.nether_enable_compare -%}
  {%- render 'nether-compare-drawer',
    section: section,
    color_scheme: section.settings.color_scheme,
    animation_duration: nether_animation_duration
  -%}
  <script src="{{ 'component-compare.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.nether_enable_quick_view -%}
  {%- render 'nether-quick-view-modal',
    section: section,
    color_scheme: section.settings.color_scheme,
    animation_duration: nether_animation_duration
  -%}
  {% render 'nether-quick-view-assets' %}
{%- endif -%}

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification',
    color_scheme: section.settings.color_scheme,
    desktop_menu_type: section.settings.menu_type_desktop
  -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const netherHeader = this.closest('nether-header');
      if (netherHeader?.dataset.enableAutoHide === 'true') return;

      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;
      if (document.querySelector('nether-search-drawer')?.isOpen) return;
      if (document.querySelector('nether-wishlist-drawer')?.isOpen) return;
      if (document.querySelector('nether-compare-drawer')?.isOpen) return;
      if (document.querySelector('nether-quick-view')?.isOpen) return;
      if (document.querySelector('nether-mobile-drawer')?.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      this.searchModal.close(false);
      document.querySelector('nether-search-drawer')?.close(false);
      document.querySelector('nether-wishlist-drawer')?.close(false);
      document.querySelector('nether-compare-drawer')?.close(false);
      document.querySelector('nether-quick-view')?.close(false);
      document.querySelector('nether-mobile-drawer')?.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 24,
  "settings": [
    {
      "type": "select",
      "id": "logo_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.header.settings.logo_position.options__2.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.header.settings.logo_position.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.header.settings.logo_position.options__1.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.header.settings.logo_position.options__4.label"
        }
      ],
      "default": "middle-left",
      "label": "t:sections.header.settings.logo_position.label",
      "info": "t:sections.header.settings.logo_help.content"
    },
    {
      "type": "select",
      "id": "mobile_logo_position",
      "options": [
        {
          "value": "center",
          "label": "t:sections.header.settings.mobile_logo_position.options__1.label"
        },
        {
          "value": "left",
          "label": "t:sections.header.settings.mobile_logo_position.options__2.label"
        }
      ],
      "default": "center",
      "label": "t:sections.header.settings.mobile_logo_position.label"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "select",
      "id": "menu_type_desktop",
      "options": [
        {
          "value": "dropdown",
          "label": "t:sections.header.settings.menu_type_desktop.options__1.label"
        },
        {
          "value": "mega",
          "label": "t:sections.header.settings.menu_type_desktop.options__2.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.header.settings.menu_type_desktop.options__3.label"
        }
      ],
      "default": "dropdown",
      "label": "t:sections.header.settings.menu_type_desktop.label"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        {
          "value": "none",
          "label": "t:sections.header.settings.sticky_header_type.options__1.label"
        },
        {
          "value": "on-scroll-up",
          "label": "t:sections.header.settings.sticky_header_type.options__2.label"
        },
        {
          "value": "always",
          "label": "t:sections.header.settings.sticky_header_type.options__3.label"
        },
        {
          "value": "reduce-logo-size",
          "label": "t:sections.header.settings.sticky_header_type.options__4.label"
        }
      ],
      "default": "on-scroll-up",
      "label": "t:sections.header.settings.sticky_header_type.label"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "header",
      "content": "t:sections.header.settings.header__1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
