{{ 'component-slideshow.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-announcement.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-announcement.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign social_icons = false
  endif
  if section.settings.enable_country_selector or section.settings.enable_language_selector
    assign language_country_selector = true
  endif
  if section.settings.enable_announcement_bar and section.blocks.size > 0
    assign announcement_bar = true
  endif
-%}

{% if social_icons %}
  {{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- if announcement_bar -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .nether-announcement {
      --nether-announcement-bg: {{ section.settings.background_color }};
      --nether-announcement-text: {{ section.settings.text_color }};
      --nether-announcement-height: {{ section.settings.height }}px;
      --nether-announcement-padding-y: {{ section.settings.padding_y }}px;
      --nether-announcement-font-size: {{ section.settings.font_size | divided_by: 10.0 }}rem;
      --nether-announcement-border-width: {{ section.settings.border_width }}px;
      --nether-announcement-divider-opacity: {{ section.settings.divider_opacity | divided_by: 100.0 }};
    }
  {%- endstyle -%}

  <nether-announcement-bar
    data-section-id="{{ section.id }}"
    data-close-storage-key="nether-announcement-{{ section.id }}"
    data-pause-on-hover="{{ section.settings.pause_on_hover }}"
    data-show-navigation="{{ section.settings.show_navigation }}"
  >
    <div
      class="utility-bar color-{{ section.settings.color_scheme }} gradient nether-announcement nether-announcement--layout-{{ section.settings.layout }} nether-announcement--type-{{ section.settings.typography }}{% if section.settings.show_close_button %} nether-announcement--has-close{% endif %}{% if section.settings.show_divider %} nether-announcement--divider{% endif %}{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% elsif section.settings.show_line_separator and section.settings.show_social and social_icons%} utility-bar--bottom-border-social-only{% endif %}{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header-localization{% endif %}"
    >
      <div class="page-width utility-bar__grid nether-announcement__grid{% if announcement_bar and language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--3-col{% elsif language_country_selector or section.settings.show_social and social_icons %} utility-bar__grid--2-col{% endif %}">
        {%- if section.settings.show_social and social_icons -%}
          {%- render 'social-icons' -%}
        {%- endif -%}

        {%- if section.blocks.size == 1 -%}
          <div
            class="announcement-bar nether-announcement__content{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}"
            role="region"
            aria-label="{{ 'sections.header.announcement' | t }}"
            {{ section.blocks.first.shopify_attributes }}
          >
            {%- render 'nether-announcement-item',
              block: section.blocks.first,
              layout: section.settings.layout,
              default_icon: section.settings.default_icon,
              show_countdown_placeholder: section.settings.show_countdown_placeholder
            -%}
          </div>
        {%- elsif section.blocks.size > 1 -%}
          <slideshow-component
            class="announcement-bar nether-announcement__carousel"
            role="region"
            aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
            aria-label="{{ 'sections.announcements.announcement_bar' | t }}"
          >
            <div class="announcement-bar-slider slider-buttons nether-announcement__slider{% unless section.settings.show_navigation %} nether-announcement__slider--navigation-hidden{% endunless %}">
              <button
                type="button"
                class="slider-button slider-button--prev"
                name="previous"
                aria-label="{{ 'sections.announcements.previous_announcement' | t }}"
                aria-controls="Slider-{{ section.id }}"
                {% unless section.settings.show_navigation %}tabindex="-1" aria-hidden="true"{% endunless %}
              >
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </button>
              <div
                class="grid grid--1-col slider slider--everywhere"
                id="Slider-{{ section.id }}"
                aria-live="polite"
                aria-atomic="true"
                data-autoplay="{{ section.settings.auto_rotate }}"
                data-speed="{{ section.settings.change_slides_speed }}"
              >
                {%- for block in section.blocks -%}
                  <div
                    class="slideshow__slide slider__slide grid__item grid--1-col"
                    id="Slide-{{ section.id }}-{{ forloop.index }}"
                    {{ block.shopify_attributes }}
                    role="group"
                    aria-roledescription="{{ 'sections.announcements.announcement' | t }}"
                    aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                    tabindex="-1"
                  >
                    <div
                      class="announcement-bar__announcement"
                      role="region"
                      aria-label="{{ 'sections.header.announcement' | t }}"
                    >
                      {%- render 'nether-announcement-item',
                        block: block,
                        layout: section.settings.layout,
                        default_icon: section.settings.default_icon,
                        show_countdown_placeholder: section.settings.show_countdown_placeholder
                      -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
              <button
                type="button"
                class="slider-button slider-button--next"
                name="next"
                aria-label="{{ 'sections.announcements.next_announcement' | t }}"
                aria-controls="Slider-{{ section.id }}"
                {% unless section.settings.show_navigation %}tabindex="-1" aria-hidden="true"{% endunless %}
              >
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
          </slideshow-component>
          {%- if request.design_mode -%}
            <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
            <style>
              /* theme editor power preview fix */
              .announcement-bar-slider .slider__slide[aria-hidden='true'] {
                visibility: hidden;
              }
            </style>
          {%- endif -%}
        {%- endif -%}

        <div class="localization-wrapper">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form class="small-hide medium-hide">
              {%- form 'localization', id: 'AnnouncementCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="AnnouncementCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'AnnouncementCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {% endif %}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form class="small-hide medium-hide">
              {%- form 'localization', id: 'AnnouncementLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="AnnouncementLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                  {%- render 'language-localization', localPosition: 'AnnouncementLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_close_button -%}
        {%- render 'button',
          label: 'sections.announcements.close_announcement_bar' | t,
          style: 'icon',
          size: 'small',
          icon_leading: 'close',
          aria_label: 'sections.announcements.close_announcement_bar' | t,
          class: 'nether-announcement__close',
          attributes: 'data-nether-announcement-close'
        -%}
      {%- endif -%}
    </div>
  </nether-announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement_bar",
      "label": "t:sections.announcement-bar.settings.enable_announcement_bar.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "t:sections.announcement-bar.settings.pause_on_hover.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.announcement-bar.settings.show_navigation.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_close_button",
      "label": "t:sections.announcement-bar.settings.show_close_button.label",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:nether.common.ui.layout.layout",
      "options": [
        {
          "value": "center",
          "label": "t:nether.common.ui.layout.center"
        },
        {
          "value": "left",
          "label": "t:nether.common.ui.layout.left"
        },
        {
          "value": "split",
          "label": "t:nether.common.ui.layout.split"
        },
        {
          "value": "icon_text",
          "label": "t:sections.announcement-bar.settings.layout.options__4.label"
        },
        {
          "value": "text_cta",
          "label": "t:sections.announcement-bar.settings.layout.options__5.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.announcement-bar.settings.background_color.label",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.announcement-bar.settings.text_color.label",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "typography",
      "label": "t:nether.common.ui.labels.typography",
      "options": [
        {
          "value": "body",
          "label": "t:nether.common.ui.typography.body"
        },
        {
          "value": "heading",
          "label": "t:nether.common.ui.typography.heading"
        },
        {
          "value": "caption",
          "label": "t:nether.common.ui.typography.caption"
        },
        {
          "value": "overline",
          "label": "t:sections.announcement-bar.settings.typography.options__4.label"
        }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "t:sections.announcement-bar.settings.font_size.label",
      "default": 14
    },
    {
      "type": "range",
      "id": "height",
      "min": 32,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "t:nether.common.ui.labels.height",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "t:sections.announcement-bar.settings.padding_y.label",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:sections.announcement-bar.settings.border_width.label",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "t:sections.announcement-bar.settings.show_divider.label",
      "default": false
    },
    {
      "type": "range",
      "id": "divider_opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "t:nether.common.ui.labels.divider_opacity",
      "default": 20
    },
    {
      "type": "select",
      "id": "default_icon",
      "label": "t:sections.announcement-bar.settings.default_icon.label",
      "options": [
        {
          "value": "none",
          "label": "t:nether.common.ui.states.none"
        },
        {
          "value": "discount",
          "label": "t:nether.common.ui.commerce.discount"
        },
        {
          "value": "truck",
          "label": "t:nether.common.ui.labels.truck"
        },
        {
          "value": "star",
          "label": "t:nether.common.ui.labels.star"
        },
        {
          "value": "heart",
          "label": "t:nether.common.ui.labels.heart"
        },
        {
          "value": "lightning_bolt",
          "label": "t:nether.common.ui.labels.lightning"
        }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "show_countdown_placeholder",
      "label": "t:sections.announcement-bar.settings.show_countdown_placeholder.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.heading_utilities.content"
    },
    {
      "type": "paragraph",
         "content": "t:sections.announcement-bar.settings.paragraph.content"
    },             
    {
      "type": "checkbox",
      "id": "show_social",
      "default": false,
      "label": "t:nether.common.ui.labels.social_media_icons",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "t:nether.common.ui.labels.country_region_selector",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "t:nether.common.ui.labels.language_selector",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "t:sections.announcement-bar.blocks.announcement.settings.text.default",
          "label": "t:nether.common.ui.typography.text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:nether.common.ui.actions.link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:nether.common.ui.content.icon",
          "options": [
            {
              "value": "none",
              "label": "t:nether.common.ui.states.none"
            },
            {
              "value": "discount",
              "label": "t:nether.common.ui.commerce.discount"
            },
            {
              "value": "truck",
              "label": "t:nether.common.ui.labels.truck"
            },
            {
              "value": "star",
              "label": "t:nether.common.ui.labels.star"
            },
            {
              "value": "heart",
              "label": "t:nether.common.ui.labels.heart"
            },
            {
              "value": "lightning_bolt",
              "label": "t:nether.common.ui.labels.lightning"
            }
          ],
          "default": "none"
        },
        {
          "type": "checkbox",
          "id": "show_separator",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.show_separator.label",
          "default": false
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.cta_text.label"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.cta_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
